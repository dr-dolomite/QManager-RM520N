# /lib/systemd/system/qmanager-watchcat.service
[Unit]
Description=QManager Connection Health Watchdog
After=qmanager-poller.service qmanager-ping.service
Wants=qmanager-poller.service qmanager-ping.service

[Service]
Type=simple
ExecStartPre=/bin/sh -c '[ -f /usr/lib/qmanager/config.sh ] && . /usr/lib/qmanager/config.sh && val=$(qm_config_get watchcat enabled 0) && [ "$val" = "1" ]'
ExecStart=/usr/bin/qmanager_watchcat
# Outside /etc/qmanager deliberately — that directory is www-data-owned, and a
# directory's owner can replace any file in it whatever the file's own mode is.
# systemd injects every KEY=VALUE here into this ROOT daemon. See the long note
# in qmanager-ping.service.
EnvironmentFile=-/etc/qmanager.env
ExecStopPost=/bin/sh -c 'rm -f /tmp/qmanager_watchcat.pid /tmp/qmanager_watchcat.lock /tmp/qmanager_recovery_active'
TimeoutStopSec=10
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=3600
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
