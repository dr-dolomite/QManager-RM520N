# /lib/systemd/system/qmanager-setup.service
[Unit]
Description=QManager Directory & Permission Setup
Before=qmanager-ping.service qmanager-poller.service

[Service]
Type=oneshot
RemainAfterExit=yes
# lighttpd waits for this unit; bound it so a hang cannot keep the web UI down.
TimeoutStartSec=60
ExecStart=/usr/bin/qmanager_setup

[Install]
WantedBy=multi-user.target
