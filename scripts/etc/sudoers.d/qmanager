# QManager — sudoers rules for CGI scripts (lighttpd runs as www-data)
# Install location: /opt/etc/sudoers.d/qmanager (Entware) or /etc/sudoers.d/qmanager

# Service control (used by platform.sh svc_* functions).
# Scoped to QManager's own unit namespace (qmanager-* covers qmanager-discord,
# qmanager-firewall, qmanager-watchcat, qmanager-tower-failover, and the
# qmanager-auto-update.service/.timer pair) plus tailscaled, the one
# third-party unit www-data legitimately starts/stops (VPN toggle in
# vpn/tailscale.sh). A bare `*` here would let a compromised www-data
# start/stop/restart ANY systemd unit as root — see A5.
www-data ALL=(root) NOPASSWD: /bin/systemctl start qmanager-*, /bin/systemctl start tailscaled
www-data ALL=(root) NOPASSWD: /bin/systemctl stop qmanager-*, /bin/systemctl stop tailscaled
www-data ALL=(root) NOPASSWD: /bin/systemctl restart qmanager-*, /bin/systemctl restart tailscaled
www-data ALL=(root) NOPASSWD: /bin/systemctl is-active qmanager-*, /bin/systemctl is-active tailscaled

# Boot persistence (symlink-based — systemctl enable doesn't work on RM520N-GL)
www-data ALL=(root) NOPASSWD: /bin/ln -sf /lib/systemd/system/qmanager*.service /lib/systemd/system/multi-user.target.wants/qmanager*.service
www-data ALL=(root) NOPASSWD: /bin/rm -f /lib/systemd/system/multi-user.target.wants/qmanager*.service

# Firewall rules (used by TTL, VPN firewall)
www-data ALL=(root) NOPASSWD: /usr/sbin/iptables, /usr/sbin/iptables-restore, /usr/sbin/ip6tables, /usr/sbin/ip6tables-restore

# System reboot (used by system/reboot.sh, update installer)
www-data ALL=(root) NOPASSWD: /sbin/reboot

# Crash-log breadcrumb (used by system/reboot.sh to classify a user-initiated
# reboot). The helper hardcodes the log path + validates the reason against a
# fixed enum and refuses to follow a symlink.
#
# NOTE (corrected): /etc/qmanager/crash.log is NOT root-owned in practice.
# qmanager_setup's boot-time `chown -R www-data:www-data /etc/qmanager` flips it
# back on every boot, and it was verified live as www-data:www-data 0644. The
# grant therefore exists for VALIDATION and INTEGRITY (fixed reason enum, fixed
# path, symlink refusal, bounded trim) — not because www-data lacks write
# access. Do not build any new logic on a "root-owned" premise for this file.
www-data ALL=(root) NOPASSWD: /usr/bin/qmanager_crash_log_append

# Auto-update timer live-arming (arms/disarms qmanager-auto-update.timer when the
# Software Update UI toggle flips — the helper hardcodes the unit + validates on/off)
www-data ALL=(root) NOPASSWD: /usr/bin/qmanager_auto_update_arm

# Connection Scenario schedule timer live-arming (arms/disarms
# qmanager-scenario-schedule.timer for a SIM profile's scenario schedule — the
# helper hardcodes the unit + validates install/teardown and the profile id itself)
www-data ALL=(root) NOPASSWD: /usr/bin/qmanager_scenario_schedule_arm

# Scheduled Reboot timer live-arming (arms/disarms qmanager-scheduled-reboot.timer
# when the System Settings -> Scheduled Reboot toggle is saved — the helper
# hardcodes the unit + re-validates install/teardown, time, and day-mask itself)
www-data ALL=(root) NOPASSWD: /usr/bin/qmanager_scheduled_reboot_arm

# Tower Lock schedule timer live-arming (arms/disarms the
# qmanager-tower-schedule-apply.timer / qmanager-tower-schedule-clear.timer
# pair when the Tower Lock schedule is saved — the helper hardcodes both units
# + re-validates install/teardown, start/end time, and day-mask itself)
www-data ALL=(root) NOPASSWD: /usr/bin/qmanager_tower_schedule_arm

# SSH password management (reads password from stdin, updates /etc/shadow)
www-data ALL=(root) NOPASSWD: /usr/bin/qmanager_set_ssh_password

# Alert-channel secret storage (Discord bot token / Gmail app password, plus the
# generated msmtprc). These credentials used to sit in plaintext inside
# /etc/qmanager/*.json — a directory www-data owns — so any file-read bug in any
# CGI endpoint disclosed them. They now live in /etc/qmanager-secrets/ (0700
# root:root), which www-data cannot traverse at all; only this helper can write
# there.
#
# Bare path, no arguments, no wildcard: ALL validation (action verb, secret-name
# whitelist, control-character and length limits, symlink refusal, atomic
# private write) lives INSIDE the helper, where it can be read and tested. A
# sudoers wildcard cannot express any of that, and the secret VALUE never
# appears in argv — it is piped on stdin, because argv is world-readable via
# /proc/<pid>/cmdline and that would recreate the very leak this fixes.
www-data ALL=(root) NOPASSWD: /usr/bin/qmanager_secret_set

# Alert test email (Monitoring -> Alerts -> "Send test"). Consequence of the
# grant above: msmtprc embeds the Gmail app password, so it moved into the same
# 0700 root:root directory — and the CGI can no longer run `msmtp -C` itself,
# which is what it used to do inline as www-data.
#
# This grants www-data NO new capability. It already owns email_alerts.json, so
# it already controls the sender/recipient and could already trigger this send;
# the helper only removes its need to read the credential. Kept as a SEPARATE
# helper from qmanager_secret_set on purpose: custody of secrets and sending
# mail are different privileges and should stay separately auditable.
#
# The helper takes exactly one literal verb (`test`), reads nothing from stdin,
# and the subject/body are canned constants — it cannot be driven to send
# arbitrary content.
www-data ALL=(root) NOPASSWD: /usr/bin/qmanager_email_send

# Tailscale VPN management
www-data ALL=(root) NOPASSWD: /usr/bin/qmanager_tailscale_mgr
www-data ALL=(root) NOPASSWD: /usrdata/tailscale/tailscale
www-data ALL=(root) NOPASSWD: /usrdata/tailscale/tailscaled --version

# Tailscale boot persistence (symlink-based)
www-data ALL=(root) NOPASSWD: /bin/ln -sf /lib/systemd/system/tailscaled.service /lib/systemd/system/multi-user.target.wants/tailscaled.service
www-data ALL=(root) NOPASSWD: /bin/rm -f /lib/systemd/system/multi-user.target.wants/tailscaled.service

# Web console management
www-data ALL=(root) NOPASSWD: /usr/bin/qmanager_console_mgr

# OTA updater (download/stage/install/rollback — needs full root for install.sh)
www-data ALL=(root) NOPASSWD: /usr/bin/qmanager_update

# System Health Check (privileged runner that probes binaries, AT, services, sudoers)
www-data ALL=(root) NOPASSWD: /usr/bin/qmanager_health_check

# Ethernet link speed limit management
www-data ALL=(root) NOPASSWD: /usr/bin/qmanager_ethernet_apply

# Timezone apply (copies resolved TZif over /etc/localtime)
www-data ALL=(root) NOPASSWD: /usr/bin/qmanager_timezone_apply

# Runtime language-pack downloader (commits validated staging into the
# root-owned persistent store + served web-root copy; remove mode too)
www-data ALL=(root) NOPASSWD: /usr/bin/qmanager_language_pack_apply

# SIM Registry apply (commits carrier/phone_number/dismissed fields into
# /etc/qmanager/sim_registry.json — the helper hardcodes the path and validates
# the ICCID/field values itself).
#
# NOTE (corrected): that file is NOT root-owned. Like every other file in
# /etc/qmanager it is re-chowned to www-data:www-data 0644 by qmanager_setup on
# every boot (verified live). The grant exists for VALIDATION and INTEGRITY —
# hardcoded path, symlink refusal, per-field validation, atomic replace — not
# because www-data lacks write access.
www-data ALL=(root) NOPASSWD: /usr/bin/qmanager_sim_registry_apply

# Custom DNS management (dnsmasq config atomic swap + reload)
# Note: chown's "radio:radio" argument has the colon backslash-escaped because
# sudoers treats ':' as the user:group separator in any token unless escaped.
www-data ALL=(root) NOPASSWD: /bin/mv /etc/data/qmanager/dnsmasq.conf.new /etc/data/dnsmasq.conf
www-data ALL=(root) NOPASSWD: /bin/chown radio\:radio /etc/data/dnsmasq.conf
www-data ALL=(root) NOPASSWD: /usr/bin/killall -HUP dnsmasq
