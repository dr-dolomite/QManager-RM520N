#!/bin/sh
# =============================================================================
# qmanager_secret_set — Root helper: store/clear the alert-channel secrets
# outside the www-data-owned config directory.
# =============================================================================
# WHY THIS EXISTS
# ---------------
# The Discord bot token and the Gmail app password used to live inside
# /etc/qmanager/discord_bot.json and /etc/qmanager/email_alerts.json, and the
# generated msmtprc lived at /etc/qmanager/msmtprc. That whole directory is
# owned by www-data (the CGI has to write the config JSONs), so every one of
# those plaintext credentials was readable — and rewritable — by the web
# process. Any file-read bug in an unrelated CGI endpoint leaked them.
#
# They now live in /etc/qmanager-secrets/ (0700 root:root), which www-data
# cannot even traverse. The CGI keeps writing the non-secret config JSONs
# itself and calls this helper — through one bare-path sudoers grant — to put
# the secret where only root can read it.
#
# The config JSONs keep only a NON-SECRET marker boolean (`token_set` /
# `app_password_set`) so the UI can still render "configured / not configured"
# without any privileged read. This helper owns those markers.
#
# Usage:
#   qmanager_secret_set set     <name>     # value read from STDIN, never argv
#   qmanager_secret_set clear   <name>
#   qmanager_secret_set refresh email_app_password
#
#   <name> is a hard whitelist: discord_bot_token | email_app_password
#
# The value arrives on STDIN and never on argv, because argv is world-readable
# through /proc/<pid>/cmdline — passing it as an argument would recreate the
# exact disclosure this change removes. (Same idiom as
# qmanager_set_ssh_password, called from cgi_auth.sh.)
#
# `refresh` re-renders msmtprc from the ALREADY-STORED password plus the
# current sender_email in email_alerts.json. It exists because the user can
# change sender_email without re-typing the password, and msmtprc embeds both.
#
# Output: exactly one line of JSON on stdout, matching the other qmanager_*
#         root helpers. Exit 0 = success, 1 = failure.
#
# Called via sudoers: www-data ALL=(root) NOPASSWD: /usr/bin/qmanager_secret_set
# Install location: /usr/bin/qmanager_secret_set
# =============================================================================

# sudo hands over a stripped environment; without this jq (Entware, /opt/bin)
# is simply not found and every marker update would fail.
PATH=/opt/bin:/opt/sbin:/usr/bin:/usr/sbin:/bin:/sbin
export PATH

# Every path is hardcoded. Nothing from argv is ever interpolated into a path —
# argv supplies only the action verb and a whitelisted secret NAME.
SECRETS_DIR="/etc/qmanager-secrets"
DISCORD_SECRET="/etc/qmanager-secrets/discord_bot_token"
EMAIL_SECRET="/etc/qmanager-secrets/email_app_password"
MSMTP_CONFIG="/etc/qmanager-secrets/msmtprc"
LEGACY_MSMTP="/etc/qmanager/msmtprc"

CONFIG_DIR="/etc/qmanager"
DISCORD_CONFIG="/etc/qmanager/discord_bot.json"
EMAIL_CONFIG="/etc/qmanager/email_alerts.json"

MAX_LEN=4096

# --- Output helpers ----------------------------------------------------------
# Every detail string below is a fixed literal — no caller-supplied text is
# ever interpolated into the JSON, so hand-rolling these two lines is safe and
# keeps the helper working even if jq is missing.
fail() {
    printf '{"success":false,"error":"%s","detail":"%s"}\n' "$1" "$2"
    exit 1
}

ok() {
    printf '{"success":true}\n'
    exit 0
}

ok_warn() {
    printf '{"success":true,"detail":"%s"}\n' "$1"
    exit 0
}

# A failed marker write is a HARD error, not a warning.
#
# The *_set marker stopped being cosmetic when it became the sole authority on
# "is this channel configured": email_alerts.sh:_ea_read_config forces
# _ea_enabled=false when app_password_set is not true. So a secret stored
# WITHOUT its marker means the operator sees a green save and then silently
# receives no alerts — with the explanation buried in a `detail` field the UI
# does not surface. Exiting 0 there hides the one thing they need to know.
#
# The credential is already durably on disk whenever this is reached (the
# marker is always written last), so a retry is safe and idempotent — say so,
# rather than leaving the operator to guess whether re-entering it will
# double-apply.
# The tail clause is deliberately verb-NEUTRAL ("the credential store was
# updated"), because this is reached from `clear` as well as `set`/`refresh`.
# Saying "was saved" would tell an operator who just cleared a token the exact
# opposite of what happened.
marker_fail() {
    fail "marker_write_failed" "$1 — the credential store was updated; retry to finish updating the configuration"
}

# --- Symlink guard -----------------------------------------------------------
# www-data owns /etc/qmanager and could replace any file there with a symlink
# pointing at a root-owned target; a root write would then follow it. Refuse
# (and remove) the symlink instead of writing through it. Applied to every
# path this helper writes, including the ones under the root-owned secrets dir
# (belt and braces — cheap, and correct if the dir mode ever regresses).
unlink_if_symlink() {
    if [ -L "$1" ]; then
        rm -f "$1"
    fi
    return 0
}

# --- Secrets directory -------------------------------------------------------
# `install -d -m 0700`, never `mkdir -p`: mkdir -p silently no-ops on an
# existing directory, so a bad mode created by an earlier version would persist
# forever across OTA upgrades. install -d applies the mode every time. The
# chmod/chown afterwards are deliberate rather than `install -o/-g` flags,
# which are not reliably supported by the BusyBox applet.
ensure_secrets_dir() {
    unlink_if_symlink "$SECRETS_DIR"
    if [ ! -d "$SECRETS_DIR" ]; then
        # rc deliberately ignored: some install(1) variants report failure after
        # having created the directory (e.g. when the mode change is refused).
        # The `[ -d ]` test below is the real success condition, and the
        # chmod/chown that follow re-assert the mode either way.
        install -d -m 0700 "$SECRETS_DIR" 2>/dev/null
    fi
    [ -d "$SECRETS_DIR" ] || return 1
    chmod 0700 "$SECRETS_DIR" 2>/dev/null
    chown root:root "$SECRETS_DIR" 2>/dev/null
    return 0
}

# --- Private atomic write ----------------------------------------------------
# write_private <path> <content>
#
# mktemp INSIDE the destination directory, never a bare mktemp: a bare one
# lands in /tmp, which is tmpfs — a different filesystem from /etc's UBIFS —
# where `mv` silently degrades to copy+unlink and a power cut can tear the
# file. Mode AND owner are set on the TEMP before the rename, so the secret is
# never briefly world-readable at the final path.
write_private() {
    _wp_path="$1"
    _wp_content="$2"

    unlink_if_symlink "$_wp_path"

    _wp_tmp=$(mktemp "${SECRETS_DIR}/.tmp.XXXXXX" 2>/dev/null) || return 1
    chmod 0600 "$_wp_tmp" 2>/dev/null
    chown root:root "$_wp_tmp" 2>/dev/null

    if ! printf '%s' "$_wp_content" > "$_wp_tmp" 2>/dev/null; then
        rm -f "$_wp_tmp"
        return 1
    fi
    if ! mv "$_wp_tmp" "$_wp_path" 2>/dev/null; then
        rm -f "$_wp_tmp"
        return 1
    fi
    return 0
}

# --- Marker update -----------------------------------------------------------
# set_marker <config_json> <marker_key> <true|false> <secret_key_to_delete>
#
# Atomic (temp in the SAME directory, then mv) and it also strips the legacy
# secret key, so the first save after an upgrade removes the plaintext from the
# JSON.
#
# Returns non-zero (with MARKER_WARN set) rather than aborting, so that a marker
# failure can never leave the secret unstored: every caller stores the secret
# FIRST and updates the marker LAST. The caller then turns that non-zero into a
# hard error via marker_fail() — see the rationale there. Ordering is the point:
# the credential is durable before anything can go wrong here, which is what
# makes the resulting error safely retryable.
#
# jq NOTE: device jq is built without Oniguruma — gsub/test/match ABORT at
# runtime (and `jq -n builtins` still lists them, so that is not a valid
# probe). Only plain filters, del(), //, assignment and --arg/--argjson are
# used here.
MARKER_WARN=""
set_marker() {
    _sm_file="$1"
    _sm_key="$2"
    _sm_val="$3"
    _sm_del="$4"

    if [ ! -f "$_sm_file" ]; then
        MARKER_WARN="the secret store was updated, but the config JSON was missing so the *_set marker could not be updated"
        return 1
    fi
    if ! jq -e . "$_sm_file" >/dev/null 2>&1; then
        MARKER_WARN="the secret store was updated, but the config JSON is unparseable so the *_set marker could not be updated"
        return 1
    fi

    unlink_if_symlink "$_sm_file"

    _sm_tmp=$(mktemp "${CONFIG_DIR}/.qmsecret.XXXXXX" 2>/dev/null) || {
        MARKER_WARN="the secret store was updated, but a temp file for the marker update could not be created"
        return 1
    }

    if ! jq --arg k "$_sm_key" --argjson v "$_sm_val" --arg d "$_sm_del" \
        'del(.[$d]) | .[$k] = $v' "$_sm_file" > "$_sm_tmp" 2>/dev/null; then
        rm -f "$_sm_tmp"
        MARKER_WARN="the secret store was updated, but rewriting the config JSON marker failed"
        return 1
    fi

    # /etc/qmanager is the www-data-owned config dir — keep these JSONs
    # www-data:www-data 0644 so the CGI can keep replacing them. (qmanager_setup
    # re-chowns this whole directory on every boot anyway; a root pin here
    # would be decorative.)
    chmod 0644 "$_sm_tmp" 2>/dev/null
    chown www-data:www-data "$_sm_tmp" 2>/dev/null

    if ! mv "$_sm_tmp" "$_sm_file" 2>/dev/null; then
        rm -f "$_sm_tmp"
        MARKER_WARN="the secret store was updated, but installing the updated config JSON failed"
        return 1
    fi
    return 0
}

# --- msmtprc rendering -------------------------------------------------------
# render_msmtprc <password>
#   0 = rendered, 1 = write failure, 2 = no sender_email configured yet,
#   3 = sender_email contains control characters
#
# This moved out of the CGI: msmtprc embeds the plaintext password, so it must
# be created by root, 0600, inside the secrets dir. sender_email is re-checked
# for control characters HERE as well as in the CGI — defense in depth, since
# an embedded newline would inject arbitrary msmtp directives into the file.
render_msmtprc() {
    _rm_pw="$1"
    _rm_sender=""

    if [ -f "$EMAIL_CONFIG" ]; then
        _rm_sender=$(jq -r '.sender_email // ""' "$EMAIL_CONFIG" 2>/dev/null)
    fi
    [ -n "$_rm_sender" ] || return 2
    case "$_rm_sender" in
        *[[:cntrl:]]*) return 3 ;;
    esac

    unlink_if_symlink "$MSMTP_CONFIG"

    _rm_tmp=$(mktemp "${SECRETS_DIR}/.msmtp.XXXXXX" 2>/dev/null) || return 1
    chmod 0600 "$_rm_tmp" 2>/dev/null
    chown root:root "$_rm_tmp" 2>/dev/null

    if ! cat > "$_rm_tmp" <<MSMTPEOF 2>/dev/null
defaults
auth           on
tls            on
tls_starttls   on
tls_trust_file /etc/ssl/certs/ca-certificates.crt

account        default
host           smtp.gmail.com
port           587
from           ${_rm_sender}
user           ${_rm_sender}
password       ${_rm_pw}
MSMTPEOF
    then
        rm -f "$_rm_tmp"
        return 1
    fi

    if ! mv "$_rm_tmp" "$MSMTP_CONFIG" 2>/dev/null; then
        rm -f "$_rm_tmp"
        return 1
    fi

    # Drop any pre-relocation copy still sitting in the www-data-readable dir.
    rm -f "$LEGACY_MSMTP" 2>/dev/null
    return 0
}

# =============================================================================
# Argument parsing — action verb + whitelisted name, nothing else
# =============================================================================
action="$1"
name="$2"

case "$action" in
    set|clear|refresh) ;;
    *) fail "invalid_action" "action must be set, clear, or refresh" ;;
esac

case "$name" in
    discord_bot_token|email_app_password) ;;
    *) fail "invalid_name" "name must be discord_bot_token or email_app_password" ;;
esac

if [ "$action" = "refresh" ] && [ "$name" != "email_app_password" ]; then
    fail "invalid_action" "refresh is only supported for email_app_password"
fi

if ! ensure_secrets_dir; then
    fail "dir_failed" "could not create or secure /etc/qmanager-secrets"
fi

# =============================================================================
# clear
# =============================================================================
if [ "$action" = "clear" ]; then
    if [ "$name" = "discord_bot_token" ]; then
        unlink_if_symlink "$DISCORD_SECRET"
        rm -f "$DISCORD_SECRET" 2>/dev/null
        set_marker "$DISCORD_CONFIG" "token_set" "false" "bot_token" || marker_fail "$MARKER_WARN"
    else
        unlink_if_symlink "$EMAIL_SECRET"
        rm -f "$EMAIL_SECRET" 2>/dev/null
        unlink_if_symlink "$MSMTP_CONFIG"
        rm -f "$MSMTP_CONFIG" 2>/dev/null
        rm -f "$LEGACY_MSMTP" 2>/dev/null
        set_marker "$EMAIL_CONFIG" "app_password_set" "false" "app_password" || marker_fail "$MARKER_WARN"
    fi
    ok
fi

# =============================================================================
# refresh email_app_password — re-render msmtprc from the STORED secret
# =============================================================================
if [ "$action" = "refresh" ]; then
    if [ ! -f "$EMAIL_SECRET" ] || [ ! -s "$EMAIL_SECRET" ]; then
        # Not an error: the user may be saving a sender_email change with no
        # password ever stored, or with email alerts switched off.
        printf '{"success":true,"skipped":"no_stored_secret"}\n'
        exit 0
    fi

    # Command substitution strips trailing newlines, which is exactly the
    # "raw value, no trailing newline" shape the file is written in.
    stored=$(cat "$EMAIL_SECRET" 2>/dev/null)
    if [ -z "$stored" ]; then
        printf '{"success":true,"skipped":"no_stored_secret"}\n'
        exit 0
    fi

    render_msmtprc "$stored"
    rc=$?
    stored=""
    case "$rc" in
        0) ;;
        2) printf '{"success":true,"skipped":"no_sender_email"}\n'; exit 0 ;;
        3) fail "invalid_sender" "sender_email contains control characters" ;;
        *) fail "msmtprc_failed" "failed to render the msmtp configuration" ;;
    esac

    # A stored secret always implies the marker is true; re-asserting it here
    # self-heals a JSON that lost the marker (e.g. an interrupted save).
    set_marker "$EMAIL_CONFIG" "app_password_set" "true" "app_password" || marker_fail "$MARKER_WARN"
    ok
fi

# =============================================================================
# set — value on STDIN
# =============================================================================
# Trailing newlines are stripped by the command substitution, so a caller that
# pipes `printf '%s\n'` (the cgi_auth.sh idiom) still stores a clean raw value.
val=$(cat)

[ -n "$val" ] || fail "empty_value" "no value was supplied on stdin"

# Reject embedded control characters / newlines outright. A newline in the
# password would inject arbitrary directives into msmtprc.
case "$val" in
    *[[:cntrl:]]*) fail "invalid_value" "value must not contain control characters" ;;
esac

if [ "${#val}" -gt "$MAX_LEN" ]; then
    fail "value_too_long" "value exceeds the 4096-character limit"
fi

if [ "$name" = "discord_bot_token" ]; then
    # Discord bot tokens are base64url segments joined by dots.
    rest=$(printf '%s' "$val" | tr -d 'A-Za-z0-9._-')
    [ -z "$rest" ] || fail "invalid_value" "discord_bot_token may only contain letters, digits, dot, underscore and hyphen"

    if ! write_private "$DISCORD_SECRET" "$val"; then
        val=""
        fail "store_failed" "failed to store the Discord bot token"
    fi
    val=""
    set_marker "$DISCORD_CONFIG" "token_set" "true" "bot_token" || marker_fail "$MARKER_WARN"
    ok
fi

# email_app_password — printable, non-space ASCII only (0x21-0x7E).
rest=$(printf '%s' "$val" | tr -d '!-~')
[ -z "$rest" ] || fail "invalid_value" "email_app_password may only contain printable non-space ASCII characters"

# Store the secret FIRST. msmtprc and the marker are both derived artifacts —
# never fail the whole operation (leaving the secret unstored) because one of
# them could not be written.
if ! write_private "$EMAIL_SECRET" "$val"; then
    val=""
    fail "store_failed" "failed to store the email app password"
fi

render_msmtprc "$val"
rc=$?
val=""
case "$rc" in
    0) ;;
    2)
        # Password stored, but there is no sender_email to template yet. The
        # next save that sets one will call `refresh` and render msmtprc then.
        set_marker "$EMAIL_CONFIG" "app_password_set" "true" "app_password" || marker_fail "$MARKER_WARN"
        ok_warn "password stored, but msmtprc was not rendered because sender_email is not configured yet"
        ;;
    3) fail "invalid_sender" "sender_email contains control characters" ;;
    *) fail "msmtprc_failed" "failed to render the msmtp configuration" ;;
esac

set_marker "$EMAIL_CONFIG" "app_password_set" "true" "app_password" || marker_fail "$MARKER_WARN"
ok
