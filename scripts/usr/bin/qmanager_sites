#!/bin/bash
# =============================================================================
# qmanager_sites — QManager Sites Monitor Daemon
# =============================================================================
# Every interval_sec (default 300) measures the TCP handshake time to each
# configured website over the cellular link, and keeps the history.
# Never touches the modem serial port. bash (not sh) for 64-bit arithmetic.
#
# Config  : /etc/qmanager/sites.json (written by www-data; validated here)
# Latest  : /tmp/qmanager_sites.json            (root, atomic)
# Raw 24h : /tmp/qmanager_sites_raw.ndjson      (root, trimmed to 24 h)
# Rollups : /usrdata/qmanager/sites/YYYY-MM-DD.jsonl (append-only, hourly rows)
# Flag    : /tmp/qmanager_sites_now  (created by www-data; root only tests+rm)
# Lease   : /tmp/qmanager_sites_live (written by www-data; root only reads it)
# Live    : /tmp/qmanager_sites_live.json (root, atomic; ~2 s HTTP samples while leased)
#
# Test overrides: QM_SITES_TMP_DIR, QM_SITES_DATA_DIR, QM_SITES_CONF,
# QM_SITES_ONESHOT=1 (one sweep, flush, exit).
# =============================================================================

. /usr/lib/qmanager/qlog.sh 2>/dev/null || {
    qlog_init() { :; }
    qlog_debug() { :; }
    qlog_info() { :; }
    qlog_warn() { :; }
    qlog_error() { :; }
}
qlog_init "sites"

TMP_DIR="${QM_SITES_TMP_DIR:-/tmp}"
DATA_DIR="${QM_SITES_DATA_DIR:-/usrdata/qmanager/sites}"
CONF_FILE="${QM_SITES_CONF:-/etc/qmanager/sites.json}"
ONESHOT="${QM_SITES_ONESHOT:-}"

LATEST_FILE="$TMP_DIR/qmanager_sites.json"
RAW_FILE="$TMP_DIR/qmanager_sites_raw.ndjson"
FLUSHED_FILE="$TMP_DIR/qmanager_sites_flushed"
NOW_FLAG="$TMP_DIR/qmanager_sites_now"
CHECKING_FILE="$TMP_DIR/qmanager_sites_checking"
PID_FILE="$TMP_DIR/qmanager_sites.pid"
LIVE_LEASE="$TMP_DIR/qmanager_sites_live"       # www-data-owned: only ever read here
LIVE_FILE="$TMP_DIR/qmanager_sites_live.json"

CURL=/usr/bin/curl
SANE_EPOCH=1700000000       # the device boots at 1970; below this the clock is unset
BOOT_SETTLE=60              # first sweep waits for uptime >= this (clock step ~24 s, jq mount ~30 s)
MIN_FLAG_GAP=10             # a spammed check-now flag cannot sweep more often than this
POLL=5                      # flag poll while waiting
LIVE_LEASE_SEC=10           # live ticks run while the lease is at most this old
LIVE_TICK=2                 # target seconds per live tick
RETAIN_DAYS=90
DATA_CAP_KB=4096
MIN_FREE_KB=8192
MAX_SITES=32

DEFAULT_SITES="google.com facebook.com tiktok.com youtube.com roblox.com spotify.com x.com cellmapper.net reddit.com github.com discord.com instagram.com messenger.com"

# --- State -------------------------------------------------------------------
cfg_enabled="true"
cfg_interval=300
cfg_hosts=""                # newline-separated, validated
flushed_through=0           # newest raw ts already written to a rollup
TMPD=""
live_on="false"
live_ips=""                 # "host ipv4" lines learned from live probes
live_ips_for=""             # cfg_hosts the cache was built for
live_frac=""                # 1 when sleep takes fractional seconds
CS=0                        # set by mono_cs

# =============================================================================
# HELPERS
# =============================================================================

mono_now() {
    local up _
    read -r up _ < /proc/uptime 2>/dev/null
    up="${up%%.*}"
    case "$up" in ''|*[!0-9]*) up=0 ;; esac
    echo "$up"
}

# Uptime in centiseconds -> CS (no fork).
mono_cs() {
    local up _
    read -r up _ < /proc/uptime 2>/dev/null
    up="${up/./}"
    case "$up" in ''|*[!0-9]*) up=0 ;; esac
    CS=$((10#$up))
}

# Atomic root-side publish: mktemp + 0644 + mv. Reads the body from stdin.
atomic_put() {
    local dest="$1" t
    t=$(mktemp "${dest}.XXXXXX" 2>/dev/null) || return 1
    if cat > "$t" && chmod 0644 "$t" && mv -f "$t" "$dest"; then
        return 0
    fi
    rm -f "$t"
    return 1
}

# Drop a fixed /tmp file we do not own: root's O_CREAT append hits EACCES on a
# www-data pre-created file under protected_regular=1. Our own files are kept.
own_or_rm() {
    [ -e "$1" ] || [ -L "$1" ] || return 0
    [ -O "$1" ] && [ ! -L "$1" ] || rm -f "$1"
}

# Conservative hostname / IPv4 check, no regex engine (device jq has none).
valid_host() {
    local h="$1"
    [ "${#h}" -ge 3 ] && [ "${#h}" -le 253 ] || return 1
    case "$h" in
        *[!A-Za-z0-9.-]*|-*|.*|*.|*-|*..*|*.-*|*-.*) return 1 ;;
        *.*) return 0 ;;
    esac
    return 1
}

# --- Config ------------------------------------------------------------------
# Returns 1 only when jq itself is unusable (retry later); never "disabled".
load_config() {
    local out line n=0 seen_sites="false" hosts="" h

    cfg_enabled="true"
    cfg_interval=300
    cfg_hosts=""

    jq -n 1 >/dev/null 2>&1 || return 1

    if [ -f "$CONF_FILE" ]; then
        out=$(jq -r '
            (if .enabled == false then "false" else "true" end),
            (.interval_sec | if type == "number" then floor | tostring else "300" end),
            (has("sites") | tostring),
            (if has("sites") and (.sites | type == "array")
             then (.sites[:32][] | if type == "object" then (.host | strings) else empty end)
             else empty end)
        ' "$CONF_FILE" 2>/dev/null) || {
            qlog_warn "sites.json unreadable, using defaults"
            out=""
        }
    fi

    if [ -n "$out" ]; then
        while IFS= read -r line; do
            n=$((n + 1))
            case "$n" in
                1) cfg_enabled="$line" ;;
                2) cfg_interval="$line" ;;
                3) seen_sites="$line" ;;
                *) hosts="$hosts$line"$'\n' ;;
            esac
        done <<EOF
$out
EOF
    else
        seen_sites="false"
    fi

    case "$cfg_interval" in ''|*[!0-9]*) cfg_interval=300 ;; esac
    [ "$cfg_interval" -lt 60 ] && cfg_interval=60
    [ "$cfg_interval" -gt 3600 ] && cfg_interval=3600

    if [ "$seen_sites" != "true" ]; then
        hosts=""
        for h in $DEFAULT_SITES; do hosts="$hosts$h"$'\n'; done
    fi

    # Validate + dedupe; a bad entry is skipped, never aborts.
    n=0
    while IFS= read -r h; do
        [ -n "$h" ] || continue
        valid_host "$h" || { qlog_warn "sites: skipping invalid host"; continue; }
        case $'\n'"$cfg_hosts" in *$'\n'"$h"$'\n'*) continue ;; esac
        [ "$n" -ge "$MAX_SITES" ] && break
        cfg_hosts="$cfg_hosts$h"$'\n'
        n=$((n + 1))
    done <<EOF
$hosts
EOF
    return 0
}

# --- Probes ------------------------------------------------------------------
# HEAD (-I) keeps the exchange to a few KB; ms = connect - namelookup.
# $1 = result file, $2 = host. Writes "s <host> <ms|null>".
probe_site() {
    local out rc k="" d c ms=null t
    case "$2" in *[!0-9.]*) ;; *) k="-k" ;; esac
    out=$("$CURL" -s -I $k -o /dev/null --connect-timeout 5 --max-time 6 \
        -w '%{time_namelookup} %{time_connect}' -- "https://$2" </dev/null 2>/dev/null)
    rc=$?
    d="${out%% *}"; c="${out##* }"
    if [ "$rc" -eq 0 ]; then
        case "$d" in [0-9].[0-9][0-9][0-9][0-9][0-9][0-9]) ;; *) d="" ;; esac
        case "$c" in [0-9].[0-9][0-9][0-9][0-9][0-9][0-9]) ;; *) c="" ;; esac
        if [ -n "$d" ] && [ -n "$c" ]; then
            d=$((10#${d/./})); c=$((10#${c/./}))
            if [ "$c" -gt 0 ]; then
                t=$(( (c - d + 50) / 100 ))
                [ "$t" -lt 0 ] && t=0
                ms="$((t / 10)).$((t % 10))"
            fi
        fi
    fi
    printf 's %s %s\n' "$2" "$ms" > "$1"
}

# Gateway entry only when the default route has a real next hop on a LAN-style
# device; the cellular rmnet hop is point-to-point and never answers.
probe_gateway() {
    local route gw dev out rtt ms=null
    route=$(ip route show default 2>/dev/null | head -n1)
    case "$route" in *" via "*) ;; *) return 1 ;; esac
    gw="${route#* via }"; gw="${gw%% *}"
    dev="${route#* dev }"; dev="${dev%% *}"
    case "$dev" in rmnet*|ppp*|wwan*|usb*) return 1 ;; esac
    valid_host "$gw" || return 1
    out=$(ping -c1 -W2 "$gw" 2>/dev/null </dev/null)
    rtt=$(printf '%s\n' "$out" | grep -oE 'time=[0-9.]+' | head -n1 | cut -d= -f2)
    case "$rtt" in
        ''|*[!0-9.]*) ;;
        *) ms=$(awk -v r="$rtt" 'BEGIN { printf "%.1f", r }') ;;
    esac
    printf 'g %s %s\n' "$gw" "$ms" > "$1"
}

# =============================================================================
# SWEEP
# =============================================================================

sweep() {
    local start_mono ts ts_json next_json i=0 h f pids="" results nrows

    start_mono=$(mono_now)
    ts=$(date +%s)
    ts_json=null; next_json=null
    if [ "$ts" -ge "$SANE_EPOCH" ]; then
        ts_json="$ts"; next_json=$((ts + cfg_interval))
    fi

    atomic_put "$CHECKING_FILE" </dev/null
    TMPD=$(mktemp -d "$TMP_DIR/qmanager_sites.XXXXXX") || { qlog_error "mktemp failed"; return 1; }

    printf -v f '%s/r%02d' "$TMPD" "$i"
    probe_gateway "$f" &
    pids="$pids $!"
    i=$((i + 1))
    while IFS= read -r h; do
        [ -n "$h" ] || continue
        printf -v f '%s/r%02d' "$TMPD" "$i"
        probe_site "$f" "$h" &
        pids="$pids $!"
        i=$((i + 1))
    done <<EOF
$cfg_hosts
EOF
    # shellcheck disable=SC2086
    wait $pids 2>/dev/null

    results=$(cat "$TMPD"/r* 2>/dev/null | jq -Rn '
        [inputs | split(" ")
         | {host: .[1], kind: (if .[0] == "g" then "gateway" else "site" end),
            ms: (if .[2] == "null" then null else (.[2] | tonumber) end)}
         | .ok = (.ms != null)]')
    rm -rf "$TMPD"; TMPD=""
    if [ -z "$results" ]; then
        qlog_error "sweep produced no results"
        rm -f "$CHECKING_FILE"
        return 1
    fi

    jq -n --argjson r "$results" --argjson ts "$ts_json" --argjson nx "$next_json" \
        --argjson iv "$cfg_interval" '
        {checked_at: $ts, interval_sec: $iv, next_check_at: $nx, wan: "cellular",
         results: ($r | map({host, kind, ts: $ts, ms, ok}))}' | atomic_put "$LATEST_FILE"

    nrows=$(printf '%s' "$results" | jq -r '"\([.[] | select(.ok)] | length) of \(length)"')
    qlog_info "sweep: ${nrows:-0} answered in $(( $(mono_now) - start_mono ))s"

    if [ "$ts" -ge "$SANE_EPOCH" ]; then
        own_or_rm "$RAW_FILE"
        printf '%s' "$results" | jq -c --argjson ts "$ts" \
            '.[] | {ts: $ts, host, ms, ok}' >> "$RAW_FILE"
        trim_raw "$ts"
        flush_rollups "$(( ts / 3600 * 3600 ))"
    fi
    rm -f "$CHECKING_FILE"
    return 0
}

# Drop raw rows older than 24 h (rows start with {"ts":N,).
trim_raw() {
    [ -s "$RAW_FILE" ] || return 0
    awk -v c="$(( $1 - 86400 ))" '{ if (substr($0, 7) + 0 >= c) print }' "$RAW_FILE" \
        | atomic_put "$RAW_FILE"
}

# =============================================================================
# ROLLUPS
# =============================================================================

load_flushed() {
    local v
    v=$(cat "$FLUSHED_FILE" 2>/dev/null)
    case "$v" in ''|*[!0-9]*) v=0 ;; esac
    flushed_through="$v"
}

# Append hourly rows for raw samples newer than flushed_through and older than
# $1 (epoch limit; pass a far-future value to include the pending hour).
flush_rollups() {
    local limit="$1" out free

    [ -s "$RAW_FILE" ] || return 0
    free=$(df -k "$DATA_DIR" 2>/dev/null | awk 'NR > 1 { v = $4 } END { print v + 0 }')
    if [ "${free:-0}" -gt 0 ] && [ "$free" -lt "$MIN_FREE_KB" ]; then
        qlog_warn "sites: rollup flush skipped, ${free}KB free"
        return 0
    fi
    install -d -o root -g root -m 0755 "$DATA_DIR" 2>/dev/null || return 0

    out=$(jq -Rn -r --argjson f "$flushed_through" --argjson lim "$limit" '
        [inputs | fromjson? | objects
         | select((.ts | type) == "number" and .ts > $f and .ts < $lim)] as $r
        | if ($r | length) == 0 then empty else
            ($r | group_by([((.ts / 3600) | floor), .host])[]
             | map(.ms | numbers) as $v
             | {ts_hour: (((.[0].ts / 3600) | floor) * 3600), host: .[0].host,
                n: length, ok: (map(select(.ok == true)) | length),
                min: (if ($v | length) > 0 then ($v | min) else null end),
                avg: (if ($v | length) > 0 then ((($v | add) / ($v | length) * 10 | round) / 10) else null end),
                max: (if ($v | length) > 0 then ($v | max) else null end)}
             | ((.ts_hour | strftime("%Y-%m-%d")) + "\t" + tostring)),
            "F\t" + ($r | map(.ts) | max | tostring)
          end' "$RAW_FILE" 2>/dev/null)
    [ -n "$out" ] || return 0

    # One append per day file.
    printf '%s\n' "$out" | awk -F'\t' -v dir="$DATA_DIR" '
        $1 != "F" { print $2 >> (dir "/" $1 ".jsonl") }'
    flushed_through=$(printf '%s\n' "$out" | awk -F'\t' '$1 == "F" { print $2 }')
    printf '%s\n' "$flushed_through" | atomic_put "$FLUSHED_FILE"
    expire_rollups "$(date +%s)"
}

# Whole-file expiry (> 90 d), then the 4 MB cap, oldest day first.
expire_rollups() {
    local cutoff f name total
    cutoff=$(date -u -d "@$(( $1 - RETAIN_DAYS * 86400 ))" +%Y-%m-%d 2>/dev/null)
    case "$cutoff" in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;; *) return 0 ;; esac
    for f in "$DATA_DIR"/*.jsonl; do
        [ -f "$f" ] || continue
        name="${f##*/}"; name="${name%.jsonl}"
        [[ "$name" < "$cutoff" ]] && rm -f "$f"
    done
    while :; do
        total=$(cat "$DATA_DIR"/*.jsonl 2>/dev/null | wc -c)
        [ "${total:-0}" -le $((DATA_CAP_KB * 1024)) ] && break
        f=$(ls "$DATA_DIR"/*.jsonl 2>/dev/null | head -n2)
        [ "$(printf '%s\n' "$f" | wc -l)" -ge 2 ] || break
        rm -f "$(printf '%s\n' "$f" | head -n1)"
    done
}

# =============================================================================
# LIVE MODE (while a browser holds the lease: ~2 s HTTP probes, latest-only)
# =============================================================================

# True while the lease holds a recent epoch. The file is www-data's: never
# trust its content beyond digits, never write it.
live_fresh() {
    local v="" now
    [ "$cfg_enabled" = "false" ] && return 1
    [ -f "$LIVE_LEASE" ] && [ ! -L "$LIVE_LEASE" ] || return 1
    { read -r -n 13 v < "$LIVE_LEASE"; } 2>/dev/null
    case "$v" in ''|*[!0-9]*) return 1 ;; esac
    [ "${#v}" -le 12 ] || return 1
    now=$(date +%s)
    [ $(( now - 10#$v )) -ge 0 ] && [ $(( now - 10#$v )) -le "$LIVE_LEASE_SEC" ]
}

# $1 = host -> LIP = cached IPv4 or "".
lookup_ip() {
    local l
    LIP=""
    while IFS= read -r l; do
        case "$l" in "$1 "*) LIP="${l#* }"; return 0 ;; esac
    done <<EOF
$live_ips
EOF
    return 0
}

# Plain HTTP HEAD on :80 (TCP handshake time, no TLS). $1 = result file,
# $2 = host, $3 = cached IPv4 or "". Writes "s <host> <ms|null> <ipv4|>".
live_probe() {
    local out rc d c ip ms=null t res=""
    [ -n "$3" ] && res="--resolve $2:80:$3"
    # shellcheck disable=SC2086
    out=$("$CURL" -s -I $res -o /dev/null --connect-timeout 1.5 --max-time 1.8 \
        -w '%{time_namelookup} %{time_connect} %{remote_ip}' -- "http://$2/" </dev/null 2>/dev/null)
    rc=$?
    d="${out%% *}"; c="${out#* }"; ip="${c#* }"; c="${c%% *}"
    case "$ip" in ''|*[!0-9.]*) ip="" ;; esac
    if [ "$rc" -eq 0 ]; then
        case "$d" in [0-9].[0-9][0-9][0-9][0-9][0-9][0-9]) ;; *) d="" ;; esac
        case "$c" in [0-9].[0-9][0-9][0-9][0-9][0-9][0-9]) ;; *) c="" ;; esac
        if [ -n "$d" ] && [ -n "$c" ]; then
            d=$((10#${d/./})); c=$((10#${c/./}))
            if [ "$c" -gt 0 ]; then
                t=$(( (c - d + 50) / 100 ))
                [ "$t" -lt 0 ] && t=0
                ms="$((t / 10)).$((t % 10))"
            fi
        fi
    else
        ip=""
    fi
    printf 's %s %s %s\n' "$2" "$ms" "$ip" > "$1"
}

# One live tick: probe every host in parallel, publish LIVE_FILE, pace to LIVE_TICK.
live_tick() {
    local t0 at i=0 h f pids="" tag ms ip lines="" nips="" out rem s

    mono_cs; t0=$CS
    [ "$live_ips_for" = "$cfg_hosts" ] || { live_ips=""; live_ips_for="$cfg_hosts"; }
    TMPD=$(mktemp -d "$TMP_DIR/qmanager_sites.XXXXXX") || { qlog_error "mktemp failed"; nap 1; return 1; }

    while IFS= read -r h; do
        [ -n "$h" ] || continue
        printf -v f '%s/r%02d' "$TMPD" "$i"
        lookup_ip "$h"
        live_probe "$f" "$h" "$LIP" &
        pids="$pids $!"
        i=$((i + 1))
    done <<EOF
$cfg_hosts
EOF
    # shellcheck disable=SC2086
    wait $pids 2>/dev/null

    at=$(date +%s)
    for f in "$TMPD"/r*; do
        [ -f "$f" ] || continue
        read -r tag h ms ip < "$f"
        [ -n "$h" ] || continue
        lines="$lines$tag $h $ms"$'\n'
        # Cache only a fresh IPv4 from a host name (an IP literal needs no pin).
        case "$h" in *[!0-9.]*) [ -n "$ip" ] && nips="$nips$h $ip"$'\n' ;; esac
    done
    live_ips="$nips"
    rm -rf "$TMPD"; TMPD=""

    out=$(printf '%s' "$lines" | jq -Rnc --argjson at "$at" '
        {at: $at,
         results: [inputs | split(" ")
                   | {host: .[1], ms: (if .[2] == "null" then null else (.[2] | tonumber) end)}
                   | .ok = (.ms != null)]}')
    [ -n "$out" ] && printf '%s\n' "$out" | atomic_put "$LIVE_FILE"

    if [ -z "$live_frac" ]; then
        if sleep 0.01 </dev/null 2>/dev/null; then live_frac=1; else live_frac=0; fi
    fi
    if [ "$live_frac" = "1" ]; then
        mono_cs
        rem=$(( LIVE_TICK * 100 - (CS - t0) ))
        if [ "$rem" -gt 0 ]; then
            printf -v s '%d.%02d' $((rem / 100)) $((rem % 100))
            nap "$s"
        fi
    else
        nap 1
    fi
}

# =============================================================================
# LIFECYCLE
# =============================================================================

cleanup() {
    [ -n "$TMPD" ] && rm -rf "$TMPD"
    rm -f "$CHECKING_FILE"
    [ -z "$ONESHOT" ] && rm -f "$PID_FILE"
}

on_term() {
    local p
    for p in $(jobs -p); do kill "$p" 2>/dev/null; done
    if [ "$(date +%s)" -ge "$SANE_EPOCH" ]; then
        flush_rollups 99999999999
    fi
    exit 0
}

# Sleep without delaying a trapped signal.
nap() {
    sleep "$1" </dev/null &
    wait $!
}

main() {
    local last_end next_mono now_mono

    if [ -z "$ONESHOT" ]; then
        # A pid file we do not own is untrusted: never let it block startup.
        own_or_rm "$PID_FILE"
        if [ -f "$PID_FILE" ]; then
            old_pid=$(cat "$PID_FILE" 2>/dev/null)
            if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
                qlog_error "Another sites daemon already running (PID $old_pid), exiting"
                exit 1
            fi
            rm -f "$PID_FILE"
        fi
        echo $$ | atomic_put "$PID_FILE"
    fi
    trap cleanup EXIT
    trap on_term INT TERM
    rm -f "$CHECKING_FILE"
    own_or_rm "$RAW_FILE"; own_or_rm "$FLUSHED_FILE"; own_or_rm "$LATEST_FILE"
    own_or_rm "$LIVE_FILE"
    load_flushed

    qlog_info "QManager Sites daemon starting (PID $$)"

    if [ -z "$ONESHOT" ]; then
        while [ "$(mono_now)" -lt "$BOOT_SETTLE" ]; do nap 5; done
    fi

    while :; do
        if ! load_config; then
            [ -n "$ONESHOT" ] && { qlog_error "jq unavailable"; exit 1; }
            nap 15
            continue
        fi
        if [ "$cfg_enabled" = "false" ] && [ -z "$ONESHOT" ]; then
            nap 30
            continue
        fi

        [ -e "$NOW_FLAG" ] && rm -f "$NOW_FLAG"
        sweep
        last_end=$(mono_now)

        if [ -n "$ONESHOT" ]; then
            [ "$(date +%s)" -ge "$SANE_EPOCH" ] && flush_rollups 99999999999
            exit 0
        fi

        next_mono=$(( last_end + cfg_interval ))
        while :; do
            now_mono=$(mono_now)
            [ "$now_mono" -ge "$next_mono" ] && break
            if [ -e "$NOW_FLAG" ] && [ $(( now_mono - last_end )) -ge "$MIN_FLAG_GAP" ]; then
                break
            fi
            if live_fresh; then
                if [ "$live_on" != "true" ]; then
                    live_on="true"; qlog_info "sites: live mode on"
                fi
                live_tick
            else
                if [ "$live_on" = "true" ]; then
                    live_on="false"; qlog_info "sites: live mode off"
                fi
                nap "$POLL"
            fi
        done
    done
}

main "$@"
