du_modem_reset_count=0

# Counter orientation. Set once at startup by main() via
# detect_orientation_from_soc; persisted into data_used.json for
# diagnostics but always re-derived from the SoC each startup (the SoC
# does not change at runtime).
orientation="normal"                  # normal|reversed
orientation_dl_field=2                # /proc/net/dev field carrying download bytes
orientation_ul_field=10               # /proc/net/dev field carrying upload bytes

# Connectivity (from ping daemon)
conn_internet_available="null"
conn_status="unknown"
conn_latency="null"
conn_avg_latency="null"
conn_min_latency="null"
conn_max_latency="null"
conn_jitter="null"
conn_packet_loss="null"
conn_ping_target=""
conn_history="[]"
conn_history_interval=5
conn_history_size=60
conn_during_recovery="false"
# Phase 2 — runtime profile + last-probed address family (from ping daemon)
conn_profile="unknown"
conn_last_family="null"
_last_ping_ts=0          # tracks last processed ping.json timestamp (awk gate)
_ping_stale_since=0      # epoch when ping daemon first went stale (0 = healthy)

# History size constant (must match ping daemon)
CONN_HISTORY_SIZE=60

# Minimum samples before the RATIO statistics (packet loss, jitter) mean
# anything. Below this the poller emits a real JSON null for both.
#
# 10 is not arbitrary: the smallest loss threshold any consumer compares
# against is this file's own `>= 10` degraded gate (the UI presets are 15/30/
# 50). A window of n samples can only express loss in steps of 100/n percent,
# so n=10 is exactly the point at which a 10% reading becomes representable
# at all. At n=9 the quantum is 11.1% -- every window is either "0%" or an
# instant threshold breach, and the "0%" is the dangerous half: it is
# indistinguishable from a measured perfect link.
#
# This matters because qmanager_ping TRUNCATES /tmp/qmanager_ping_history on
# every probe-winner change, which on a lossy link happens repeatedly, so a
# 1-sample window is a recurring state and not a once-per-boot transient.
MIN_STAT_SAMPLES=10

# Connection uptime tracking
conn_uptime_seconds=0
conn_start_time=0

# System metrics
cpu_usage=0
memory_used_mb=0
memory_total_mb=0
uptime_seconds=0

# System health (modem subsystem + cpu/storage telemetry consumed by the
# System Health card and any other UI that wants near-realtime device stats).
# Populated by update_system_health(); read directly from sysfs/cpufreq/df.
sh_state="unknown"
