#!/bin/sh
# qmanager_ping: the one source of internet reachability and latency (ICMP only).
# Design and output contract: docs/reference/connection-quality.md.

if [ -f /usr/lib/qmanager/qlog.sh ]; then
    . /usr/lib/qmanager/qlog.sh
else
    qlog_init() { :; }
    qlog_debug() { :; }
    qlog_info() { :; }
    qlog_warn() { :; }
    qlog_error() { :; }
    qlog_state_change() { :; }
fi
qlog_init "ping"

[ -f /usr/lib/qmanager/platform.sh ] && . /usr/lib/qmanager/platform.sh
if ! command -v qm_timeout >/dev/null 2>&1; then
    qlog_error "platform.sh missing - hostname legs run unbounded (broken install)"
    qm_timeout() {
        shift
        "$@"
    }
fi

# --- Configuration (fallbacks; load_config re-reads the JSON) ---------------
PING_PROFILE="${PING_PROFILE:-relaxed}"
DEFAULT_HOST_1="cloudflare.com"
DEFAULT_HOST_2="google.com"
DEFAULT_IP_1="1.1.1.1"
DEFAULT_IP_2="8.8.8.8"
PING_TARGET_HOST_1="$DEFAULT_HOST_1"
PING_TARGET_HOST_2="$DEFAULT_HOST_2"
PING_TARGET_IP_1="$DEFAULT_IP_1"
PING_TARGET_IP_2="$DEFAULT_IP_2"
PING_INTERVAL="${PING_INTERVAL:-5}"
FAIL_SECS=30
RECOVER_SECS=10
HISTORY_SIZE="${HISTORY_SIZE:-60}"
PROBE_WAIT=2               # ping -W: wait for the reply (s)
PROBE_DEADLINE=3           # ping -w: hard deadline per leg (s)
HOST_DEADLINE=4            # qm_timeout for hostname legs: -w does not bound the lookup
SLEEP_FLOOR_CS=20          # never sleep less than 0.2 s between cycles

CONFIG_FILE="${CONFIG_FILE:-/etc/qmanager/ping_profile.json}"
CACHE_FILE="/tmp/qmanager_ping.json"
CACHE_TMP="/tmp/qmanager_ping.json.tmp"
HISTORY_FILE="/tmp/qmanager_ping_history"
RECOVERY_FLAG="/tmp/qmanager_recovery_active"
RELOAD_FLAG="/tmp/qmanager_ping_reload"
PID_FILE="/tmp/qmanager_ping.pid"
FAN_PREFIX="/tmp/qmanager_ping_fan"   # mktemp -d "$FAN_PREFIX.XXXXXX", root 0700

# --- State --------------------------------------------------------------------
streak_success=0           # per-cycle counts: the watchcat's contract
streak_fail=0
reachable="true"
last_family="none"
last_target=""
last_leg="-"               # h1 | h2 | i1 | i2 | -
fail_elapsed_sec=0
cycle_ms=0
history_count=0
FAN_DIR=""
_fan_pids=""
_fail_since=""             # centiseconds at the start of the current failure run
_ok_since=""
_clk_last=0
_cfg_pending=0             # 1 = jq was not mounted yet at the last load
_sleep_frac=1

# Sets _CS to /proc/uptime in centiseconds without a fork; rc 1 when unreadable.
_uptime_cs() {
    _CS=0
    _u_up=""
    { read -r _u_up _u_idle < /proc/uptime; } 2>/dev/null
    _u_int="${_u_up%%.*}"
    case "$_u_int" in ''|*[!0-9]*) return 1 ;; esac
    case "$_u_up" in
        *.*) _u_frac="${_u_up#*.}" ;;
        *) _u_frac=0 ;;
    esac
    case "$_u_frac" in ???*) _u_frac="${_u_frac%"${_u_frac#??}"}" ;; esac
    case "$_u_frac" in ''|*[!0-9]*) _u_frac=0 ;; esac
    case "$_u_frac" in ?) _u_frac="${_u_frac}0" ;; esac
    # Leading zeros read as octal in $(( )).
    while :; do
        case "$_u_frac" in 0?*) _u_frac="${_u_frac#0}" ;; *) break ;; esac
    done
    while :; do
        case "$_u_int" in 0?*) _u_int="${_u_int#0}" ;; *) break ;; esac
    done
    _CS=$(( _u_int * 100 + _u_frac ))
}

# _CS = monotonic centiseconds; if /proc/uptime is unreadable it advances one interval per call.
_clock() {
    if _uptime_cs; then
        _clk_last="$_CS"
        return 0
    fi
    _clk_last=$(( _clk_last + PING_INTERVAL * 100 ))
    _CS="$_clk_last"
}

ceil_div_min1() {
    _n=$(( ($1 + $2 - 1) / $2 ))
    [ "$_n" -lt 1 ] && _n=1
    echo "$_n"
}

# Profile table (interval/fail/recover/history s); conn_state_cadence mirrors it.
resolve_profile() {
    case "$PING_PROFILE" in
        sensitive) _interval=1;  _fail_secs=15; _recover_secs=3;  _history_secs=300 ;;
        regular)   _interval=2;  _fail_secs=20; _recover_secs=6;  _history_secs=300 ;;
        quiet)     _interval=10; _fail_secs=60; _recover_secs=20; _history_secs=600 ;;
        *)
            PING_PROFILE="relaxed"
            _interval=5;  _fail_secs=30; _recover_secs=10; _history_secs=300
            ;;
    esac
    [ -n "$JSON_INTERVAL_SEC" ] && _interval="$JSON_INTERVAL_SEC"
    [ -n "$JSON_FAIL_SECS" ] && _fail_secs="$JSON_FAIL_SECS"
    [ -n "$JSON_RECOVER_SECS" ] && _recover_secs="$JSON_RECOVER_SECS"
    [ -n "$JSON_HISTORY_SECS" ] && _history_secs="$JSON_HISTORY_SECS"
    [ "$_interval" -gt 0 ] 2>/dev/null || _interval=1

    PING_INTERVAL="$_interval"
    FAIL_SECS="$_fail_secs"
    RECOVER_SECS="$_recover_secs"
    HISTORY_SIZE=$(ceil_div_min1 "$_history_secs" "$_interval")
}

# Target charsets (the CGI's rules), plus no leading '-' so a value is never a ping option.
_host_ok() {
    case "$1" in ''|-*|*[!0-9A-Za-z.-]*) return 1 ;; esac
    [ "${#1}" -le 253 ]
}
_ip4_ok() {
    case "$1" in ''|-*|*[!0-9.]*) return 1 ;; esac
    [ "${#1}" -le 15 ]
}

# _pick <kind> <value> <default> <key>: _PV = value when valid, else the default.
_pick() {
    _PV="$3"
    [ -n "$2" ] && [ "$2" != "-" ] || return 0
    if "_$1_ok" "$2"; then
        _PV="$2"
    else
        qlog_warn "$4 rejected (bad charset or length), using $3"
    fi
}

# _IV = $1 as a decimal integer without leading zeros ("08" is octal in $(( ))), "" when not one.
_int() {
    _IV="$1"
    case "$_IV" in ''|*[!0-9]*) _IV=""; return 0 ;; esac
    [ "${#_IV}" -le 6 ] || { _IV=""; return 0; }
    while :; do
        case "$_IV" in 0?*) _IV="${_IV#0}" ;; *) break ;; esac
    done
}

# One jq read of the config; each target slot defaults independently.
load_config() {
    _row=""
    JSON_INTERVAL_SEC=""
    JSON_FAIL_SECS=""
    JSON_RECOVER_SECS=""
    JSON_HISTORY_SECS=""
    _cfg_pending=0
    if [ -f "$CONFIG_FILE" ]; then
        if command -v jq >/dev/null 2>&1; then
            _row=$(jq -r 'def s: if . == null or . == "" then "-" else tostring end;
                [(.profile|s), (.target_host_1|s), (.target_host_2|s), (.target_ip_1|s),
                 (.target_ip_2|s), (.interval_sec|s), (.fail_secs|s), (.recover_secs|s),
                 (.history_secs|s)] | @tsv' "$CONFIG_FILE" 2>/dev/null </dev/null)
        else
            # /usr/bin/jq points into /opt, which mounts ~30 s into boot.
            _cfg_pending=1
        fi
    fi
    _profile="-"; _h1="-"; _h2="-"; _i1="-"; _i2="-"
    if [ -n "$_row" ]; then
        IFS="$(printf '\t')" read -r _profile _h1 _h2 _i1 _i2 JSON_INTERVAL_SEC \
            JSON_FAIL_SECS JSON_RECOVER_SECS JSON_HISTORY_SECS <<EOF
$_row
EOF
    fi
    [ -n "$_profile" ] && [ "$_profile" != "-" ] && PING_PROFILE="$_profile"

    _pick host "$_h1" "$DEFAULT_HOST_1" target_host_1; PING_TARGET_HOST_1="$_PV"
    _pick host "$_h2" "$DEFAULT_HOST_2" target_host_2; PING_TARGET_HOST_2="$_PV"
    _pick ip4 "$_i1" "$DEFAULT_IP_1" target_ip_1; PING_TARGET_IP_1="$_PV"
    _pick ip4 "$_i2" "$DEFAULT_IP_2" target_ip_2; PING_TARGET_IP_2="$_PV"

    _int "$JSON_INTERVAL_SEC"; JSON_INTERVAL_SEC="$_IV"
    _int "$JSON_FAIL_SECS"; JSON_FAIL_SECS="$_IV"
    _int "$JSON_RECOVER_SECS"; JSON_RECOVER_SECS="$_IV"
    _int "$JSON_HISTORY_SECS"; JSON_HISTORY_SECS="$_IV"

    resolve_profile
}

# parse_rtt <ping output>: _RTT = average RTT to one decimal (summary line, else
# the first time=); rc 1 when nothing numeric > 0 is found (100% loss included).
parse_rtt() {
    _RTT=""
    case "$1" in
        *"min/avg/max"*"= "*)
            _pr="${1#*min/avg/max}"
            _pr="${_pr#*= }"
            _pr="${_pr#*/}"
            _pr="${_pr%%/*}"
            ;;
        *"time="*)
            _pr="${1#*time=}"
            _pr="${_pr%% *}"
            ;;
        *) return 1 ;;
    esac
    case "$_pr" in ''|.*|*[!0-9.]*|*.*.*) return 1 ;; esac
    _pi="${_pr%%.*}"
    case "$_pr" in
        *.*) _pf="${_pr#*.}00" ;;
        *) _pf="00" ;;
    esac
    _pf="${_pf%"${_pf#??}"}"
    while :; do
        case "$_pi" in 0?*) _pi="${_pi#0}" ;; *) break ;; esac
    done
    [ "${#_pi}" -le 6 ] || return 1
    # "1$_pf - 100" keeps a leading-zero fraction out of octal.
    _pt=$(( _pi * 100 + 1$_pf - 100 ))
    _pt=$(( (_pt + 5) / 10 ))
    [ "$_pt" -gt 0 ] || return 1
    _RTT="$(( _pt / 10 )).$(( _pt % 10 ))"
}

# probe_leg <target>: _RTT and _FAM (family of the address that answered) on success.
probe_leg() {
    _FAM="ipv4"
    case "$1" in
        *[!0-9.]*)
            _pl_out=$(qm_timeout "$HOST_DEADLINE" ping -c 1 -W "$PROBE_WAIT" -w "$PROBE_DEADLINE" "$1" 2>/dev/null </dev/null)
            # Banner "PING <name> (<addr>) ...": the resolver chose the family.
            _pl_addr="${_pl_out#*(}"
            _pl_addr="${_pl_addr%%)*}"
            case "$_pl_addr" in *:*) _FAM="ipv6" ;; esac
            ;;
        *)
            _pl_out=$(ping -c 1 -W "$PROBE_WAIT" -w "$PROBE_DEADLINE" "$1" 2>/dev/null </dev/null)
            ;;
    esac
    parse_rtt "$_pl_out"
}

# Background body of one fan-out leg: writes "<rtt> <family>" to its file on success.
leg_job() { # target file
    # Inherited traps would remove the daemon's PID file when this job exits.
    trap - EXIT INT TERM
    if probe_leg "$1"; then
        printf '%s %s\n' "$_RTT" "$_FAM" > "$2"
    fi
    exit 0
}

# A killed leg leaves its ping running until the leg deadline (<= 4 s); systemctl stop kills the whole cgroup.
_fan_kill() {
    # shellcheck disable=SC2086
    [ -n "$_fan_pids" ] && kill $_fan_pids 2>/dev/null
    _fan_pids=""
}

_fan_dir_ok() {
    [ -n "$FAN_DIR" ] && [ -d "$FAN_DIR" ] && return 0
    FAN_DIR=$(mktemp -d "${FAN_PREFIX}.XXXXXX" 2>/dev/null) || FAN_DIR=""
    [ -n "$FAN_DIR" ]
}

# _fan_take <leg> <target>: rc 0 and the result globals set when that leg answered.
_fan_take() {
    _fr_rtt=""
    _fr_fam=""
    { read -r _fr_rtt _fr_fam < "$FAN_DIR/$1"; } 2>/dev/null
    case "$_fr_rtt" in ''|*[!0-9.]*) return 1 ;; esac
    case "$_fr_fam" in ipv6) ;; *) _fr_fam="ipv4" ;; esac
    PROBE_RTT="$_fr_rtt"; last_family="$_fr_fam"; last_target="$2"; last_leg="$1"
}

_take() { # leg target
    PROBE_RTT="$_RTT"; last_family="$_FAM"; last_target="$2"; last_leg="$1"
}

# One cycle: sets PROBE_RTT, last_family, last_target, last_leg; rc 0 when a leg answered.
PROBE_RTT=""
probe_cycle() {
    if probe_leg "$PING_TARGET_HOST_1"; then
        _take h1 "$PING_TARGET_HOST_1"
        return 0
    fi

    if _fan_dir_ok; then
        rm -f "$FAN_DIR/h2" "$FAN_DIR/i1" "$FAN_DIR/i2" 2>/dev/null
        leg_job "$PING_TARGET_HOST_2" "$FAN_DIR/h2" </dev/null >/dev/null 2>&1 &
        _fan_pids="$!"
        leg_job "$PING_TARGET_IP_1" "$FAN_DIR/i1" </dev/null >/dev/null 2>&1 &
        _fan_pids="$_fan_pids $!"
        leg_job "$PING_TARGET_IP_2" "$FAN_DIR/i2" </dev/null >/dev/null 2>&1 &
        _fan_pids="$_fan_pids $!"
        # shellcheck disable=SC2086
        wait $_fan_pids
        _fan_pids=""
        _fan_take h2 "$PING_TARGET_HOST_2" && return 0
        _fan_take i1 "$PING_TARGET_IP_1" && return 0
        _fan_take i2 "$PING_TARGET_IP_2" && return 0
    else
        # No scratch dir: the legs run one after another.
        if probe_leg "$PING_TARGET_HOST_2"; then _take h2 "$PING_TARGET_HOST_2"; return 0; fi
        if probe_leg "$PING_TARGET_IP_1"; then _take i1 "$PING_TARGET_IP_1"; return 0; fi
        if probe_leg "$PING_TARGET_IP_2"; then _take i2 "$PING_TARGET_IP_2"; return 0; fi
    fi

    PROBE_RTT=""
    last_family="none"
    last_target=""
    last_leg="-"
    return 1
}

# _JS = $1 with \ and " escaped (targets are charset-checked; this guards the profile name).
_json_str() {
    _js_in="$1"
    _JS=""
    while :; do
        case "$_js_in" in
            *[\\\"]*)
                _js_pre=${_js_in%%[\\\"]*}
                _js_in=${_js_in#"$_js_pre"}
                _js_c=${_js_in%"${_js_in#?}"}
                _js_in=${_js_in#?}
                _JS="${_JS}${_js_pre}\\${_js_c}"
                ;;
            *)
                _JS="${_JS}${_js_in}"
                break
                ;;
        esac
    done
}

# Atomic cache write; a failed write keeps the previous file.
write_cache() {
    rtt="$1"
    timestamp=$(date +%s)
    case "$timestamp" in ''|*[!0-9]*) timestamp=0 ;; esac
    _uptime_cs
    mono=$(( _CS / 100 ))
    during_recovery="false"
    [ -f "$RECOVERY_FLAG" ] && during_recovery="true"
    case "$rtt" in ''|*[!0-9.]*) rtt="null" ;; esac
    _json_str "$PING_PROFILE"

    if printf '{"timestamp":%s,"mono":%s,"profile":"%s","targets":["%s","%s","%s","%s"],"interval_sec":%s,"last_rtt_ms":%s,"reachable":%s,"streak_success":%s,"streak_fail":%s,"during_recovery":%s,"last_family":"%s","last_target":"%s","fail_elapsed_sec":%s,"cycle_ms":%s}\n' \
            "$timestamp" "$mono" "$_JS" \
            "$PING_TARGET_HOST_1" "$PING_TARGET_HOST_2" "$PING_TARGET_IP_1" "$PING_TARGET_IP_2" \
            "$PING_INTERVAL" "$rtt" "$reachable" "$streak_success" "$streak_fail" \
            "$during_recovery" "$last_family" "$last_target" "$fail_elapsed_sec" "$cycle_ms" \
            > "$CACHE_TMP" 2>/dev/null \
        && [ -s "$CACHE_TMP" ] \
        && mv -f "$CACHE_TMP" "$CACHE_FILE" 2>/dev/null; then
        _wc_warned=0
        return 0
    fi
    rm -f "$CACHE_TMP" 2>/dev/null
    if [ "${_wc_warned:-0}" = "0" ]; then
        qlog_warn "ping cache write failed, keeping previous file"
        _wc_warned=1
    fi
}

# =============================================================================
# DNS lookup latency (detached job, so the probe loop's budget never grows)
# =============================================================================
DNS_NAME="one.one.one.one"
DNS_FILE="${DNS_FILE:-/tmp/qmanager_dns.json}"
RESOLV_CONF="${RESOLV_CONF:-/etc/resolv.conf}"
DNS_INTERVAL=60
DNS_MIN_GAP=10             # floor between lookups when an outage edge forces one
DNS_LOOKUP_TIMEOUT=5
DNS_JOB_MAX=15             # a job older than this is presumed gone (pid-reuse guard)
_dns_pid=""
_dns_started=""
_dns_force=0
_dns_prev_reach=""
_dm=0

dns_job() {
    trap - EXIT INT TERM
    _res=$(awk '$1 == "nameserver" { print $2; exit }' "$RESOLV_CONF" 2>/dev/null)
    case "$_res" in *[!0-9A-Za-z:.%_-]*) _res="" ;; esac
    _ms="null"
    _ok="false"
    if [ -n "$_res" ]; then
        _out=$(mktemp /tmp/qmanager_dns_out.XXXXXX 2>/dev/null)
        if [ -n "$_out" ]; then
            _uptime_cs; _t0="$_CS"
            qm_timeout "$DNS_LOOKUP_TIMEOUT" nslookup "$DNS_NAME" "$_res" >"$_out" 2>&1 </dev/null
            _rc=$?
            _uptime_cs; _t1="$_CS"
            # Success = exit 0 and an Address line after a Name line (the server header has one too).
            if [ "$_rc" -eq 0 ] && awk '/^Name:/ { n = 1; next } n && /^Address/ { f = 1 } END { exit !f }' "$_out"; then
                _ok="true"
                _ms=$(( (_t1 - _t0) * 10 ))
                [ "$_ms" -lt 10 ] && _ms=10
            fi
            rm -f "$_out"
        fi
    fi

    _uptime_cs
    _tmp=$(mktemp "${DNS_FILE}.XXXXXX" 2>/dev/null) || exit 0
    if jq -n --argjson ms "$_ms" --argjson ok "$_ok" --arg res "$_res" --arg name "$DNS_NAME" \
            --argjson mono "$((_CS / 100))" --argjson ts "$(date +%s)" \
            '{ms: $ms, ok: $ok, resolver: $res, name: $name, mono: $mono, ts: $ts}' > "$_tmp" 2>/dev/null \
        && chmod 644 "$_tmp" && mv "$_tmp" "$DNS_FILE"; then
        :
    else
        rm -f "$_tmp"
    fi
    exit 0
}

# True while the last spawned job runs; a reaped, zombie or too-old pid is free.
_dns_busy() {
    [ -n "$_dns_pid" ] || return 1
    _dl=""
    { read -r _dl < "/proc/$_dns_pid/stat"; } 2>/dev/null
    case "$_dl" in
        ''|*") Z "*) _dns_pid=""; return 1 ;;
    esac
    if [ $((_dm - _dns_started)) -ge "$DNS_JOB_MAX" ]; then
        _dns_pid=""
        return 1
    fi
    return 0
}

dns_probe_maybe() {
    _uptime_cs || return 0
    _dm=$((_CS / 100))
    # A true -> false edge forces a fresh lookup so an outage never shows an old good number.
    if [ "$_dns_prev_reach" = "true" ] && [ "$reachable" = "false" ]; then
        _dns_force=1
    fi
    _dns_prev_reach="$reachable"

    _due=0
    if [ -z "$_dns_started" ]; then
        _due=1
    elif [ "$_dns_force" -eq 1 ]; then
        [ $((_dm - _dns_started)) -ge "$DNS_MIN_GAP" ] && _due=1
    elif [ $((_dm - _dns_started)) -ge "$DNS_INTERVAL" ]; then
        _due=1
    fi
    [ "$_due" -eq 1 ] || return 0
    _dns_busy && return 0

    _dns_started="$_dm"
    _dns_force=0
    dns_job </dev/null >/dev/null 2>&1 &
    _dns_pid=$!
    return 0
}

# =============================================================================
# Main loop
# =============================================================================

_sleep_cs() {
    if [ "$_sleep_frac" = "1" ]; then
        _cs_frac=$(( $1 % 100 ))
        [ "$_cs_frac" -lt 10 ] && _cs_frac="0$_cs_frac"
        sleep "$(( $1 / 100 )).$_cs_frac"
    else
        _s=$(( ($1 + 50) / 100 ))
        [ "$_s" -lt 1 ] && _s=1
        sleep "$_s"
    fi
}

# Fixed-rate sleep: what is left of the interval, floored at SLEEP_FLOOR_CS. BusyBox's
# builtin sleep returns early when a background job exits, so it resumes (at most 3 times).
_cycle_sleep() { # cycle start (cs)
    _clock
    _cs_left=$(( PING_INTERVAL * 100 - (_CS - $1) ))
    [ "$_cs_left" -lt "$SLEEP_FLOOR_CS" ] && _cs_left="$SLEEP_FLOOR_CS"
    _sl_end=$(( _CS + _cs_left ))
    _sl_n=0
    while [ "$_sl_n" -lt 4 ] && [ "$_cs_left" -ge 5 ]; do
        _sleep_cs "$_cs_left"
        _sl_n=$(( _sl_n + 1 ))
        _clock
        _cs_left=$(( _sl_end - _CS ))
    done
}

_cleanup() {
    _fan_kill
    rm -f "$PID_FILE" "$CACHE_TMP" 2>/dev/null
    [ -n "$FAN_DIR" ] && rm -rf "$FAN_DIR" 2>/dev/null
}

main() {
    if [ -f "$PID_FILE" ]; then
        old_pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
            qlog_error "Another ping daemon already running (PID $old_pid), exiting"
            exit 1
        fi
        rm -f "$PID_FILE"
    fi
    echo $$ > "$PID_FILE"

    # ash runs an INT/TERM handler but does not exit afterwards: hence the explicit exit.
    trap '_cleanup' EXIT
    trap '_cleanup; exit 0' INT TERM

    load_config
    sleep 0.01 2>/dev/null || _sleep_frac=0

    qlog_info "========================================"
    qlog_info "QManager Ping Daemon starting (PID $$)"
    qlog_info "Profile: ${PING_PROFILE}, interval ${PING_INTERVAL}s, fail ${FAIL_SECS}s, recover ${RECOVER_SECS}s, history ${HISTORY_SIZE}"
    qlog_info "Legs: h1=${PING_TARGET_HOST_1}, then in parallel h2=${PING_TARGET_HOST_2} i1=${PING_TARGET_IP_1} i2=${PING_TARGET_IP_2}"
    [ "$_cfg_pending" = "1" ] && qlog_info "jq not mounted yet, using defaults until it is"
    qlog_info "========================================"

    rm -f "$CACHE_TMP" /tmp/qmanager_dns_out.* "${DNS_FILE}".??????
    rm -rf "${FAN_PREFIX}".?????? 2>/dev/null
    : > "$HISTORY_FILE"
    history_count=0
    _clock
    _cyc_prev=""

    while true; do
        if [ -f "$RELOAD_FLAG" ] || { [ "$_cfg_pending" = "1" ] && command -v jq >/dev/null 2>&1; }; then
            load_config
            rm -f "$RELOAD_FLAG"
            qlog_info "Loaded config: profile=${PING_PROFILE} interval=${PING_INTERVAL}s fail=${FAIL_SECS}s recover=${RECOVER_SECS}s legs=${PING_TARGET_HOST_1},${PING_TARGET_HOST_2},${PING_TARGET_IP_1},${PING_TARGET_IP_2}"
        fi

        _clock
        _cyc_start="$_CS"
        if [ -n "$_cyc_prev" ]; then
            cycle_ms=$(( (_cyc_start - _cyc_prev) * 10 ))
        else
            cycle_ms=$(( PING_INTERVAL * 1000 ))
        fi
        _cyc_prev="$_cyc_start"

        if probe_cycle; then
            rtt="$PROBE_RTT"
        else
            rtt=""
        fi
        _clock
        _probe_end="$_CS"

        if [ -n "$rtt" ]; then
            streak_success=$((streak_success + 1))
            streak_fail=0
            _fail_since=""
            fail_elapsed_sec=0
            [ -z "$_ok_since" ] && _ok_since="$_cyc_start"
            _el=$(( _probe_end - _ok_since ))
            qlog_debug "PING OK: leg=${last_leg} target=${last_target} family=${last_family} rtt=${rtt}ms (streak_success=${streak_success})"
            if [ "$reachable" = "false" ] && [ "$_el" -ge $(( RECOVER_SECS * 100 )) ]; then
                reachable="true"
                qlog_state_change "reachable" "false" "true"
            fi
            echo "$rtt $last_leg" >> "$HISTORY_FILE"
        else
            rtt="null"
            streak_fail=$((streak_fail + 1))
            streak_success=0
            _ok_since=""
            [ -z "$_fail_since" ] && _fail_since="$_cyc_start"
            _el=$(( _probe_end - _fail_since ))
            [ "$_el" -lt 0 ] && _el=0
            fail_elapsed_sec=$(( _el / 100 ))
            qlog_debug "PING FAIL: no leg answered (streak_fail=${streak_fail}, fail_elapsed_sec=${fail_elapsed_sec})"
            if [ "$reachable" = "true" ] && [ "$_el" -ge $(( FAIL_SECS * 100 )) ]; then
                reachable="false"
                qlog_state_change "reachable" "true" "false"
                qlog_warn "Internet unreachable after ${fail_elapsed_sec}s of continuous failure (${streak_fail} probes)"
            fi
            echo "null -" >> "$HISTORY_FILE"
        fi

        history_count=$((history_count + 1))
        if [ "$history_count" -gt "$HISTORY_SIZE" ]; then
            tail -n "$HISTORY_SIZE" "$HISTORY_FILE" > "${HISTORY_FILE}.tmp"
            mv "${HISTORY_FILE}.tmp" "$HISTORY_FILE"
            history_count=$HISTORY_SIZE
        fi

        write_cache "$rtt"
        dns_probe_maybe
        _cycle_sleep "$_cyc_start"
    done
}

# QM_PING_NO_MAIN=1 defines everything without running (for sourcing in checks).
[ "${QM_PING_NO_MAIN:-0}" = "1" ] || main "$@"
