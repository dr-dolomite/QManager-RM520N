#!/bin/sh
# qmanager_firewall — Port firewall for QManager web UI and SSH (chain-based)
#
# Restricts HTTP/HTTPS access to trusted interfaces only, and blocks SSH on
# the cellular WAN (rmnet+). All rules live in a dedicated user chain
# (QMANAGER_FW) hooked into INPUT for both IPv4 and IPv6, so start/stop is
# atomic and cannot leak rules across upgrades. Replaces SimpleAdmin's
# simplefirewall as a QManager-managed service.
#
# Usage: qmanager_firewall {start|stop|restart|reload}
#
# Web UI (80, 443 + custom web ports): allowed on lo, bridge0, eth0, tailscale0 (if installed);
#   dropped everywhere else (IPv4). Dropped on rmnet+ (IPv6 — lighttpd binds
#   IPv4 only today; this is defence in depth).
# SSH (22): dropped on rmnet+ only, IPv4 and IPv6. Every other interface keeps
#   SSH so an unknown LAN-side interface (QCMAP VLAN bridge, ppp0) never loses
#   the emergency path.
#
# start/reload build the new rules in a staging chain and swap the INPUT jump,
# so re-applying never opens a window with no rules. A partial chain is never
# renamed into place; the build is retried, and a final failure exits non-zero
# so systemd marks the unit failed.
#
# Every call waits up to 5s for the xtables lock (-w 5): QCMAP adds its own
# INPUT rules when the data call comes up at boot, and iptables 1.6 without -w
# fails at once on a held lock.
#
# Service: qmanager-firewall.service (Type=oneshot, RemainAfterExit=yes)

PATH=/usr/sbin:/usr/bin:/sbin:/bin

# Web ports: 80/443 always, plus the configured and in-change pairs from the port file.
PORTS="80 443"
if [ -f /usr/lib/qmanager/web_port.sh ] && . /usr/lib/qmanager/web_port.sh; then
    PORTS=$(wp_fw_ports)
fi
SSH_PORT="22"
WAN_IFACE="rmnet+"
TRUSTED="lo bridge0 eth0"

if [ -x /usrdata/tailscale/tailscale ]; then
    TRUSTED="$TRUSTED tailscale0"
fi

CHAIN="QMANAGER_FW"
STAGE="QMANAGER_FW_NEW"
W="-w 5"
ATTEMPTS=3

have_ip6() {
    command -v ip6tables >/dev/null 2>&1
}

log() {
    echo "qmanager_firewall: $*" >&2
    logger -t qmanager_firewall "$*" 2>/dev/null || true
}

# $1 = iptables | ip6tables, $2 = chain
unhook_chain() {
    while "$1" $W -C INPUT -j "$2" 2>/dev/null; do
        "$1" $W -D INPUT -j "$2" 2>/dev/null || break
    done
}

drop_chain() {
    "$1" $W -F "$2" 2>/dev/null || true
    "$1" $W -X "$2" 2>/dev/null || true
}

# Drain INPUT-direct rules from the pre-chain implementation.
# Loops per rule because -D removes only one match per call.
cleanup_legacy_input_rules() {
    iface=""
    port=""
    for iface in lo bridge0 eth0 tailscale0 rmnet_data0; do
        for port in $PORTS; do
            while iptables $W -C INPUT -i "$iface" -p tcp --dport "$port" -j ACCEPT 2>/dev/null; do
                iptables $W -D INPUT -i "$iface" -p tcp --dport "$port" -j ACCEPT 2>/dev/null || break
            done
            while iptables $W -C INPUT -i "$iface" -p tcp --dport "$port" -j DROP 2>/dev/null; do
                iptables $W -D INPUT -i "$iface" -p tcp --dport "$port" -j DROP 2>/dev/null || break
            done
        done
    done
    for port in $PORTS; do
        while iptables $W -C INPUT -p tcp --dport "$port" -j DROP 2>/dev/null; do
            iptables $W -D INPUT -p tcp --dport "$port" -j DROP 2>/dev/null || break
        done
    done
}

# Every prefix of this order is safe: WAN drops first, then the trusted
# ACCEPTs, the catch-all DROPs last, so LAN HTTPS is never dropped early.
fill_v4() {
    for port in $SSH_PORT $PORTS; do
        iptables $W -A "$1" -i "$WAN_IFACE" -p tcp --dport "$port" -j DROP || return 1
    done
    for iface in $TRUSTED; do
        for port in $PORTS; do
            iptables $W -A "$1" -i "$iface" -p tcp --dport "$port" -j ACCEPT || return 1
        done
    done
    for port in $PORTS; do
        iptables $W -A "$1" -p tcp --dport "$port" -j DROP || return 1
    done
}

fill_v6() {
    for port in $SSH_PORT $PORTS; do
        ip6tables $W -A "$1" -i "$WAN_IFACE" -p tcp --dport "$port" -j DROP || return 1
    done
}

# $1 = iptables | ip6tables, $2 = fill function. Build in STAGE, hook it at
# INPUT 1, then retire the old chain and rename STAGE into its place. A STAGE
# left hooked by an interrupted run is unhooked first, or -X/-N would fail.
# A failed build keeps a hooked old chain and drops STAGE; with none hooked the
# partial STAGE stays hooked (safe prefix). A partial is never renamed.
swap_in() {
    unhook_chain "$1" "$STAGE"
    drop_chain "$1" "$STAGE"
    "$1" $W -N "$STAGE" || return 1
    if ! "$2" "$STAGE" || ! "$1" $W -I INPUT 1 -j "$STAGE"; then
        if "$1" $W -C INPUT -j "$CHAIN" 2>/dev/null; then
            unhook_chain "$1" "$STAGE"
            drop_chain "$1" "$STAGE"
        else
            "$1" $W -C INPUT -j "$STAGE" 2>/dev/null ||
                "$1" $W -I INPUT 1 -j "$STAGE"
        fi
        return 1
    fi
    unhook_chain "$1" "$CHAIN"
    drop_chain "$1" "$CHAIN"
    "$1" $W -E "$STAGE" "$CHAIN" && return 0
    # STAGE is complete and hooked: retry only the rename, never rebuild it.
    sleep 1
    unhook_chain "$1" "$CHAIN"
    drop_chain "$1" "$CHAIN"
    "$1" $W -E "$STAGE" "$CHAIN" && return 0
    return 2
}

# $1 = iptables | ip6tables, $2 = fill function
swap_in_retry() {
    n=1
    while :; do
        swap_in "$1" "$2"
        src=$?
        [ "$src" -eq 0 ] && return 0
        if [ "$src" -eq 2 ] || [ "$n" -ge "$ATTEMPTS" ]; then
            what="rule build"
            [ "$src" -eq 2 ] && what="rename to $CHAIN"
            if "$1" $W -C INPUT -j "$STAGE" 2>/dev/null; then
                log "$1: $what failed after $n attempts; $STAGE left hooked"
            elif "$1" $W -C INPUT -j "$CHAIN" 2>/dev/null; then
                log "$1: $what failed after $n attempts; previous $CHAIN kept"
            else
                log "$1: $what failed after $n attempts; no $CHAIN rules active"
            fi
            return 1
        fi
        log "$1: rule build failed (attempt $n of $ATTEMPTS), retrying"
        n=$((n + 1))
        sleep 2
    done
}

do_start() {
    rc=0
    cleanup_legacy_input_rules
    swap_in_retry iptables fill_v4 || rc=1
    if have_ip6; then
        swap_in_retry ip6tables fill_v6 || rc=1
    fi
    return "$rc"
}

do_stop() {
    for t in iptables ip6tables; do
        [ "$t" = ip6tables ] && ! have_ip6 && continue
        unhook_chain "$t" "$CHAIN"
        unhook_chain "$t" "$STAGE"
        drop_chain "$t" "$CHAIN"
        drop_chain "$t" "$STAGE"
    done
    cleanup_legacy_input_rules
}

case "${1:-}" in
    start|reload) do_start ;;
    stop)         do_stop ;;
    restart)      do_stop; do_start ;;
    *)
        echo "Usage: qmanager_firewall {start|stop|restart|reload}" >&2
        exit 1
        ;;
esac
