#!/bin/sh
# =============================================================================
# qmanager_set_ssh_password — Set root password for SSH access
# =============================================================================
# Reads the new password from stdin (one line). Updates /etc/shadow with a
# SHA-512-crypt hash ($6$), falling back to MD5-crypt ($1$) only if openssl
# cannot produce $6$. Password never appears in command-line args (invisible
# to ps).
#
# Called via sudo by CGI scripts (www-data), and by the installer's fresh-
# install SSH bootstrap. Must be whitelisted in sudoers.
#
# Usage:  printf '%s\n' "$password" | sudo /usr/bin/qmanager_set_ssh_password
# Exit:   0 = success, 1 = failure (JSON error on stdout)
#
# Install location: /usr/bin/qmanager_set_ssh_password
# =============================================================================

PATH=/usr/sbin:/usr/bin:/sbin:/bin

SHADOW=/etc/shadow

# Read password from stdin (single line). IFS= keeps leading/trailing spaces,
# so SSH gets exactly the password the web UI stored.
IFS= read -r _password

if [ -z "$_password" ]; then
    printf '{"success":false,"error":"empty_password","detail":"Password is required"}\n'
    exit 1
fi

# Validate length
_pw_len=$(printf '%s' "$_password" | wc -c)
if [ "$_pw_len" -lt 6 ]; then
    printf '{"success":false,"error":"password_too_short","detail":"Password must be at least 6 characters"}\n'
    exit 1
fi
if [ "$_pw_len" -gt 128 ]; then
    printf '{"success":false,"error":"password_too_long","detail":"Password must be at most 128 characters"}\n'
    exit 1
fi

# 16-char hex salt from /dev/urandom (hex is a subset of the crypt salt set)
_salt=$(head -c 8 /dev/urandom | od -A n -t x1 | tr -d ' \n')

# SHA-512 first; keep $1$ only as a fallback for an openssl without -6.
_hash=$(printf '%s\n' "$_password" | openssl passwd -6 -salt "$_salt" -stdin 2>/dev/null)
case "$_hash" in
    '$6$'*) ;;
    *) _hash=$(printf '%s\n' "$_password" | openssl passwd -1 -salt "$(printf '%s' "$_salt" | cut -c1-8)" -stdin 2>/dev/null) ;;
esac

case "$_hash" in
    '$6$'*|'$1$'*) ;;
    *)
        printf '{"success":false,"error":"hash_failed","detail":"Failed to generate password hash"}\n'
        exit 1
        ;;
esac

# Remount root filesystem read-write if needed
if ! touch /usr/.qm_rw_test 2>/dev/null; then
    mount -o remount,rw / 2>/dev/null || {
        printf '{"success":false,"error":"remount_failed","detail":"Could not remount / read-write"}\n'
        exit 1
    }
fi
rm -f /usr/.qm_rw_test

# Update root's password field in /etc/shadow
# Format: root:$hash:days_since_epoch:min:max:warn:inactive:expire:reserved
if [ ! -f "$SHADOW" ]; then
    printf '{"success":false,"error":"no_shadow","detail":"/etc/shadow not found"}\n'
    exit 1
fi

# Write a copy (cp -p keeps owner and mode) and rename it over the original,
# so a failure never leaves a truncated /etc/shadow.
_tmp="$SHADOW.qm.$$"
if ! cp -p "$SHADOW" "$_tmp" 2>/dev/null \
    || ! awk -F: -v OFS=: -v h="$_hash" '$1 == "root" { $2 = h; n++ } { print } END { exit n ? 0 : 1 }' \
        "$SHADOW" > "$_tmp" 2>/dev/null \
    || ! mv -f "$_tmp" "$SHADOW" 2>/dev/null; then
    rm -f "$_tmp"
    printf '{"success":false,"error":"shadow_update_failed","detail":"Failed to update /etc/shadow"}\n'
    exit 1
fi
sync

printf '{"success":true}\n'
exit 0
