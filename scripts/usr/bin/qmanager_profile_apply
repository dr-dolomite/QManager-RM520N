#!/bin/sh
# =============================================================================
# qmanager_profile_apply — Detached Profile Application Script
# =============================================================================
# Spawned as a detached process by apply.sh CGI. Applies a saved profile's
# settings to the modem and system, one step at a time, with progress
# tracking via a JSON state file.
#
# Usage:
#   qmanager_profile_apply <profile_id>
#
# State file: /tmp/qmanager_profile_state.json
# PID file:   /tmp/qmanager_profile_apply.pid
#
# Apply steps (4 total):
#   1. APN      — AT+CGDCONT (no modem reboot)
#   2. TTL/HL   — iptables/ip6tables (no modem lock needed)
#   3. Scenario — AT+QNWPREFCFG mode_pref + optional band locks (skipped if
#                 no scenario_id bound to the profile)
#   4. IMEI     — AT+EGMR + AT+CFUN=1,1 reboot (most disruptive, last)
#
# Step order rationale: scenario MUST come before IMEI because AT+CFUN=1,1
# reboots the modem and would discard any radio config applied after it.
#
# Architecture: CUSTOM_SIM_PROFILE_ARCHITECTURE_v2.md §5.2, §7
# Dependencies: qcmd, qlog.sh, profile_mgr.sh
# Install location: /usr/bin/qmanager_profile_apply
# =============================================================================

# --- Logging -----------------------------------------------------------------
. /usr/lib/qmanager/qlog.sh 2>/dev/null || {
    qlog_init() { :; }
    qlog_debug() { :; }
    qlog_info() { :; }
    qlog_warn() { :; }
    qlog_error() { :; }
}
qlog_init "profile_apply"
[ -f /usr/lib/qmanager/cgi_at.sh ] && . /usr/lib/qmanager/cgi_at.sh

# --- Events (for append_event) -----------------------------------------------
# Must define EVENTS_FILE and MAX_EVENTS before sourcing events.sh
EVENTS_FILE="/tmp/qmanager_events.json"
MAX_EVENTS=300
. /usr/lib/qmanager/events.sh 2>/dev/null || {
    append_event() { :; }
}

# --- Source profile manager library ------------------------------------------
[ -f /usr/lib/qmanager/profile_mgr.sh ]   && . /usr/lib/qmanager/profile_mgr.sh
[ -f /usr/lib/qmanager/platform.sh ]      && . /usr/lib/qmanager/platform.sh
[ -f /usr/lib/qmanager/ttl_state.sh ]     && . /usr/lib/qmanager/ttl_state.sh
[ -f /usr/lib/qmanager/scenario_mgr.sh ]  && . /usr/lib/qmanager/scenario_mgr.sh
# apn_apply.sh depends on cgi_at.sh (already sourced above) and events.sh's
# append_event (already sourced above, or shimmed to a no-op) being loaded
# first — see that file's header for the full dependency contract.
[ -f /usr/lib/qmanager/apn_apply.sh ]     && . /usr/lib/qmanager/apn_apply.sh

# --- Configuration -----------------------------------------------------------
STATE_FILE="/tmp/qmanager_profile_state.json"
# WS6 single-APN sidecar (same file apn.sh's write_setting_json/read_setting_
# json manage) — kept in sync here, best-effort, after a successful APN step
# so /cellular/settings -> APN does not render stale after a profile apply.
# Lives in /etc/qmanager (www-data-owned), NOT /usrdata/qmanager (0755
# root:root). This binary is spawned WITHOUT sudo by profiles/apply.sh on the
# UI path, so it runs as www-data there and could never create its temp file
# under /usrdata/qmanager — the same silent no-op that affected apn.sh. Both
# writers must stay on this one path or they diverge onto separate files.
APN_SETTING_FILE="/etc/qmanager/apn_setting.json"
# Recovery flag — SAME path watchcat (Tier 1/2/3), qmanager_ping
# (during_recovery), alert_engine.sh, and events.sh already read/react to.
#
# This flag is genuinely MULTI-UID; an earlier version of this comment claimed
# "only this root worker ever touches it" and that was simply wrong:
#   - www-data  when spawned from the UI — profiles/apply.sh runs
#               "$APPLY_BIN" with NO sudo, and this binary is not setuid and
#               has no sudoers entry (same for cellular/settings.sh ->
#               profile_mgr.sh's auto_apply_profile spawn).
#   - root      when spawned by qmanager_poller (boot auto-apply) or
#               qmanager_watchcat, neither of which sets User=.
# So the SAME flag path is written by two different UIDs, and /tmp fights us
# in two independent ways:
#   - sticky bit (1777): only the file's owner — or root, via CAP_FOWNER —
#     may UNLINK it. www-data can never rm a root-created flag.
#   - fs.protected_regular=1: an O_CREAT open-for-write of a file in a
#     world-writable sticky dir is refused unless the caller owns the file OR
#     the file's owner is the DIRECTORY's owner. /tmp is root-owned, and this
#     check has NO root override — so root cannot even overwrite a
#     www-data-created flag.
# Both denials are silent under `2>/dev/null`. Ownership is therefore never
# assumed here: every claim WRITES and then READS BACK (see _apn_rf_claim),
# and every clear checks the file is actually gone. Do NOT relocate this flag
# to a persistent path — /tmp being tmpfs is what bounds a stuck flag to a
# single uptime.
APN_RECOVERY_FLAG="/tmp/qmanager_recovery_active"
# Age ceiling for reclaiming a flag whose PID still LOOKS alive. pid_max is
# 32768 and the churn was MEASURED on this device at ~100 PIDs/s (sampled from
# /proc/loadavg's last field over 90s), so the PID space wraps in ~325s. A
# /proc lookup on a flag older than that can match a completely unrelated
# process, and nobody would ever reclaim it.
#
# 120, not 300. An earlier draft used 300 on the strength of a guessed 60-90
# PIDs/s; at the measured rate that is 92% of a full wrap — no margin at all,
# and PID *collisions* start well before a full lap because the allocator
# skips live PIDs (birthday problem). 120s is ~37% of a wrap, and still an
# order of magnitude above any legitimate bracket: a real APN bracket is
# seconds (a few sleeps plus AT round-trips). Re-measure before raising this.
# Deliberately NOT
# REBOOT_TIMEOUT — that one bounds an AT+CFUN=1,1 wait and has no relation
# to how long a bracket may hold suppression.
APN_RECOVERY_FLAG_MAX_AGE=120
# Upper sanity bound on a computed age. Anything above this is not "very old",
# it is a CLOCK ARTEFACT, and must never be treated as evidence of staleness —
# see _apn_rf_stale_by_age().
APN_RECOVERY_FLAG_MAX_PLAUSIBLE_AGE=86400
# Ownership marker for APN_RECOVERY_FLAG, read by the cleanup() trap below —
# 1 only when THIS run created (or reclaimed) the flag; see apply_apn()'s
# recovery-flag block for the full ownership rule. Initialized here (not
# `local`) so it is a plain global, visible from both apply_apn() and the
# cleanup() trap regardless of which function is executing when a signal
# arrives.
_apn_rf_owned=0
# Pending re-apply marker: auto_apply_profile writes this when it finds THIS
# worker holding the PID lock; we consume it on exit (after the lock is freed).
PROFILE_PENDING_APPLY_FILE="/tmp/qmanager_profile_pending_apply"

# Band failover watcher — same files/flag bands/lock.sh (the manual Band
# Locking page) uses. Kept identical so both spawn paths are indistinguishable
# to the watcher and to the UI's failover-activated flag.
FAILOVER_ENABLED_FILE="/etc/qmanager/band_failover_enabled"
FAILOVER_PID_FILE="/tmp/qmanager_band_failover.pid"
FAILOVER_ACTIVATED_FLAG="/tmp/qmanager_band_failover"
FAILOVER_SCRIPT="/usr/bin/qmanager_band_failover"

# Sip-don't-gulp gap between AT commands (seconds)
CMD_GAP=0.3
# Max seconds to wait for modem to come back after AT+CFUN=1,1
REBOOT_TIMEOUT=60

# --- Validate arguments ------------------------------------------------------
PROFILE_ID="$1"

if [ -z "$PROFILE_ID" ]; then
    qlog_error "No profile ID provided"
    exit 1
fi

# Auto mode: set only when spawned by auto_apply_profile (SIM-driven). Enables
# the stale-SIM guard below. Manual Activate (apply.sh) omits it and keeps its
# exact prior semantics — no guard, never aborts on a SIM read.
AUTO_MODE=""
if [ "$2" = "--auto" ]; then
    AUTO_MODE=1
fi

# --- Auto-mode stale-SIM guard helpers ---------------------------------------
# _auto_read_live_iccid — canonical QCCID parse + iccid_canonicalize, 3x1s
# retry. Prints the canonicalized ICCID (empty if every read failed). Empty is
# a "don't know" signal — callers must NOT abort on it (best-effort guard).
_auto_read_live_iccid() {
    local _ali_raw
    local _ali_i
    _ali_i=1
    while [ "$_ali_i" -le 3 ]; do
        _ali_raw=$(qcmd 'AT+QCCID' 2>/dev/null | grep '+QCCID:' | sed 's/+QCCID: //g' | tr -d '\r ')
        if [ -n "$_ali_raw" ]; then
            iccid_canonicalize "$_ali_raw"
            return 0
        fi
        sleep 1
        _ali_i=$((_ali_i + 1))
    done
    printf ''
    return 0
}

# _auto_sim_guard <phase> — returns 0 (proceed) unless, in auto mode, the profile
# is SIM-bound AND the live ICCID now differs from the profile's sim_iccid — i.e.
# a newer SIM switch has superseded this apply. An empty live read never aborts.
_auto_sim_guard() {
    local _asg_phase
    local _asg_live
    local _asg_want
    _asg_phase="$1"
    [ -z "$AUTO_MODE" ] && return 0
    [ -z "$p_sim_iccid" ] && return 0
    _asg_live=$(_auto_read_live_iccid)
    [ -z "$_asg_live" ] && return 0
    _asg_want=$(iccid_canonicalize "$p_sim_iccid")
    [ "$_asg_live" = "$_asg_want" ] && return 0
    qlog_warn "[auto] SIM changed under apply ($_asg_phase): live=$_asg_live != profile=$_asg_want — superseding"
    return 1
}

# _consume_pending_apply — called from the EXIT trap STRICTLY AFTER the PID lock
# is freed, so a re-spawned auto_apply_profile can acquire the lock instead of
# busy-skipping again. If a pending marker exists, consume it and re-run
# auto_apply for the FRESHEST live SIM (read now, not the stored value) so the
# newest state wins; fall back to the stored ICCID only if the live read is
# empty. Terminates: a re-run that again finds the lock busy just rewrites the
# pending file for the next worker's exit — no loop.
_consume_pending_apply() {
    [ -f "$PROFILE_PENDING_APPLY_FILE" ] || return 0
    local _cp_stored
    local _cp_live
    local _cp_i
    local _cp_iccid
    _cp_stored=$(head -1 "$PROFILE_PENDING_APPLY_FILE" 2>/dev/null | cut -f1)
    rm -f "$PROFILE_PENDING_APPLY_FILE"
    _cp_live=""
    _cp_i=1
    while [ "$_cp_i" -le 3 ]; do
        _cp_live=$(qcmd 'AT+QCCID' 2>/dev/null | grep '+QCCID:' | sed 's/+QCCID: //g' | tr -d '\r ')
        [ -n "$_cp_live" ] && break
        sleep 1
        _cp_i=$((_cp_i + 1))
    done
    _cp_iccid="$_cp_live"
    [ -z "$_cp_iccid" ] && _cp_iccid="$_cp_stored"
    [ -z "$_cp_iccid" ] && return 0
    qlog_info "[requeue] Consuming pending apply; re-running auto_apply for ICCID ...$(printf '%s' "$_cp_iccid" | tail -c 4)"
    ( . /usr/lib/qmanager/profile_mgr.sh && auto_apply_profile "$_cp_iccid" "requeue" ) </dev/null >/dev/null 2>&1 &
}

# --- Singleton enforcement via PID file --------------------------------------
if ! profile_acquire_lock; then
    qlog_warn "Apply already running (PID: $_profile_lock_pid)"
    exit 1
fi

# --- Cleanup trap: remove PID file, clear recovery flag (if OWNED), THEN
# consume any queued re-apply --------------------------------------------------
# Order is critical: the pending re-apply must run only after the PID lock is
# gone, or the re-spawned auto_apply would busy-skip and drop the marker.
# The recovery-flag clear is gated on `_apn_rf_owned`, which is set ONLY by a
# verified read-back claim in _apn_rf_claim (see the APN_RECOVERY_FLAG comment
# above for why a write here cannot be assumed to have landed). A flag we did
# not verifiably claim — a foreign owner's, e.g. watchcat's — must NEVER be
# deleted here. This is the belt-and-suspenders net for a signal arriving
# mid-bracket, on top of apn_apply_on_bracket_end's own normal-path clear on
# every return from apn_apply_write.
#
# PROFILE_APPLY_PID_FILE is TRUNCATED, never unlinked. An earlier draft used
# `rm -f` here and reasoned that it was harmless because the lock decides on
# CONTENT rather than existence (profile_check_lock: `[ -n "$pid" ] &&
# [ -d /proc/$pid ]`, profile_mgr.sh:715-725). The content half is true; the
# harmlessness is not.
#
# The unlink DESTROYS the seeded inode. qmanager_setup pre-creates this file
# root:root 0666 precisely so both UIDs can write it — root from the poller and
# watchcat, www-data from the UI (profiles/apply.sh spawns this binary with no
# sudo). Unlink it once as root and the seed is gone for the rest of the boot;
# whichever UID next runs creates it fresh at its own umask, and a root-created
# 0644 file locks www-data out of the lock file entirely. Its `echo $$ >` then
# fails silently, the lock is never recorded, and two applies can run
# concurrently. Confirmed on hardware: the seeded file was simply ABSENT, and
# the UI path had been running unlocked.
#
# `: >` truncates through the existing inode, so ownership and mode survive. It
# is exactly equivalent to the unlink for the lock's purposes — an empty file
# yields an empty $pid, which reads as unlocked — while keeping the shared
# inode alive. Do not turn this back into `rm -f`.
#
# The redirect is guarded because as www-data it can still fail if the seed was
# already lost on an earlier boot; failing to clear the lock is worth a warning,
# not a crash.
cleanup() {
    if ! : > "$PROFILE_APPLY_PID_FILE" 2>/dev/null; then
        qlog_warn "cleanup: could not truncate $PROFILE_APPLY_PID_FILE as uid $(id -u) — the apply lock may read as held until it ages out"
    fi
    if [ "${_apn_rf_owned:-0}" = "1" ]; then
        rm -f "$APN_RECOVERY_FLAG" 2>/dev/null
        # An unchecked rm here is how a permanently stuck flag stayed
        # invisible: a cross-UID unlink in sticky /tmp returns 1 and changes
        # nothing, and a stranded flag pins qmanager_ping's during_recovery,
        # which freezes ALL alerts and suppresses every internet event until
        # the next reboot. Make it findable.
        [ -f "$APN_RECOVERY_FLAG" ] && \
            qlog_warn "cleanup: failed to remove $APN_RECOVERY_FLAG (cross-UID unlink denied by /tmp's sticky bit) — alert suppression stays raised until reboot"
    fi
    _consume_pending_apply
}
trap cleanup EXIT INT TERM

# =============================================================================
# State File Management
# =============================================================================

# Step names (4 steps: scenario inserted between ttl_hl and imei)
STEP_NAMES="apn ttl_hl scenario imei"
STEP_COUNT=4

# Step statuses (initialized to "pending")
step_status_apn="pending"
step_status_ttl_hl="pending"
step_status_scenario="pending"
step_status_imei="pending"

# Step details
step_detail_apn=""
step_detail_ttl_hl=""
step_detail_scenario=""
step_detail_imei=""

# Global state
apply_status="applying"
apply_current_step=0
apply_requires_reboot="false"
apply_error="null"
apply_started_at=$(date +%s)
apply_profile_name=""

# Counters for final status
steps_done=0
steps_failed=0
steps_skipped=0

# --- Write the state file (build in a temp, then COPY — never rename) --------
# The staging temp exists so a jq failure cannot truncate live state: the copy
# below is GUARDED on the temp being non-empty, because `cat` of a zero-byte
# temp would faithfully truncate the destination to zero bytes. (Without that
# guard the temp buys nothing — it just moves the truncation one step later.)
# When the temp is good it is copied BYTE-WISE into the target, never `mv`d
# over it.
#
# THIS MUST NEVER BECOME `mv`. rename(2) swaps the INODE, which destroys the
# shared file qmanager_setup pre-creates for exactly this cross-UID case: the
# boot-time ROOT apply's mv replaced the seeded inode with a root-owned one at
# umask 0022, after which every www-data UI Activate silently failed to record
# progress and the dialog showed the STALE boot-run result. Writing through the
# existing inode keeps whatever ownership/mode the seed established.
#
# The temp name is PID-qualified: a bare "${STATE_FILE}.tmp" is itself a
# cross-UID trap — a run killed between jq and the copy leaves a temp owned by
# one UID that the other UID can then never open for write (same
# fs.protected_regular rule as the recovery flag).
#
# Trade accepted: we give up rename-atomicity, so a reader can briefly observe
# a partially written file. That is fine for a progress file that is polled and
# rewritten on every step, and the CGI reader is fail-soft.
write_state() {
    local tmp="${STATE_FILE}.tmp.$$"
    local err_val
    if [ "$apply_error" = "null" ]; then
        err_val="null"
    else
        err_val="$apply_error"
    fi

    jq -n \
        --arg status       "$apply_status" \
        --arg profile_id   "$PROFILE_ID" \
        --arg profile_name "$apply_profile_name" \
        --argjson started  "$apply_started_at" \
        --argjson cur_step "$apply_current_step" \
        --argjson total    "$STEP_COUNT" \
        --arg s1_status    "$step_status_apn" \
        --arg s1_detail    "$step_detail_apn" \
        --arg s2_status    "$step_status_ttl_hl" \
        --arg s2_detail    "$step_detail_ttl_hl" \
        --arg s3_status    "$step_status_scenario" \
        --arg s3_detail    "$step_detail_scenario" \
        --arg s4_status    "$step_status_imei" \
        --arg s4_detail    "$step_detail_imei" \
        --argjson reboot   "$apply_requires_reboot" \
        --arg err          "$err_val" \
        '{
            status: $status,
            profile_id: $profile_id,
            profile_name: $profile_name,
            started_at: $started,
            current_step: $cur_step,
            total_steps: $total,
            steps: [
                {name: "apn",      status: $s1_status, detail: $s1_detail},
                {name: "ttl_hl",   status: $s2_status, detail: $s2_detail},
                {name: "scenario", status: $s3_status, detail: $s3_detail},
                {name: "imei",     status: $s4_status, detail: $s4_detail}
            ],
            requires_reboot: $reboot,
            error: (if $err == "null" then null else $err end)
        }' > "$tmp"

    # Refuse to publish an empty render. jq's exit status above is discarded
    # (it is the tail of a long heredoc-style invocation), so a jq failure is
    # only visible as a zero-byte temp. Copying that would truncate the live
    # state file — and a zero-byte state file with an old mtime is exactly the
    # shape the CGI reader treats as a stale/unparseable apply, so the UI would
    # report a phantom "failed" for an apply that is still running fine.
    if [ ! -s "$tmp" ]; then
        qlog_warn "jq produced no output for $STATE_FILE — leaving the previous state intact rather than truncating it"
        rm -f "$tmp" 2>/dev/null
        return 1
    fi

    if cat "$tmp" > "$STATE_FILE" 2>/dev/null; then
        rm -f "$tmp" 2>/dev/null
    else
        # Denied — the target inode belongs to the other UID (see the header
        # above). Warn LOUDLY: silently swallowing this is what made the UI
        # show a stale apply result with no trace anywhere.
        qlog_warn "Failed to write $STATE_FILE (running as uid $(id -u); target owned by another UID under fs.protected_regular / mode) — apply progress will read STALE"
        rm -f "$tmp" 2>/dev/null
    fi
}

# --- Step lifecycle helpers ---------------------------------------------------
mark_step_running() {
    local step="$1"
    local detail="$2"
    # Only increment current_step on first transition (pending → running),
    # not on subsequent detail updates while already running.
    local prev_status
    eval "prev_status=\"\$step_status_${step}\""
    eval "step_status_${step}=\"running\""
    eval "step_detail_${step}=\"\$detail\""
    if [ "$prev_status" != "running" ]; then
        apply_current_step=$((apply_current_step + 1))
    fi
    write_state
}

mark_step_done() {
    local step="$1"
    local detail="$2"
    eval "step_status_${step}=\"done\""
    eval "step_detail_${step}=\"\$detail\""
    steps_done=$((steps_done + 1))
    write_state
}

mark_step_failed() {
    local step="$1"
    local detail="$2"
    eval "step_status_${step}=\"failed\""
    eval "step_detail_${step}=\"\$detail\""
    steps_failed=$((steps_failed + 1))
    write_state
}

mark_step_skipped() {
    local step="$1"
    local detail="$2"
    eval "step_status_${step}=\"skipped\""
    eval "step_detail_${step}=\"\$detail\""
    steps_skipped=$((steps_skipped + 1))
    # Don't increment apply_current_step here — mark_step_running already
    # incremented it when the step first transitioned to "running".
    write_state
}

# =============================================================================
# Load Profile
# =============================================================================
qlog_info "Starting profile apply: $PROFILE_ID"

profile_json=$(profile_get "$PROFILE_ID")
if [ -z "$profile_json" ]; then
    qlog_error "Profile not found: $PROFILE_ID"
    apply_status="failed"
    apply_error="Profile not found"
    write_state
    exit 1
fi

# Extract settings from the profile JSON using jq with proper nested paths
p_name=$(printf '%s' "$profile_json" | jq -r '.name // empty')
apply_profile_name="$p_name"

p_apn_name=$(printf '%s' "$profile_json" | jq -r '.settings.apn.name // empty')
p_apn_cid=$(printf '%s' "$profile_json" | jq -r '.settings.apn.cid // empty | tostring')
p_pdp_type=$(printf '%s' "$profile_json" | jq -r '.settings.apn.pdp_type // empty')
p_imei=$(printf '%s' "$profile_json" | jq -r '.settings.imei // empty')
p_ttl=$(printf '%s' "$profile_json" | jq -r '.settings.ttl // empty | tostring')
p_hl=$(printf '%s' "$profile_json" | jq -r '.settings.hl // empty | tostring')
p_scenario_id=$(printf '%s' "$profile_json" | jq -r '.settings.scenario_id // empty')
p_sim_iccid=$(printf '%s' "$profile_json" | jq -r '.sim_iccid // empty')

# Defaults
[ -z "$p_apn_cid" ] && p_apn_cid=1
[ -z "$p_ttl" ] && p_ttl=0
[ -z "$p_hl" ] && p_hl=0

qlog_info "Applying profile: $p_name (APN=$p_apn_name, CID=$p_apn_cid)"

# Write initial state
write_state

# --- Auto-mode at-start stale-SIM guard --------------------------------------
# If the SIM already changed before we ran the first step, this apply was
# superseded by a newer switch. Abort cleanly WITHOUT touching the active marker
# (the authoritative apply for the current SIM owns it). The EXIT trap still runs
# the pending re-apply. "failed" is a terminal state for the status poller.
if ! _auto_sim_guard "pre-apply"; then
    apply_status="failed"
    apply_error="superseded_sim_changed"
    write_state
    append_event "profile_failed" "Profile '$p_name' apply superseded — active SIM changed before apply" "warning"
    exit 0
fi

# apn_pdp_at_to_frontend <AT vocab> -> frontend vocab (ipv4/ipv6/ipv4v6)
# Mirrors apn.sh's pdp_to_frontend — needed here only for the best-effort
# apn_setting.json sidecar write below, which stores frontend vocabulary.
apn_pdp_at_to_frontend() {
    case "$1" in
        IP|IPV4) echo "ipv4" ;;
        IPV6)    echo "ipv6" ;;
        *)       echo "ipv4v6" ;;
    esac
}

# _apn_sidecar_converge <cid> <negotiated_apn> <pdp_at> — best-effort,
# warn-only sync of the WS6 single-APN sidecar (/etc/qmanager/
# apn_setting.json) after a successful profile apply. apn.sh is the only
# other writer of this file; a failure here must NEVER fail the apply step
# (mirrors apn.sh's own write_setting_json warn-only pattern). Writes the
# NEGOTIATED apn, not the requested one (equal in the happy path).
_apn_sidecar_converge() {
    local _cid="$1"
    local _apn="$2"
    local _pdp_at="$3"
    local _pdp_fe _dir _tmp
    _pdp_fe=$(apn_pdp_at_to_frontend "$_pdp_at")
    _dir=$(dirname "$APN_SETTING_FILE")
    [ -d "$_dir" ] || mkdir -p "$_dir" 2>/dev/null
    _tmp="${APN_SETTING_FILE}.tmp.$$"
    if ! jq -n --arg apn "$_apn" --arg pdp_type "$_pdp_fe" --argjson cid "$_cid" \
        '{apn: $apn, pdp_type: $pdp_type, cid: $cid, active: 1}' > "$_tmp" 2>/dev/null; then
        rm -f "$_tmp" 2>/dev/null
        qlog_warn "apn sidecar converge: jq build failed for CID ${_cid}"
        return 1
    fi
    chmod 644 "$_tmp" 2>/dev/null
    if ! mv "$_tmp" "$APN_SETTING_FILE" 2>/dev/null; then
        rm -f "$_tmp" 2>/dev/null
        qlog_warn "apn sidecar converge: mv failed for $APN_SETTING_FILE"
        return 1
    fi
    chmod 644 "$APN_SETTING_FILE" 2>/dev/null
    return 0
}

# =============================================================================
# apn_apply_on_bracket_start / apn_apply_on_bracket_end — recovery-flag hooks
# =============================================================================
# apn_apply.sh feature-detects these two functions via `command -v` (the same
# idiom this script already uses for scenario_install_schedule etc.) and, if
# defined, calls apn_apply_on_bracket_start immediately after its bracket
# lock is actually held — NOT while merely waiting on it — and
# apn_apply_on_bracket_end on every return path that ran the start hook. This
# is what moves APN_RECOVERY_FLAG ownership from "raised before the lock
# wait even starts" (the bug: up to 30s of suppression for an apply that may
# end in apn_busy, rc=7, having issued zero AT commands) to "raised only once
# a bracket is actually about to touch the modem." apn_apply.sh itself learns
# nothing about this flag — it only knows an optional callback might exist —
# so the CGI callers (apn.sh, profiles/deactivate.sh), which never define
# these functions, are completely unaffected.
#
# Ownership rule:
#   flag absent          -> try to claim it (create + verify).
#   flag present + EMPTY -> foreign owner. An OLD watchcat's bare `touch`
#                           writes no PID at all, and during an OTA an old
#                           watchcat can be running against this new binary,
#                           so an empty file is still the NORMAL shape of a
#                           live watchcat recovery. Leave it alone.
#   flag present + LIVE PID (ours or foreign) -> leave it alone...
#   ...UNLESS the flag is older than APN_RECOVERY_FLAG_MAX_AGE, in which case
#                           the "live" PID is almost certainly a wrapped,
#                           unrelated process (~6-minute PID wrap on this
#                           device). Reclaim.
#   flag present + DEAD PID -> genuinely stale (e.g. a SIGKILLed prior run of
#                           THIS worker). Safe to reclaim.
#
# Ownership is CLAIMED BY VERIFICATION, never by assumption: both claim paths
# go through _apn_rf_claim, which reads the file back. The previous version
# set _apn_rf_owned=1 unconditionally after a `printf ... 2>/dev/null`, so a
# www-data run writing over a root-owned flag "owned" a flag it had never
# written — and then its rm -f silently no-op'd, stranding suppression (and
# with it every alert and internet event) until the next reboot.
#
# Failing to claim is NOT fatal: suppression is best-effort, and an APN apply
# that cannot suppress alerts is still a correct APN apply. We proceed
# unsuppressed and say so in the log.
#
# _apn_rf_owned is the plain global declared near APN_RECOVERY_FLAG above —
# NOT `local` here either — so cleanup()'s EXIT/INT/TERM trap can still read
# it regardless of which function is executing when a signal arrives.

# _apn_rf_claim — write our PID into the flag and PROVE it landed. Sets
# _apn_rf_owned=1 only on a verified read-back; returns non-zero (and warns
# with the PID that actually occupies the file) otherwise.
_apn_rf_claim() {
    local _rf_back
    # Unlink FIRST, then create. Every caller has already decided the flag is
    # ours to take (absent, dead PID, or aged out), so destroying it here is
    # never destroying live state.
    #
    # This line is load-bearing in the root-reclaims-a-www-data-flag direction.
    # A bare `printf > flag` against a flag owned by the OTHER uid is refused by
    # fs.protected_regular (no root override), so the read-back below would
    # mismatch, ownership would stay 0, and the stale flag would be left raised
    # for the rest of the uptime — pinning during_recovery, freezing alerts and
    # suppressing internet events. That is the exact failure this whole change
    # exists to remove, reached from the mirror side. The unlink turns the write
    # into an O_CREAT on a name that no longer exists, which protected_regular
    # never refuses.
    #
    # Safe in the other direction too: www-data cannot unlink a root-owned file
    # from sticky /tmp, so this no-ops there and the read-back still fails
    # closed — we proceed WITHOUT suppression rather than falsely claiming.
    rm -f "$APN_RECOVERY_FLAG" 2>/dev/null
    printf '%s\n' "$$" > "$APN_RECOVERY_FLAG" 2>/dev/null
    _rf_back=$(cat "$APN_RECOVERY_FLAG" 2>/dev/null | tr -d ' \n\r')
    if [ "$_rf_back" = "$$" ]; then
        _apn_rf_owned=1
        return 0
    fi
    _apn_rf_owned=0
    qlog_warn "Could not claim $APN_RECOVERY_FLAG as uid $(id -u): flag holds '${_rf_back:-<empty>}', wanted $$ — proceeding WITHOUT alert suppression for this APN bracket"
    return 1
}

# _apn_rf_stale_by_age — 0 (stale) only when the flag's mtime is provably
# older than the ceiling. `stat -c %Y` is the established mtime idiom in this
# codebase (qmanager_poller's LONG_FLAG check, qmanager_health_check's
# freshness checks), so it is known-present on this device's BusyBox/coreutils
# mix. Any unreadable or non-numeric result degrades to "NOT stale by age" —
# the PID check alone then decides, which can only ever be too conservative,
# never a wrong reclaim.
#
# THE CLOCK STEP IS THE HARD PART. This device has no battery-backed RTC: every
# boot starts at Jan 1 1970 and ql_time_daemon steps the wall clock ~24s in. So
# BOTH directions of `now - mtime` are corruptible, and only one of them is
# obvious:
#
#   - mtime AFTER the step, `now` read BEFORE it -> negative age. Harmless: a
#     negative number is never `-gt` the ceiling, so we report "not stale".
#   - mtime BEFORE the step (e.g. the poller's boot-time auto_apply at ~10s
#     uptime), `now` read AFTER it -> age computes to ~56 YEARS. That is
#     `-gt 120`, so the naive check reports STALE and we reclaim a flag whose
#     owner is alive and mid-bracket. We would then unlink their flag, and
#     their cleanup would later delete OURS, collapsing suppression for both.
#
# The second case is the dangerous one and the non-numeric guard cannot catch
# it — the arithmetic is perfectly valid, it just describes a bogus span. So an
# implausible age is treated as NO EVIDENCE rather than as strong evidence:
# fall back to the PID check, which is the conservative direction. A flag whose
# mtime predates the step simply cannot be aged out during this boot, which is
# correct — /tmp is tmpfs, so it cannot outlive the boot anyway.
_apn_rf_stale_by_age() {
    local _rf_mtime _rf_age
    _rf_mtime=$(stat -c %Y "$APN_RECOVERY_FLAG" 2>/dev/null)
    case "$_rf_mtime" in
        ''|*[!0-9]*) return 1 ;;
    esac
    _rf_age=$(( $(date +%s) - _rf_mtime ))
    # Clock artefact, not age. Report "not stale" and let the PID check decide.
    [ "$_rf_age" -gt "$APN_RECOVERY_FLAG_MAX_PLAUSIBLE_AGE" ] && return 1
    [ "$_rf_age" -gt "$APN_RECOVERY_FLAG_MAX_AGE" ]
}

apn_apply_on_bracket_start() {
    local _apn_rf_pid
    _apn_rf_owned=0
    if [ ! -f "$APN_RECOVERY_FLAG" ]; then
        _apn_rf_claim
    else
        _apn_rf_pid=$(cat "$APN_RECOVERY_FLAG" 2>/dev/null | tr -d ' \n\r')
        if [ -z "$_apn_rf_pid" ]; then
            # Foreign (old watchcat) — untouched, and deliberately NOT aged
            # out: an empty flag carries no owner to judge it by.
            :
        elif ! [ -d "/proc/$_apn_rf_pid" ]; then
            qlog_warn "Reclaiming stale recovery flag (dead pid=$_apn_rf_pid)"
            _apn_rf_claim
        elif _apn_rf_stale_by_age; then
            qlog_warn "Reclaiming stale recovery flag (pid=$_apn_rf_pid appears live, but the flag is older than ${APN_RECOVERY_FLAG_MAX_AGE}s and PIDs wrap in ~6min here)"
            _apn_rf_claim
        fi
        # Live PID within the age ceiling -> _apn_rf_owned stays 0; the flag
        # is left completely untouched.
    fi
}

# Clear promptly ONLY if we own the flag — don't hold suppression for the
# remaining ttl_hl/scenario/imei steps, which have nothing to do with this
# WAN blip, but never delete a flag a foreign owner (watchcat) is still
# using. cleanup()'s EXIT/INT/TERM trap (same ownership guard) remains the
# net for an abnormal exit mid-bracket (e.g. a signal apn_apply.sh's own trap
# handler cannot fully recover from).
apn_apply_on_bracket_end() {
    if [ "$_apn_rf_owned" = "1" ]; then
        rm -f "$APN_RECOVERY_FLAG" 2>/dev/null
        # A cross-UID unlink in sticky /tmp returns 1 and removes nothing, so
        # check rather than trust. A flag left behind here pins
        # qmanager_ping's during_recovery=true, which pins conn_status
        # "recovery", freezes every alert and suppresses every internet event
        # for the rest of this uptime — worth a log line.
        [ -f "$APN_RECOVERY_FLAG" ] && \
            qlog_warn "Failed to clear $APN_RECOVERY_FLAG after the APN bracket (cross-UID unlink denied by /tmp's sticky bit) — alerts stay suppressed until reboot"
        # Ownership ENDS here. Must reset, or this long-lived global stays
        # "1" for the rest of the process — through apply_imei, which blocks
        # up to REBOOT_TIMEOUT=60s on an AT+CFUN=1,1 reboot. Watchcat can
        # legitimately raise its own recovery flag inside that window, and a
        # stale _apn_rf_owned=1 would make cleanup() delete THAT flag on
        # exit, ending a live recovery's alert suppression early.
        _apn_rf_owned=0
    fi
}

# =============================================================================
# Step 1: APN
# =============================================================================
apply_apn() {
    mark_step_running "apn" "Checking APN configuration..."

    local pdp="${p_pdp_type:-IPV4V6}"

    # --- Empty-APN early-skip, BEFORE any AT call ---------------------------
    # profile_mgr.sh validates only cid/pdp_type, not apn_name (:269-273 in
    # profile_save) — an IMEI-only or TTL-only profile can legitimately carry
    # no APN. Never bracket-cycle the modem for a profile with nothing to say.
    if [ -z "$p_apn_name" ]; then
        mark_step_skipped "apn" "No APN configured in this profile (CID ${p_apn_cid})"
        return
    fi

    # --- Skip-check against the NEGOTIATED view, not the configured one -----
    # The OLD check compared against AT+CGDCONT? (what was ASKED for), which
    # is self-concealing: one bracket-less apply makes CGDCONT match even
    # though the bearer is stale, so a SECOND apply would report "already
    # set" and never actually fix anything. AT+CGCONTRDP=<cid> is the only
    # view that reflects what the network actually granted. Cost: one extra
    # AT round-trip per apply attempt (acceptable — this step already made
    # several before this change).
    #
    # Case-fold ONLY for the comparison: APNs are DNS-style labels, case-
    # insensitive per 3GPP. A live device negotiated "INTERNET.GLOBE.COM.PH"
    # uppercase for a profile stored as "internet" — a byte-for-byte compare
    # would never match, so every trigger (boot, SIM-slot switch, watchdog
    # SIM failover, manual re-activate) would re-run the full detach/attach
    # bracket even though the APN is already correct. The detail string
    # below still reports the profile's ORIGINAL-case p_apn_name.
    local rdp current_negotiated
    rdp=$(run_at "AT+CGCONTRDP=${p_apn_cid}")
    current_negotiated=$(parse_cgcontrdp_apn "$rdp")

    if [ -n "$current_negotiated" ] && \
       [ "$(printf '%s' "$current_negotiated" | tr 'A-Z' 'a-z')" = "$(printf '%s' "$p_apn_name" | tr 'A-Z' 'a-z')" ]; then
        mark_step_skipped "apn" "APN already negotiated: ${p_apn_name} (CID ${p_apn_cid})"
        return
    fi

    # --- Fail closed if the shared primitive failed to load -----------------
    # A defensive `[ -f ... ] && . ...` source (used above for the other
    # libs) would let a broken install silently fall through here and apply
    # the APN with NO bracket at all — reintroducing the exact bug this
    # change fixes, as a new failure mode. Check the function actually
    # exists and fail the step loudly instead.
    if ! command -v apn_apply_write >/dev/null 2>&1; then
        mark_step_failed "apn" "apn_apply.sh library missing or failed to load — APN NOT applied (no bracket attempted)"
        return
    fi

    mark_step_running "apn" "Applying APN ${p_apn_name} (CID ${p_apn_cid})..."

    # --- Recovery-flag suppression (best-effort, either UID) ----------------
    # apn_apply_write calls apn_apply_on_bracket_start/_end (defined above)
    # itself, at the right moments — once the bracket lock is actually held,
    # not while merely waiting on it — so there is nothing to do here beyond
    # calling in. See those two functions' header comment for the full
    # ownership rule and why this moved out of this inline call site.
    apn_apply_write "$p_apn_cid" "$pdp" "$p_apn_name"

    # Re-assert our own process-wide trap immediately: apn_apply_write
    # borrows INT/TERM for the duration of its bracket and releases them
    # back to the shell's DEFAULT disposition on every return path (see
    # apn_apply.sh's _apn_apply_trap_restore) — it does NOT know about, and
    # cannot safely restore, `cleanup`. Unconditional and correct regardless
    # of which return path fired; must land before the riskier ttl_hl /
    # scenario / imei steps run, since apply_imei blocks up to
    # REBOOT_TIMEOUT=60s waiting out an AT+CFUN=1,1 reboot and a SIGTERM in
    # that window must still reach cleanup() (PID-file removal, recovery-
    # flag clear, pending-requeue consumption).
    trap cleanup EXIT INT TERM

    case "$APN_APPLY_RC" in
        0)
            mark_step_done "apn" "$APN_APPLY_DETAIL"
            # Best-effort sidecar convergence — never fails the step.
            _apn_sidecar_converge "$p_apn_cid" "$APN_APPLY_NEGOTIATED_APN" "$pdp" || \
                qlog_warn "Applied APN to modem but failed to converge $APN_SETTING_FILE"
            ;;
        7)
            # apn_busy: another apn_apply_write bracket is in progress
            # elsewhere (another process, or a concurrent CGI save). No AT
            # commands were issued — modem unchanged. Not a "failure" of
            # this apply's own logic, but the 4-step ledger has no distinct
            # "retry" status, so it still reports as failed; the detail
            # string carries the true, retryable nature of the condition.
            mark_step_failed "apn" "$APN_APPLY_DETAIL"
            ;;
        *)
            # Every other non-zero code (including rc=3, "modem may be
            # deregistered") is reported as a failed step — the ledger has
            # no slot for a distinct "critical" severity, so the severity
            # rides entirely in the detail string.
            mark_step_failed "apn" "$APN_APPLY_DETAIL"
            ;;
    esac
}

# =============================================================================
# Step 2: TTL / HL (system-level, no modem lock needed)
# =============================================================================
apply_ttl_hl() {
    mark_step_running "ttl_hl" "Checking TTL/HL settings..."

    # Read live kernel state for comparison
    local current_ttl current_hl
    set -- $(ttl_state_read_live)
    current_ttl="${1:-0}"
    current_hl="${2:-0}"

    local new_ttl="${p_ttl:-0}"
    local new_hl="${p_hl:-0}"

    if [ "$current_ttl" = "$new_ttl" ] && [ "$current_hl" = "$new_hl" ]; then
        mark_step_skipped "ttl_hl" "TTL/HL unchanged (TTL=$new_ttl, HL=$new_hl)"
        return
    fi

    mark_step_running "ttl_hl" "Applying TTL=$new_ttl, HL=$new_hl..."

    if ttl_state_apply "$new_ttl" "$new_hl" && ttl_state_write_persisted "$new_ttl" "$new_hl"; then
        mark_step_done "ttl_hl" "Applied TTL=$new_ttl, HL=$new_hl"
    else
        mark_step_failed "ttl_hl" "Failed to apply or persist TTL=$new_ttl, HL=$new_hl"
    fi
}

# --- Band failover watcher spawn ----------------------------------------------
# Parity with bands/lock.sh (the manual Band Locking page): a bad band lock can
# kill service, so lock.sh spawns qmanager_band_failover to poll AT+QCAINFO for
# ~30s and revert to all supported bands if no carrier is found. The profile
# apply pipeline sends the IDENTICAL AT+QNWPREFCFG band commands (via
# scenario_apply) for a custom scenario's bands, but had no such safety net —
# and once a profile binds a custom-* scenario, the gate matrix disables the
# Band Locking page itself, blocking the user's manual recovery route too.
# This closes that gap. Non-blocking, non-fatal: a spawn failure never affects
# the "scenario" step's done/partial/failed status.
_spawn_band_failover_if_needed() {
    local _bf_lte="$1"
    local _bf_nsa="$2"
    local _bf_sa="$3"

    # Never spawn for built-in scenarios or a custom scenario with no bands.
    if [ -z "$_bf_lte" ] && [ -z "$_bf_nsa" ] && [ -z "$_bf_sa" ]; then
        return 0
    fi

    local _bf_enabled="false"
    if [ -f "$FAILOVER_ENABLED_FILE" ]; then
        local _bf_val
        _bf_val=$(cat "$FAILOVER_ENABLED_FILE" 2>/dev/null | tr -d ' \n\r')
        [ "$_bf_val" = "1" ] && _bf_enabled="true"
    fi
    [ "$_bf_enabled" = "true" ] || return 0

    [ -x "$FAILOVER_SCRIPT" ] || { qlog_warn "Band failover enabled but watcher missing: $FAILOVER_SCRIPT"; return 0; }

    # Clear any previous activation flag — this lock supersedes it (same as lock.sh).
    rm -f "$FAILOVER_ACTIVATED_FLAG"

    # Kill any existing watcher (latest lock is the one we monitor)
    if [ -f "$FAILOVER_PID_FILE" ]; then
        local _bf_old_pid
        _bf_old_pid=$(cat "$FAILOVER_PID_FILE" 2>/dev/null | tr -d ' \n\r')
        if pid_alive "$_bf_old_pid"; then
            kill "$_bf_old_pid" 2>/dev/null
            qlog_debug "Killed previous failover watcher (PID=$_bf_old_pid)"
        fi
        rm -f "$FAILOVER_PID_FILE"
    fi

    # Spawn new watcher (detached via double-fork, same idiom as bands/lock.sh)
    ( "$FAILOVER_SCRIPT" </dev/null >/dev/null 2>&1 & )
    qlog_info "Failover watcher spawned for profile-applied band lock"
}

# =============================================================================
# Step 3: Scenario (radio mode + optional band locks)
# =============================================================================
apply_scenario() {
    mark_step_running "scenario" "Checking scenario binding..."

    # No scenario bound — skip cleanly
    if [ -z "$p_scenario_id" ]; then
        mark_step_skipped "scenario" "No scenario bound"
        return
    fi

    case "$p_scenario_id" in
        balanced|gaming|streaming)
            # Built-in scenario — scenario_apply resolves mode internally
            mark_step_running "scenario" "Applying scenario: $p_scenario_id..."
            if scenario_apply "$p_scenario_id"; then
                if [ -n "$_scenario_apply_failed" ]; then
                    # mode_pref succeeded but band lock(s) failed (partial)
                    scenario_set_active "$p_scenario_id"
                    mark_step_failed "scenario" "Partial: band lock failed for: $_scenario_apply_failed"
                else
                    scenario_set_active "$p_scenario_id"
                    mark_step_done "scenario" "Scenario $p_scenario_id applied"
                fi
            else
                mark_step_failed "scenario" "Failed to apply scenario $p_scenario_id (mode_pref AT error)"
            fi
            ;;
        custom-*)
            # Custom scenario — must look up config from disk
            mark_step_running "scenario" "Looking up custom scenario: $p_scenario_id..."
            local sc_json
            sc_json=$(scenario_lookup_custom "$p_scenario_id")
            if [ $? -ne 0 ] || [ -z "$sc_json" ]; then
                mark_step_skipped "scenario" "Scenario $p_scenario_id no longer exists"
                return
            fi

            # Parse mode and bands from the stored scenario JSON
            local sc_mode sc_lte sc_nsa sc_sa
            sc_mode=$(printf '%s' "$sc_json" | jq -r '.config.atModeValue // empty')
            sc_lte=$(printf '%s' "$sc_json"  | jq -r '.config.lte_bands // empty')
            sc_nsa=$(printf '%s' "$sc_json"  | jq -r '.config.nsa_nr_bands // empty')
            sc_sa=$(printf '%s' "$sc_json"   | jq -r '.config.sa_nr_bands // empty')

            if [ -z "$sc_mode" ]; then
                mark_step_failed "scenario" "Custom scenario $p_scenario_id has no mode configured"
                return
            fi

            mark_step_running "scenario" "Applying custom scenario: $p_scenario_id (mode=$sc_mode)..."
            if scenario_apply "$p_scenario_id" "$sc_mode" "$sc_lte" "$sc_nsa" "$sc_sa"; then
                # mode_pref landed, meaning any band-lock AT commands below it
                # were also sent (see scenario_apply) — arm the same safety net
                # the manual Band Locking page uses, on success OR partial band
                # failure alike, mirroring lock.sh which spawns unconditionally
                # once its single AT command is accepted.
                _spawn_band_failover_if_needed "$sc_lte" "$sc_nsa" "$sc_sa"
                if [ -n "$_scenario_apply_failed" ]; then
                    scenario_set_active "$p_scenario_id"
                    mark_step_failed "scenario" "Partial: band lock failed for: $_scenario_apply_failed"
                else
                    scenario_set_active "$p_scenario_id"
                    mark_step_done "scenario" "Custom scenario $p_scenario_id applied"
                fi
            else
                mark_step_failed "scenario" "Failed to apply custom scenario $p_scenario_id (mode_pref AT error)"
            fi
            ;;
        *)
            # scenario_id value is unrecognized — treat as a soft skip so
            # IMEI still runs. This guards against stale data from old profiles.
            mark_step_skipped "scenario" "Unrecognized scenario_id: $p_scenario_id"
            ;;
    esac
}

# =============================================================================
# Step 4: IMEI (most disruptive — last)
# =============================================================================
apply_imei() {
    mark_step_running "imei" "Checking IMEI..."

    # Skip if no IMEI specified in profile
    if [ -z "$p_imei" ]; then
        mark_step_skipped "imei" "No IMEI specified in profile"
        return
    fi

    # Read current IMEI
    local current_imei
    current_imei=$(run_at "AT+CGSN")
    if [ $? -ne 0 ]; then
        mark_step_failed "imei" "Failed to read current IMEI"
        return
    fi
    # Clean up the response (just the 15-digit IMEI)
    current_imei=$(printf '%s' "$current_imei" | grep -o '[0-9]\{15\}' | head -1)

    if [ "$current_imei" = "$p_imei" ]; then
        mark_step_skipped "imei" "IMEI already set to $p_imei"
        return
    fi

    mark_step_running "imei" "Writing IMEI ${p_imei}..."

    # Write new IMEI to modem NVM
    local resp
    resp=$(run_at "AT+EGMR=1,7,\"${p_imei}\"")
    if [ $? -ne 0 ]; then
        mark_step_failed "imei" "Failed to write IMEI"
        return
    fi

    sleep "$CMD_GAP"

    # Pre-set active profile before modem reboot — AT+CFUN=1,1 may trigger
    # a full system reboot on some configurations (USB bus reset), which would
    # kill this script before finalization. APN + TTL already applied above.
    set_active_profile "$PROFILE_ID"

    # Trigger modem reboot to apply IMEI
    apply_requires_reboot="true"
    mark_step_running "imei" "Rebooting modem to apply new IMEI..."
    write_state

    run_at "AT+CFUN=1,1" 2>/dev/null
    # After CFUN=1,1 the modem goes offline — serial commands will fail

    # Wait for modem to come back
    local waited=0
    local modem_back=0
    while [ "$waited" -lt "$REBOOT_TIMEOUT" ]; do
        sleep 2
        waited=$((waited + 2))
        local check
        check=$(qcmd "AT" 2>/dev/null)
        case "$check" in
            *OK*)
                modem_back=1
                break
                ;;
        esac
    done

    if [ "$modem_back" -eq 0 ]; then
        mark_step_failed "imei" "Modem did not respond after reboot (waited ${REBOOT_TIMEOUT}s)"
        return
    fi

    sleep 1

    # Verify new IMEI
    local verify_imei
    verify_imei=$(run_at "AT+CGSN")
    verify_imei=$(printf '%s' "$verify_imei" | grep -o '[0-9]\{15\}' | head -1)

    if [ "$verify_imei" = "$p_imei" ]; then
        mark_step_done "imei" "IMEI changed to $p_imei (modem rebooted)"
    else
        mark_step_failed "imei" "IMEI verify failed: expected $p_imei, got $verify_imei"
    fi
}

# =============================================================================
# EXECUTE ALL STEPS (ordered by impact: least disruptive first)
# =============================================================================
apply_apn
sleep "$CMD_GAP"

apply_ttl_hl
# No CMD_GAP — TTL doesn't use modem

apply_scenario
sleep "$CMD_GAP"

apply_imei

# =============================================================================
# FINALIZE
# =============================================================================

# --- Auto-mode pre-finalize stale-SIM guard ----------------------------------
# A rapid back-to-back switch can supersede this apply while it ran; committing
# the active marker now would pin the WRONG SIM's profile. Re-verify the live
# SIM still matches; on mismatch finalize as "failed" and do NOT write the
# marker. The EXIT trap's pending re-apply then reconciles to the current SIM.
# NOTE: the IMEI step pre-sets the marker before AT+CFUN=1,1; that reboot-bearing
# path is unchanged.
if [ -n "$AUTO_MODE" ] && ! _auto_sim_guard "pre-finalize"; then
    apply_status="failed"
    apply_error="superseded_sim_changed"
    write_state
    append_event "profile_failed" "Profile '$p_name' apply superseded — active SIM changed during apply" "warning"
    exit 0
fi

# Determine final status
if [ "$steps_failed" -gt 0 ] && [ "$steps_done" -gt 0 ]; then
    apply_status="partial"
    apply_error="$steps_failed step(s) failed, $steps_done succeeded"
elif [ "$steps_failed" -gt 0 ]; then
    apply_status="failed"
    apply_error="All steps failed"
else
    apply_status="complete"
fi

write_state

# Set active profile on success or partial success.
# Note: IMEI step pre-sets the active marker before AT+CFUN=1,1 (modem reboot
# may trigger a system reboot on some configs). Re-set here for the non-IMEI
# path, and clear on total failure.
if [ "$apply_status" = "complete" ] || [ "$apply_status" = "partial" ]; then
    set_active_profile "$PROFILE_ID"
    # Scenario binding side-effect (NOT a tracked apply step): arm the profile's
    # scenario schedule timer (no-op if the schedule is disabled — the helper
    # handles that internally).
    command -v scenario_install_schedule >/dev/null 2>&1 && scenario_install_schedule "$PROFILE_ID"
elif [ "$apply_status" = "failed" ]; then
    clear_active_profile
    command -v scenario_teardown_schedule >/dev/null 2>&1 && scenario_teardown_schedule
    command -v scenario_reset_to_default >/dev/null 2>&1 && scenario_reset_to_default
fi

# --- Emit network event ------------------------------------------------------
if [ "$apply_status" = "complete" ]; then
    append_event "profile_applied" "Profile '$p_name' applied successfully" "info"
elif [ "$apply_status" = "partial" ]; then
    append_event "profile_applied" "Profile '$p_name' partially applied ($steps_failed step(s) failed)" "warning"
else
    append_event "profile_failed" "Profile '$p_name' failed to apply ($steps_failed step(s) failed)" "error"
fi

qlog_info "Profile apply finished: status=$apply_status (done=$steps_done, failed=$steps_failed, skipped=$steps_skipped)"
