#!/bin/bash
# =============================================================================
# qmanager_tailscale_mgr — Privileged Tailscale install/uninstall helper
# =============================================================================
# Called by www-data CGI via sudo. Whitelisted in /etc/sudoers.d/qmanager.
#
# Usage:
#   qmanager_tailscale_mgr install        Download + install Tailscale ARM binary
#   qmanager_tailscale_mgr update [run]   `tailscale update` on an installed copy
#   qmanager_tailscale_mgr uninstall [run] Remove binaries, units, state
#   qmanager_tailscale_mgr ensure_units   Stage systemd units (called by installer)
#
# Install flow (rgmii-toolkit-aligned, validated 2026-04-10):
#   Two-layer execution — this wrapper writes an inner script and a temporary
#   systemd oneshot unit, then fires the unit and exits. The inner script runs
#   detached under systemd, independent of the caller's process lifetime.
#
#   Arch is 'arm'. The latest stable version and its published .sha256 are
#   resolved at install time (bounded curl, fail closed, no pinned fallback).
#   An update runs only on a coherent install (unit + both binaries); any
#   other leftover state is cleaned and reinstalled fresh.
#
#   The download streams through sha256sum into tar (no tarball on disk or in
#   /tmp); see docs/reference/tailscale.md. Systemd units
#   come from /usr/lib/qmanager/ (staged by the QManager installer).
#
# Progress reporting:
#   /tmp/qmanager_tailscale_install.json   — JSON status file polled by CGI
#   /tmp/qmanager_tailscale_install.pid    — Live install PID for concurrency
#   /tmp/qmanager_tailscale_install.log    — Inner script stdout/stderr
# =============================================================================

TAILSCALE_ARCH="arm"
TAILSCALE_DIR="/usrdata/tailscale"
TAILSCALE_SYSD_DIR="/usrdata/tailscale/systemd"
SYSTEMD_DIR="/lib/systemd/system"
WANTS_DIR="/lib/systemd/system/multi-user.target.wants"

INSTALL_RESULT="/tmp/qmanager_tailscale_install.json"
UPDATE_RUN_FILE="/tmp/qmanager_tailscale_update_run"
INSTALL_PID="/tmp/qmanager_tailscale_install.pid"
LOG_FILE="/tmp/qmanager_tailscale_install.log"

INNER_SCRIPT="/tmp/qmanager_tailscale_install_inner.sh"
TEMP_SERVICE_NAME="qmanager_tailscale_install.service"
TEMP_SERVICE_FILE="$SYSTEMD_DIR/$TEMP_SERVICE_NAME"

# --- Helpers ----------------------------------------------------------------

write_status() {
    printf '%s' "$1" > "$INSTALL_RESULT"
}

# Check if a PID is alive. Used to detect concurrent install attempts.
pid_is_alive() {
    [ -n "$1" ] && [ "$1" != "0" ] && kill -0 "$1" 2>/dev/null
}

# Coherent = unit and both binaries present; anything less is reinstalled fresh.
ts_coherent() {
    [ -f "$SYSTEMD_DIR/tailscaled.service" ] \
        && [ -x "$TAILSCALE_DIR/tailscale" ] && [ -x "$TAILSCALE_DIR/tailscaled" ]
}

# =============================================================================
# do_install — stage inner script, launch via temp systemd oneshot, return
# =============================================================================
do_install() {
    # Update runs carry an id the UI waits for; digits only, else none.
    run_id="$1"
    case "$run_id" in ''|*[!0-9]*) run_id="" ;; esac
    run_field=""
    [ -n "$run_id" ] && run_field=',"run":"'"$run_id"'"'

    # --- Concurrency guard ---
    if [ -f "$INSTALL_PID" ]; then
        existing=$(cat "$INSTALL_PID" 2>/dev/null | tr -d ' \n\r')
        if pid_is_alive "$existing"; then
            write_status '{"success":false,"status":"error","error":"install_in_progress","message":"Installation already in progress"}'
            echo "ERROR: installation already in progress (PID $existing)" >&2
            return 1
        fi
    fi

    # Remount rootfs read-write — needed to write the temp unit file and,
    # later inside the inner script, the live systemd unit.
    mount -o remount,rw / 2>/dev/null || true

    # Write initial status. The wrapper owns the PID file until the inner
    # script takes over (see MainPID polling below).
    echo $$ > "$INSTALL_PID"
    printf '%s' "$run_id" > "$UPDATE_RUN_FILE"
    if ts_coherent || [ -n "$run_id" ]; then
        write_status '{"success":true,"status":"running","op":"update"'"$run_field"',"message":"Starting Tailscale update..."}'
    else
        write_status '{"success":true,"status":"running","message":"Starting Tailscale install..."}'
    fi

    # Clean up stale temp install artifacts from prior runs.
    rm -f "$TEMP_SERVICE_FILE" "$INNER_SCRIPT"
    : > "$LOG_FILE"

    # --- Write the inner install script -------------------------------------
    # Quoted heredoc — inner ${VAR} references expand at runtime, not now.
    cat > "$INNER_SCRIPT" <<'INNER_EOF'
#!/bin/bash
# -----------------------------------------------------------------------------
# Inner install script — runs under qmanager_tailscale_install.service
# -----------------------------------------------------------------------------

export HOME=/usrdata/root
export PATH=/bin:/sbin:/usr/bin:/usr/sbin:/opt/bin:/opt/sbin:/usrdata/root/bin

TAILSCALE_ARCH="arm"
PKGS_BASE="https://pkgs.tailscale.com/stable"
TAILSCALE_DIR="/usrdata/tailscale"
TAILSCALE_SYSD_DIR="/usrdata/tailscale/systemd"
SYSTEMD_DIR="/lib/systemd/system"
WANTS_DIR="/lib/systemd/system/multi-user.target.wants"
QM_BUNDLED_UNIT="/usr/lib/qmanager/tailscaled.service"
QM_BUNDLED_DEFAULTS="/usr/lib/qmanager/tailscaled.defaults"
STATUS_FILE="/tmp/qmanager_tailscale_install.json"
INSTALL_PID="/tmp/qmanager_tailscale_install.pid"
LOG_FILE="/tmp/qmanager_tailscale_install.log"
UPDATE_RUN_FILE="/tmp/qmanager_tailscale_update_run"
RUN_FIELD=""
[ -s "$UPDATE_RUN_FILE" ] && RUN_FIELD=',"run":"'"$(cat "$UPDATE_RUN_FILE")"'"'
# A repair run started from the update button must still carry op + run id.
FX=""
[ -n "$RUN_FIELD" ] && FX=',"op":"update"'"$RUN_FIELD"

# Redirect own output to log file — more portable than systemd StandardOutput=append:
exec >> "$LOG_FILE" 2>&1

remount_rw() { mount -o remount,rw / 2>/dev/null || true; }
write_status() { printf '%s' "$1" > "$STATUS_FILE"; }

# No ro-restore here by design: qmanager_setup already remounts rw at boot and
# never remounts ro (see qmanager_auto_update_arm's "Left rw afterwards"
# comment), so the whole tree has converged on "remount rw once, leave it."
# Restoring ro from here would just create a brief, anomalous ro window that
# svc_enable/svc_disable (platform.sh) aren't written to expect. `sync` still
# runs — it flushes dirty UBIFS pages so the PID-file cleanup and any writes
# above survive an unclean power cycle, which is independent of mount mode.
# Ensure the PID file is cleaned up no matter how we exit (success, error, kill).
trap 'rm -f "$INSTALL_PID"; sync' EXIT

# Claim the PID file as the inner script — this is the process the CGI's
# pid_alive check tracks for the full install lifetime.
echo $$ > "$INSTALL_PID"

echo "=== qmanager_tailscale_mgr — install started ==="
echo "Arch:    $TAILSCALE_ARCH"
echo "Target:  $TAILSCALE_DIR"
echo

remount_rw

# Unit + both binaries; anything less is cleaned and reinstalled fresh.
ts_coherent() {
    [ -f "$SYSTEMD_DIR/tailscaled.service" ] \
        && [ -x "$TAILSCALE_DIR/tailscale" ] && [ -x "$TAILSCALE_DIR/tailscaled" ]
}

# -----------------------------------------------------------------------------
# Update path — coherent install: run `tailscale update` and exit
# -----------------------------------------------------------------------------
if ts_coherent; then
    echo "Tailscale already installed — running update..."
    write_status '{"success":true,"status":"running","op":"update"'"$RUN_FIELD"',"message":"Updating Tailscale..."}'

    mkdir -p /usrdata/root/bin
    ln -sf "$TAILSCALE_DIR/tailscale" /usrdata/root/bin/tailscale
    ln -sf "$TAILSCALE_DIR/tailscale" /usr/bin/tailscale

    mkdir -p /tmp/cache
    ln -sf /tmp/cache ~/.cache

    if ! echo y | "$TAILSCALE_DIR/tailscale" update; then
        write_status '{"success":false,"status":"error","op":"update"'"$RUN_FIELD"',"error":"update_failed","message":"Tailscale update failed"}'
        echo "=== ERROR: tailscale update failed ==="
        exit 1
    fi

    # Pick up the new binary; a service the user stopped stays stopped.
    systemctl is-active --quiet tailscaled && systemctl restart tailscaled

    write_status '{"success":true,"status":"complete","op":"update"'"$RUN_FIELD"',"message":"Tailscale updated"}'
    echo "=== update complete ==="
    exit 0
fi

# -----------------------------------------------------------------------------
# Fresh install
# -----------------------------------------------------------------------------
write_status '{"success":true,"status":"running"'"$FX"',"message":"Checking the latest Tailscale version..."}'

# Status for a failed lookup/download; curl exit 60 means the TLS clock check failed.
fail_net() {
    _detail="pkgs.tailscale.com unreachable — check internet connection"
    [ "$3" = "60" ] && _detail="TLS check failed — check the device clock and SIM"
    write_status '{"success":false,"status":"error"'"$FX"',"error":"'"$1"'","message":"'"$2"'","detail":"'"$_detail"'"}'
    echo "=== ERROR: $2 (curl rc $3) ==="
    exit 1
}

# Latest stable version + its published SHA-256. Fails closed; no pinned fallback.
echo "Resolving latest stable version..."
meta=$(curl -fsS --connect-timeout 15 -m 30 "$PKGS_BASE/?mode=json"); rc=$?
[ "$rc" -ne 0 ] && fail_net version_lookup_failed "Could not check the latest Tailscale version" "$rc"
TAILSCALE_VERSION=$(printf '%s' "$meta" | jq -r '.TarballsVersion // empty' 2>/dev/null)
case "$TAILSCALE_VERSION" in
    ''|*[!0-9.]*|.*|*.|*..*) TAILSCALE_VERSION="" ;;
    [0-9]*.[0-9]*.[0-9]*) ;;
    *) TAILSCALE_VERSION="" ;;
esac
[ -z "$TAILSCALE_VERSION" ] && fail_net version_lookup_failed "Could not check the latest Tailscale version" 0
TAILSCALE_TARBALL="tailscale_${TAILSCALE_VERSION}_${TAILSCALE_ARCH}.tgz"
TAILSCALE_URL="$PKGS_BASE/${TAILSCALE_TARBALL}"
TAILSCALE_EXTRACT_DIR="tailscale_${TAILSCALE_VERSION}_${TAILSCALE_ARCH}"
echo "Version: $TAILSCALE_VERSION"
echo "URL:     $TAILSCALE_URL"

sha_body=$(curl -fsS --connect-timeout 15 -m 30 "${TAILSCALE_URL}.sha256"); rc=$?
[ "$rc" -ne 0 ] && fail_net checksum_lookup_failed "Could not fetch the Tailscale checksum" "$rc"
TAILSCALE_SHA256=$(printf '%s' "$sha_body" | tr -d '\r' | awk 'NR==1 { print tolower($1) }')
case "$TAILSCALE_SHA256" in
    *[!0-9a-f]*) TAILSCALE_SHA256="" ;;
esac
[ "${#TAILSCALE_SHA256}" -ne 64 ] && fail_net checksum_lookup_failed "Could not fetch the Tailscale checksum" 0

write_status '{"success":true,"status":"running"'"$FX"',"message":"Installing Tailscale v'"$TAILSCALE_VERSION"'..."}'

cd /usrdata || { write_status '{"success":false,"status":"error"'"$FX"',"message":"Cannot cd /usrdata"}'; exit 1; }

free_now() { df -k /usrdata 2>/dev/null | awk 'END { print $4 }'; }
echo "Free space at start: $(free_now) KB"

# Only an incoherent install reaches here (a coherent one takes the update
# branch), so its binaries are already unusable. Free them and all residue
# first; tailscaled.state is kept so a repair does not log the node out.
echo "Cleaning leftovers..."
systemctl stop tailscaled 2>/dev/null || true
rm -f "$TAILSCALE_DIR/tailscale" "$TAILSCALE_DIR/tailscaled"
rm -rf "$TAILSCALE_SYSD_DIR" /usrdata/tailscale_*_"$TAILSCALE_ARCH"*
sync
free_kb=$(free_now)
echo "Free space after cleanup: ${free_kb} KB"
case "$free_kb" in ''|*[!0-9]*) free_kb=0 ;; esac
if [ "$free_kb" -lt 55000 ]; then
    write_status '{"success":false,"status":"error"'"$FX"',"error":"no_space","message":"Not enough free storage to install Tailscale","detail":"free up space on the modem and retry"}'
    echo "=== ERROR: only ${free_kb} KB free on /usrdata ==="
    exit 1
fi

# The tarball and its unpacked binaries do not fit together on the shared volume,
# so the download streams through sha256sum straight into tar and no tarball is
# written. The staging dir is only used after the checksum matches.
echo "Downloading and unpacking $TAILSCALE_TARBALL (streamed)..."
# Private 0700 dir: a fixed /tmp path would let another local user plant a symlink.
SHA_DIR=$(mktemp -d /tmp/qmanager_ts.XXXXXX) && chmod 700 "$SHA_DIR" \
    && SHA_FIFO="$SHA_DIR/sha.fifo" && SHA_OUT="$SHA_DIR/sha.out" \
    && mkfifo -m 600 "$SHA_FIFO" \
    || { rm -rf "$SHA_DIR"; write_status '{"success":false,"status":"error"'"$FX"',"error":"temp_failed","message":"Could not prepare the Tailscale install","detail":"temp directory unavailable"}'; exit 1; }
( sha256sum < "$SHA_FIFO" | awk '{ print $1 }' > "$SHA_OUT" ) &
sha_pid=$!
curl -fS --connect-timeout 20 --speed-limit 5000 --speed-time 60 -m 1000 -o - "$TAILSCALE_URL" | tee "$SHA_FIFO" \
    | { tar -xzf - "$TAILSCALE_EXTRACT_DIR/tailscale" "$TAILSCALE_EXTRACT_DIR/tailscaled"; _t=$?; cat >/dev/null; exit $_t; }
rcs=("${PIPESTATUS[@]}")
wait "$sha_pid"
actual_sha=$(cat "$SHA_OUT" 2>/dev/null)
rm -rf "$SHA_DIR"
echo "Free space after unpack: $(free_now) KB"

if [ "${rcs[0]}" -ne 0 ]; then
    rm -rf "$TAILSCALE_EXTRACT_DIR"
    fail_net download_failed "Failed to download Tailscale v$TAILSCALE_VERSION" "${rcs[0]}"
fi
if [ "${rcs[2]}" -ne 0 ]; then
    rm -rf "$TAILSCALE_EXTRACT_DIR"
    write_status '{"success":false,"status":"error"'"$FX"',"error":"extract_failed","message":"Could not unpack Tailscale","detail":"archive unreadable or storage full"}'
    echo "=== ERROR: unpack failed, free: $(free_now) KB ==="
    exit 1
fi
if [ -z "$actual_sha" ] || [ "$actual_sha" != "$TAILSCALE_SHA256" ]; then
    rm -rf "$TAILSCALE_EXTRACT_DIR"
    write_status '{"success":false,"status":"error"'"$FX"',"error":"checksum_mismatch","message":"Tailscale download failed verification","detail":"SHA-256 mismatch or sha256sum missing"}'
    exit 1
fi

echo "Creating directories..."
mkdir -p "$TAILSCALE_DIR" "$TAILSCALE_SYSD_DIR"
# www-data (CGI) needs traverse+read on these to detect the binary later.
chmod 755 "$TAILSCALE_DIR" "$TAILSCALE_SYSD_DIR"

if [ ! -d "$TAILSCALE_EXTRACT_DIR" ]; then
    write_status '{"success":false,"status":"error"'"$FX"',"message":"Extraction failed — no extract dir"}'
    exit 1
fi

cd "/usrdata/$TAILSCALE_EXTRACT_DIR" || exit 1
if [ ! -f tailscale ] || [ ! -f tailscaled ]; then
    write_status '{"success":false,"status":"error"'"$FX"',"message":"Extracted archive missing binaries"}'
    cd /usrdata || true
    rm -rf "$TAILSCALE_EXTRACT_DIR"
    exit 1
fi

mv tailscale tailscaled "$TAILSCALE_DIR/"
cd /usrdata || exit 1
rm -rf "$TAILSCALE_EXTRACT_DIR"

echo "Setting permissions..."
chmod +x "$TAILSCALE_DIR/tailscale" "$TAILSCALE_DIR/tailscaled"

# -----------------------------------------------------------------------------
# Install systemd units (bundled-first, inline fallback)
# -----------------------------------------------------------------------------
echo "Installing systemd units..."
if [ -f "$QM_BUNDLED_UNIT" ]; then
    echo "  using bundled unit from $QM_BUNDLED_UNIT"
    cp -f "$QM_BUNDLED_UNIT" "$TAILSCALE_SYSD_DIR/tailscaled.service"
else
    echo "  bundled unit missing — writing inline fallback"
    cat > "$TAILSCALE_SYSD_DIR/tailscaled.service" <<'UNITEOF'
[Unit]
Description=Tailscale node agent
Documentation=https://tailscale.com/kb/
Wants=network-pre.target
After=network-pre.target NetworkManager.service systemd-resolved.service

[Service]
EnvironmentFile=/usrdata/tailscale/systemd/tailscaled.defaults
ExecStartPre=/usrdata/tailscale/tailscaled --cleanup
ExecStart=/usrdata/tailscale/tailscaled --statedir=/usrdata/tailscale/ --port=${PORT} $FLAGS
ExecStartPost=/bin/chmod 755 /usrdata/tailscale
ExecStopPost=/usrdata/tailscale/tailscaled --cleanup
Restart=on-failure
RestartSec=5s
Type=notify

[Install]
WantedBy=multi-user.target
UNITEOF
fi

if [ -f "$QM_BUNDLED_DEFAULTS" ]; then
    echo "  using bundled defaults from $QM_BUNDLED_DEFAULTS"
    cp -f "$QM_BUNDLED_DEFAULTS" "$TAILSCALE_SYSD_DIR/tailscaled.defaults"
else
    echo "  bundled defaults missing — writing minimal defaults"
    printf 'PORT="41641"\nFLAGS=""\n' > "$TAILSCALE_SYSD_DIR/tailscaled.defaults"
fi

# Strip Windows line endings (installer bundles may have CRLF).
sed -i 's/\r$//' "$TAILSCALE_SYSD_DIR/tailscaled.service"
sed -i 's/\r$//' "$TAILSCALE_SYSD_DIR/tailscaled.defaults"

# Copy to /lib/systemd/system/ and link into wants.
cp -f "$TAILSCALE_SYSD_DIR/tailscaled.service" "$SYSTEMD_DIR/tailscaled.service"
ln -sf "$SYSTEMD_DIR/tailscaled.service" "$WANTS_DIR/tailscaled.service"

# -----------------------------------------------------------------------------
# Start daemon
# -----------------------------------------------------------------------------
write_status '{"success":true,"status":"running"'"$FX"',"message":"Starting Tailscale daemon..."}'
systemctl daemon-reload
sleep 2

echo "Starting tailscaled..."
systemctl start tailscaled

# -----------------------------------------------------------------------------
# CLI symlinks — BOTH required
#   /usrdata/root/bin/tailscale — matches rgmii-toolkit convention
#   /usr/bin/tailscale           — QManager's default root PATH includes this
# -----------------------------------------------------------------------------
mkdir -p /usrdata/root/bin
ln -sf /usrdata/tailscale/tailscale /usrdata/root/bin/tailscale
ln -sf /usrdata/tailscale/tailscale /usr/bin/tailscale

cd / || true

# -----------------------------------------------------------------------------
# Reload firewall so tailscale0 becomes a trusted interface (preserves the
# behavior of the old production script — qmanager-firewall trusts tailscale0
# when Tailscale is installed). reload swaps rules in place; restart would
# briefly drop them.
# -----------------------------------------------------------------------------
systemctl reload-or-restart qmanager-firewall 2>/dev/null || true

# -----------------------------------------------------------------------------
# Finalize
# -----------------------------------------------------------------------------
if [ -x "$TAILSCALE_DIR/tailscale" ] && [ -x "$TAILSCALE_DIR/tailscaled" ]; then
    write_status '{"success":true,"status":"complete"'"$FX"',"message":"Tailscale v'"$TAILSCALE_VERSION"' installed successfully"}'
    echo "=== Tailscale v${TAILSCALE_VERSION} installed successfully ==="
else
    write_status '{"success":false,"status":"error"'"$FX"',"message":"Install completed but binaries not found"}'
    echo "=== ERROR: binaries not found after install ==="
fi

# EXIT trap handles: rm -f INSTALL_PID + sync (no ro-restore — rootfs stays rw)
exit 0
INNER_EOF

    chmod +x "$INNER_SCRIPT"

    # --- Write the temporary oneshot systemd unit ---------------------------
    # Unquoted heredoc — $INNER_SCRIPT expands now.
    cat > "$TEMP_SERVICE_FILE" <<EOF
[Unit]
Description=QManager Tailscale install — temporary oneshot
DefaultDependencies=no

[Service]
Type=oneshot
TimeoutStartSec=1200
ExecStart=/bin/bash $INNER_SCRIPT
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
EOF

    # --- Launch and hand off PID tracking -----------------------------------
    systemctl daemon-reload
    systemctl start "$TEMP_SERVICE_NAME"

    # Capture the systemd MainPID of the oneshot so the CGI's pid_alive check
    # tracks the actual install process. Poll for up to 3 seconds — the inner
    # script takes over the PID file on its own, but this bridges the wrapper
    # hand-off window so the CGI never sees a stale/missing PID.
    main_pid=""
    for _ in 1 2 3; do
        sleep 1
        main_pid=$(systemctl show -p MainPID "$TEMP_SERVICE_NAME" 2>/dev/null | cut -d= -f2 | tr -d ' \n\r')
        if pid_is_alive "$main_pid"; then
            echo "$main_pid" > "$INSTALL_PID"
            break
        fi
    done

    # Wrapper exits here. The inner script keeps running under systemd, owns
    # the PID file via its own trap, and writes the final status JSON.
    return 0
}

# =============================================================================
# do_uninstall — stop daemon, remove binaries, units, symlinks, temp files
# =============================================================================
do_uninstall() {
    # The UI follows this run id to the terminal status; digits only, else none.
    run_id="$1"
    case "$run_id" in ''|*[!0-9]*) run_id="" ;; esac
    run_field=""
    [ -n "$run_id" ] && run_field=',"run":"'"$run_id"'"'

    # Hold the install lock so an install cannot start mid-removal.
    existing=$(cat "$INSTALL_PID" 2>/dev/null | tr -d ' \n\r')
    if pid_is_alive "$existing"; then
        write_status '{"success":false,"status":"error","op":"uninstall"'"$run_field"',"error":"install_in_progress","message":"An install or update is running"}'
        return 1
    fi
    echo $$ > "$INSTALL_PID"
    write_status '{"success":true,"status":"running","op":"uninstall"'"$run_field"',"message":"Removing Tailscale..."}'

    mount -o remount,rw / 2>/dev/null || true

    # Stop daemon if running.
    systemctl stop tailscaled 2>/dev/null || true

    # Remove boot symlink and live systemd unit.
    rm -f "$WANTS_DIR/tailscaled.service"
    rm -f "$SYSTEMD_DIR/tailscaled.service"
    systemctl daemon-reload 2>/dev/null || true

    # Remove the temporary install unit too, in case a prior install left it.
    rm -f "$TEMP_SERVICE_FILE"
    systemctl daemon-reload 2>/dev/null || true

    # Remove binaries, state, staging directory and tarball residue; retry once.
    # Glob is unquoted on purpose and cannot match $TAILSCALE_DIR itself.
    for _try in 1 2; do
        rm -rf "$TAILSCALE_DIR" /usrdata/tailscale_*_"$TAILSCALE_ARCH"*
        rm -f /usrdata/root/bin/tailscale /usr/bin/tailscale
        rm -f "$WANTS_DIR/tailscaled.service" "$SYSTEMD_DIR/tailscaled.service"
        [ -e "$TAILSCALE_DIR" ] || [ -L /usr/bin/tailscale ] || [ -L /usrdata/root/bin/tailscale ] \
            || [ -e "$SYSTEMD_DIR/tailscaled.service" ] || [ -L "$WANTS_DIR/tailscaled.service" ] \
            || break
        sleep 1
    done

    # Clean up runtime temp files.
    rm -f /tmp/qmanager_tailscale_auth_url \
          /tmp/qmanager_tailscale_up_output \
          /tmp/qmanager_tailscale_up_pid \
          "$UPDATE_RUN_FILE" \
          "$LOG_FILE" \
          "$INNER_SCRIPT"

    # Remove QManager-owned SSH intent flag so a reinstall starts off (explicit opt-in).
    rm -f /etc/qmanager/tailscale_ssh

    # Drop tailscale0 from the firewall's trusted set now the binary is gone.
    systemctl reload-or-restart qmanager-firewall 2>/dev/null || true

    # No ro-restore: rootfs stays rw (see docs/BACKEND.md §2.1). `sync` flushes
    # the removals to survive an unclean power loss.
    sync

    # Report leftovers instead of a silent partial state; the UI keeps showing
    # "installed" while the unit or directory remains, so the user can retry.
    left=""
    [ -e "$TAILSCALE_DIR" ] && left="$left dir"
    [ -e "$SYSTEMD_DIR/tailscaled.service" ] && left="$left unit"
    [ -L "$WANTS_DIR/tailscaled.service" ] && left="$left wants"
    { [ -L /usr/bin/tailscale ] || [ -L /usrdata/root/bin/tailscale ]; } && left="$left cli"
    if [ -n "$left" ]; then
        write_status '{"success":false,"status":"error","op":"uninstall"'"$run_field"',"error":"uninstall_incomplete","message":"Tailscale could not be fully removed","detail":"left:'"$left"'"}'
        rm -f "$INSTALL_PID"
        echo "ERROR: uninstall incomplete, left:$left" >&2
        return 1
    fi
    write_status '{"success":true,"status":"complete","op":"uninstall"'"$run_field"',"message":"Tailscale removed"}'
    rm -f "$INSTALL_PID"
    return 0
}

# =============================================================================
# do_ensure_units — stage bundled systemd units into /usrdata/tailscale/systemd/
# Called by the QManager installer before Tailscale itself is installed, so the
# units are in the staging dir even on a fresh install.
# =============================================================================
do_ensure_units() {
    mount -o remount,rw / 2>/dev/null || true
    mkdir -p "$TAILSCALE_SYSD_DIR"

    for f in tailscaled.service tailscaled.defaults; do
        src="/usr/lib/qmanager/$f"
        if [ -f "$src" ]; then
            cp -f "$src" "$TAILSCALE_SYSD_DIR/$f"
            sed -i 's/\r$//' "$TAILSCALE_SYSD_DIR/$f" 2>/dev/null || true
        fi
    done

    # No ro-restore: rootfs stays rw for the rest of uptime by project
    # convention (see qmanager_auto_update_arm's "Left rw afterwards" comment)
    # since qmanager_setup already remounted rw at boot and never restores.
    # `sync` still flushes the staged unit files above to survive an unclean
    # power loss.
    sync
}

# =============================================================================
# Main dispatch
# =============================================================================
case "${1:-}" in
    install)      do_install ;;
    update)
        # An incoherent install the UI shows as installed is repaired by the fresh branch.
        if [ ! -f "$SYSTEMD_DIR/tailscaled.service" ] && [ ! -e "$TAILSCALE_DIR/tailscale" ]; then
            echo "ERROR: Tailscale is not installed" >&2
            exit 1
        fi
        do_install "${2:-}"
        ;;
    uninstall)    do_uninstall "${2:-}"; exit $? ;;
    ensure_units) do_ensure_units ;;
    *)
        echo "Usage: qmanager_tailscale_mgr {install|update|uninstall|ensure_units}" >&2
        exit 1
        ;;
esac
