#!/bin/sh
# =============================================================================
# qmanager_setup — One-Shot Directory & Permission Setup (RM520N-GL)
# =============================================================================
# One-shot setup: creates directories, sets permissions, initializes config.
# Run once at boot by qmanager-setup.service before other services start.
#
# Install location: /usr/bin/qmanager_setup
# =============================================================================

# Remount root filesystem read-write if needed (RM520N-GL boots read-only)
if ! touch /usr/.qm_rw_test 2>/dev/null; then
    mount -o remount,rw / 2>/dev/null
fi
rm -f /usr/.qm_rw_test

# Ensure required directories exist
mkdir -p /var/lock /etc/qmanager /tmp/quecmanager
# /usr/lib/qmanager is created with an explicit 0755 rather than via `mkdir -p`,
# which honours the ambient umask. Root helpers (qmanager_*_apply, reachable by
# www-data through NOPASSWD sudo) `.` source libraries from here AS ROOT, and
# directory write permission governs delete-and-replace of those libraries — so
# a world-writable dir here is a root-code-execution vector. This runs on every
# boot, so it is also the last line of defence if the directory is ever removed
# and recreated outside the installer. See install_rm520n.sh's SECURITY note.
install -d -o root -g root -m 0755 /usr/lib/qmanager
# /var/spool/cron/crontabs is created (and its mode RE-ASSERTED) here for the
# same self-healing reason as /usr/lib/qmanager above, even though nothing on
# RM520N-GL runs crond — no unit, no boot symlink, no reader of this directory
# at all. It is kept only so qmanager_update's scrub_legacy_cron() has a
# stable path to scrub old QManager cron markers from on every OTA. It is
# CREATED AND RE-TIGHTENED here rather than simply left alone because
# QManager's own installer historically shipped it 0777 on persistent flash
# (ubi0:rootfs, not tmpfs) — a device that already booted the old `chmod 777
# /var/spool/cron/crontabs` line would stay world-writable forever if this
# were simply removed with nothing in its place. Running `install -d` on
# every boot self-heals those devices on their next reboot.
# A world-writable spool is a latent root-escalation vector even with no
# crond running today: scrub_legacy_cron writes a predictable
# "${cron_file}.tmp" inside it, and any future release (or a manually
# started crond) that read root's crontab would execute attacker-planted
# content as root.
install -d -o root -g root -m 0755 /var/spool/cron/crontabs

# AT device permissions — www-data (via dialout group) needs read/write access.
# Primary mechanism: /etc/udev/rules.d/99-qmanager-smd11.rules fires on the
# kernel "add" event and sets these same permissions. This block is a
# belt-and-suspenders fallback for the case where the device exists at boot
# but the udev rule didn't apply (e.g. udev not loaded yet, rule file missing,
# or upgrade in progress). It is idempotent — safe to run when permissions
# are already correct.
if [ -c /dev/smd11 ]; then
    chown root:dialout /dev/smd11
    chmod 660 /dev/smd11
fi

# Shared /tmp files — pre-created with correct ownership for fs.protected_regular=1.
# CRITICAL: RM520N-GL's sticky /tmp + protected_regular blocks O_CREAT and open-for-write
# unless file_owner==caller OR dir_owner==caller (root owns /tmp).
# Must match paths in /usr/bin/qcmd: LOCK_FILE and PID_FILE
#
# Strategy: files written by BOTH root (poller) and www-data (CGI) must be root-owned
# with mode 666. Files written by www-data only are www-data-owned.
#
# WHY root-owned and not www-data-owned: protected_regular's escape clause is
# "file_owner == dir_owner OR file_owner == caller". /tmp is root-owned, so a
# root-owned file satisfies the FIRST clause unconditionally and both UIDs may
# write it. A www-data-owned file satisfies neither clause for root — and there
# is no CAP_ override for this check — so root is locked out at ANY mode. The
# asymmetry is the whole reason this block exists; do not "simplify" it by
# giving everything to www-data.

# www-data-owned: opened READ-ONLY by root (qcmd holds the flock via `9<`), so
# root never needs write access and protected_regular never engages.
touch /tmp/qmanager_at.lock /tmp/qmanager_at.pid
chown www-data:www-data /tmp/qmanager_at.lock /tmp/qmanager_at.pid
chmod 666 /tmp/qmanager_at.lock /tmp/qmanager_at.pid

# Shared root-owned files — both root (poller/daemons) and www-data (CGI) write.
# If www-data owned these, root would be blocked by fs.protected_regular=1.
#
# profile_apply.pid / profile_state.json are here because qmanager_profile_apply
# runs as BOTH uids: www-data when profiles/apply.sh spawns it (no sudo), root
# when the poller or watchcat do. Both write them — profile_mgr.sh:732
# (`echo $$ >`) and write_state() respectively.
#
# events.json is here because events.sh's append is reached from root daemons
# AND from www-data CGI. It was previously seeded nowhere, so root's poller won
# the boot race and created it 0644, silently dropping every UI-originated event
# while still logging success.
#
# These writers MUST write in place (`>` / `>>` / `cat >`), never tmp+`mv`:
# rename() swaps the inode and replaces this seeded ownership with the writer's
# own uid at its umask, which is exactly how these files got broken before.
#
# DO NOT "complete the set" by adding /tmp/qmanager_recovery_active here. That
# path is a FLAG, not a data file: its mere EXISTENCE means "a recovery is in
# progress, suppress further recovery attempts". Pre-creating it at boot would
# leave the device permanently suppressed for the whole uptime.
#
# Seeding it 0666 specifically would be worse than seeding it at all. The claim
# logic treats a flag it can open for write as one it OWNS (_apn_rf_owned=1),
# but www-data cannot then unlink a root-owned file from sticky /tmp — so the
# flag stays raised forever. That path is unreachable today only because the
# only creator is root's `printf >`, which lands 0644 at umask 0022 and so
# correctly falls into the "cannot claim, proceed unsuppressed" branch. A 0666
# seed would make the stuck path the DEFAULT one.
#
# /tmp/qmanager_tower_write_inflight belongs in this list rather than with the
# flags above. It is a CONTENT-BEARING file -- it holds a deadline timestamp
# that the failover watcher parses -- not an existence-only flag, so the
# "do not seed a flag" exception does not apply to it. Both UIDs write it:
# www-data from tower/lock.sh under lighttpd, and root from
# qmanager_tower_schedule. /tmp is tmpfs, so without a seed whichever UID
# calls tower_write_begin() FIRST after a boot owns the file for the rest of
# that uptime, and the other one's writes are refused for good -- silently,
# since tower_write_begin sends stderr to /dev/null. The loser then stops
# marking its AT writes as in-flight, and the watcher can read the reconnect
# blip as a genuine bad sample: the exact race the marker exists to prevent.
touch /tmp/qmanager.log \
      /tmp/qmanager_profile_apply.pid /tmp/qmanager_profile_state.json \
      /tmp/qmanager_events.json /tmp/qmanager_tower_write_inflight \
      /tmp/qmanager_dpi_install.json /tmp/qmanager_dpi_install.pid \
      /tmp/qmanager_dpi_verify.json /tmp/qmanager_dpi_verify.pid
chown root:root /tmp/qmanager.log \
      /tmp/qmanager_profile_apply.pid /tmp/qmanager_profile_state.json \
      /tmp/qmanager_events.json /tmp/qmanager_tower_write_inflight \
      /tmp/qmanager_dpi_install.json /tmp/qmanager_dpi_install.pid \
      /tmp/qmanager_dpi_verify.json /tmp/qmanager_dpi_verify.pid
chmod 666 /tmp/qmanager.log \
      /tmp/qmanager_profile_apply.pid /tmp/qmanager_profile_state.json \
      /tmp/qmanager_events.json /tmp/qmanager_tower_write_inflight \
      /tmp/qmanager_dpi_install.json /tmp/qmanager_dpi_install.pid \
      /tmp/qmanager_dpi_verify.json /tmp/qmanager_dpi_verify.pid

# Session directory — www-data needs write access (cleared on reboot since /tmp is tmpfs)
mkdir -p /tmp/qmanager_sessions
chown www-data:www-data /tmp/qmanager_sessions
chmod 700 /tmp/qmanager_sessions

# Config directory — www-data needs write access for auth.json, profiles
#
# WARNING: this is recursive and has NO exclusion list, so it runs on EVERY
# boot and flattens the ownership of everything under /etc/qmanager. Any file
# here that an installer pins to root:root is silently re-owned to www-data at
# the next reboot — the pin has a lifetime of exactly one boot cycle. This
# already cost us one real privilege-escalation bug: the systemd
# EnvironmentFile for four root daemons used to live at
# /etc/qmanager/environment with an install-time root:root carve-out, and
# fielded devices were found with it www-data-owned and directly writable.
#
# So: a file that must NOT be www-data-writable does not belong in this
# directory at all. Move it out (the EnvironmentFile now lives at
# /etc/qmanager.env) rather than adding an exclusion here. Adding exclusions
# does not scale — the directory is www-data-owned, so www-data can unlink and
# replace any file in it regardless of that file's own owner or mode.
chown -R www-data:www-data /etc/qmanager

# Make all qmanager binaries executable
for f in /usr/bin/qmanager_*; do
    [ -f "$f" ] && chmod +x "$f"
done

# Make all CGI scripts executable
CGI_DIR="/usrdata/qmanager/www/cgi-bin/quecmanager"
for f in "$CGI_DIR"/*.sh "$CGI_DIR"/*/*.sh; do
    [ -f "$f" ] && chmod +x "$f"
done

# Tailscale directory — tailscaled resets its state dir to 700 on start;
# www-data CGI needs traverse+read to check if binaries exist
if [ -d /usrdata/tailscale ]; then
    chmod 755 /usrdata/tailscale
fi

# Secure auth config
[ -f /etc/qmanager/auth.json ] && chmod 600 /etc/qmanager/auth.json

# Create default long_commands.list if missing
if [ ! -f /etc/qmanager/long_commands.list ]; then
    cat > /etc/qmanager/long_commands.list << 'EOF'
# QManager Long Commands List
QSCAN
QSCANFREQ
QFOTADL
EOF
fi

# Seed the default Video Optimizer hostlist if missing. www-data edits this
# file directly from the UI (it lives in the www-data-owned /etc/qmanager
# directory — it is DATA, never executed, so www-data ownership is fine),
# so the seed is chowned immediately rather than waiting for the recursive
# chown above on the next boot.
DPI_HOSTLIST="/etc/qmanager/video_domains.txt"
if [ ! -f "$DPI_HOSTLIST" ]; then
    cat > "$DPI_HOSTLIST" << 'EOF'
# QManager Video Optimizer hostlist — one domain per line, no wildcards.
# Connections to these domains get desync treatment; everything else passes
# through untouched.
youtube.com
googlevideo.com
ytimg.com
ggpht.com
youtu.be
facebook.com
fbcdn.net
instagram.com
cdninstagram.com
tiktok.com
tiktokcdn.com
tiktokv.com
snapchat.com
sc-cdn.net
netflix.com
nflxvideo.net
disneyplus.com
cloudfront.net
akamaized.net
speedtest.net
ookla.com
EOF
    chown www-data:www-data "$DPI_HOSTLIST"
    chmod 644 "$DPI_HOSTLIST"
fi

# Factory-default copy for restore_hostlist. Always ensured (not just on the
# fresh seed above), so an upgrade that predates this file gets it too.
# www-data owns /etc/qmanager — the default file is data, never executed.
if [ ! -f "/etc/qmanager/video_domains_default.txt" ]; then
    cp "$DPI_HOSTLIST" "/etc/qmanager/video_domains_default.txt"
    chown www-data:www-data "/etc/qmanager/video_domains_default.txt"
    chmod 644 "/etc/qmanager/video_domains_default.txt"
fi

# Initialize default JSON config if missing
if [ -f /usr/lib/qmanager/config.sh ]; then
    . /usr/lib/qmanager/config.sh
    qm_config_init
fi
