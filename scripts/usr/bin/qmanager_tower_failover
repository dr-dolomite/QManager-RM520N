#!/bin/sh
# =============================================================================
# qmanager_tower_failover — Tower Lock Failover Daemon
# =============================================================================
# Monitors signal quality and clears tower locks if signal degrades below
# the configured threshold. Reads signal data from the poller's cached JSON
# at /tmp/qmanager_status.json (no AT commands, no modem contention).
#
# Managed by qmanager-tower-failover.service (start/stop).
# All callers (CGI, cron, boot) go through init.d.
#
# Files:
#   PID:    /tmp/qmanager_tower_failover.pid
#   Flag:   /tmp/qmanager_tower_failover  (written on failover activation)
#   Config: /etc/qmanager/tower_lock.json
#   Cache:  /tmp/qmanager_status.json     (read-only)
#
# Dependencies: jq, tower_lock_mgr.sh, qlog.sh
# Install location: /usr/bin/qmanager_tower_failover
# =============================================================================

# --- Logging -----------------------------------------------------------------
. /usr/lib/qmanager/qlog.sh 2>/dev/null || {
    qlog_init() { :; }
    qlog_debug() { :; }
    qlog_info() { :; }
    qlog_warn() { :; }
    qlog_error() { :; }
}
qlog_init "tower_failover"

# --- Load tower lock library -------------------------------------------------
[ -f /usr/lib/qmanager/tower_lock_mgr.sh ] && . /usr/lib/qmanager/tower_lock_mgr.sh 2>/dev/null

# --- Load events library (for append_event) ----------------------------------
[ -f /usr/lib/qmanager/events.sh ] && . /usr/lib/qmanager/events.sh 2>/dev/null

# --- Constants ---------------------------------------------------------------
PID_FILE="/tmp/qmanager_tower_failover.pid"
FLAG_FILE="/tmp/qmanager_tower_failover"
CACHE="/tmp/qmanager_status.json"
SETTLE=20          # seconds before first check (modem reconnects after lock)
INTERVAL=20        # seconds between checks
BAD_LIMIT=3        # consecutive bad readings before failover
CONFIG_EVERY=6     # re-read config every N cycles

# --- Traps (single registration to avoid BusyBox conflicts) -----------------
cleanup() { rm -f "$PID_FILE"; }
trap cleanup EXIT INT TERM

# --- Write PID ---------------------------------------------------------------
echo $$ > "$PID_FILE"
qlog_info "Daemon started (PID=$$), settling ${SETTLE}s"

# --- Settle ------------------------------------------------------------------
i=0
while [ "$i" -lt "$SETTLE" ]; do
    sleep 1
    i=$((i + 1))
done

# --- Read initial threshold --------------------------------------------------
threshold=$(tower_config_get ".failover.threshold")
[ -z "$threshold" ] && threshold=20
qlog_info "Active: interval=${INTERVAL}s threshold=${threshold}% bad_limit=${BAD_LIMIT}"

# --- Main loop ---------------------------------------------------------------
bad=0
cycle=0

while true; do
    cycle=$((cycle + 1))

    # --- Periodic config validation ------------------------------------------
    if [ $((cycle % CONFIG_EVERY)) -eq 0 ]; then
        lte_on=$(tower_config_get ".lte.enabled")
        nr_on=$(tower_config_get ".nr_sa.enabled")
        if [ "$lte_on" != "true" ] && [ "$nr_on" != "true" ]; then
            qlog_info "No active locks — exiting"
            exit 0
        fi
        new_thr=$(tower_config_get ".failover.threshold")
        if [ -n "$new_thr" ] && [ "$new_thr" != "$threshold" ]; then
            threshold="$new_thr"
            qlog_info "Threshold updated to ${threshold}%"
        fi
    fi

    # --- Read signal from poller cache ---------------------------------------
    if [ ! -f "$CACHE" ]; then
        qlog_debug "No status cache — skipping"
        sleep "$INTERVAL"
        continue
    fi

    modem_ok=$(jq -r '.modem_reachable // false' "$CACHE" 2>/dev/null)
    if [ "$modem_ok" != "true" ]; then
        qlog_debug "Modem unreachable — skipping"
        sleep "$INTERVAL"
        continue
    fi

    # Prefer LTE RSRP, fall back to NR
    rsrp=$(jq -r '.lte.rsrp // empty' "$CACHE" 2>/dev/null)
    [ -z "$rsrp" ] && rsrp=$(jq -r '.nr.rsrp // empty' "$CACHE" 2>/dev/null)

    # Validate: must be a negative number
    case "$rsrp" in
        -[0-9]*) ;;
        *) rsrp="" ;;
    esac

    if [ -z "$rsrp" ]; then
        quality=0
        qlog_debug "No RSRP — quality=0%"
    else
        quality=$(calc_signal_quality "$rsrp")
    fi

    # --- Evaluate ------------------------------------------------------------
    if [ "$quality" -lt "$threshold" ]; then
        bad=$((bad + 1))
        qlog_warn "Below threshold: ${quality}% < ${threshold}%, bad=${bad}/${BAD_LIMIT}"

        if [ "$bad" -ge "$BAD_LIMIT" ]; then
            qlog_warn "FAILOVER: ${BAD_LIMIT} consecutive bad — clearing locks"

            # tower_unlock_lte / tower_unlock_nr already return qcmd's real
            # exit status (see tower_lock_mgr.sh) — the old text match
            # against stdout could never see "ERROR" there, so a single
            # shared `ok` flag was unconditionally forced to 1 by whichever
            # case ran last. That was harmless while the check was dead, but
            # now that rc detection actually works, an OR'd single flag
            # would report "FAILOVER COMPLETE" if e.g. only the NR unlock
            # succeeded while LTE stayed locked. Track each RAT separately
            # and require BOTH before claiming the modem is actually clear.
            lte_ok=0
            lte_r=$(tower_unlock_lte 2>/dev/null)
            lte_rc=$?
            if [ $lte_rc -eq 0 ]; then
                lte_ok=1
            else
                qlog_error "LTE unlock failed (rc=$lte_rc): $lte_r"
            fi

            sleep 0.2

            nr_ok=0
            nr_r=$(tower_unlock_nr 2>/dev/null)
            nr_rc=$?
            if [ $nr_rc -eq 0 ]; then
                nr_ok=1
            else
                qlog_error "NR unlock failed (rc=$nr_rc): $nr_r"
            fi

            if [ "$lte_ok" -eq 1 ] && [ "$nr_ok" -eq 1 ]; then
                tower_config_update '.lte.enabled = false | .nr_sa.enabled = false'
                echo "activated" > "$FLAG_FILE"
                qlog_warn "FAILOVER COMPLETE — locks cleared"
                append_event "tower_failover" "Tower locks cleared — signal quality ${quality}% below ${threshold}% threshold" "warning"
            else
                qlog_error "FAILOVER FAILED — retrying in 5s"
                sleep 5

                # Retry path — this was NEVER reachable before this fix (ok
                # was always 1 above), so it ran unverified in production.
                # It unconditionally claimed "FAILOVER COMPLETE (retry)" and
                # wrote the activated flag even when the retry itself also
                # failed. Give it the same real per-RAT rc check as the
                # first attempt (both must succeed) instead of discarding
                # the result.
                lte_retry_ok=0
                lte_retry=$(tower_unlock_lte 2>/dev/null)
                lte_retry_rc=$?
                if [ $lte_retry_rc -eq 0 ]; then
                    lte_retry_ok=1
                else
                    qlog_error "LTE unlock retry failed (rc=$lte_retry_rc): $lte_retry"
                fi

                sleep 0.2

                nr_retry_ok=0
                nr_retry=$(tower_unlock_nr 2>/dev/null)
                nr_retry_rc=$?
                if [ $nr_retry_rc -eq 0 ]; then
                    nr_retry_ok=1
                else
                    qlog_error "NR unlock retry failed (rc=$nr_retry_rc): $nr_retry"
                fi

                if [ "$lte_retry_ok" -eq 1 ] && [ "$nr_retry_ok" -eq 1 ]; then
                    tower_config_update '.lte.enabled = false | .nr_sa.enabled = false'
                    echo "activated" > "$FLAG_FILE"
                    qlog_warn "FAILOVER COMPLETE (retry)"
                    append_event "tower_failover" "Tower locks cleared after retry — signal quality ${quality}% below ${threshold}% threshold" "warning"
                else
                    # Both attempts failed on both RATs: the modem may still
                    # be locked. Do NOT write the activated flag or claim
                    # success — the daemon still exits below (unchanged
                    # control flow), so nothing will retry this again until
                    # the next config apply re-arms the watcher. Flagged in
                    # the sweep report as a residual gap, not fixed here.
                    qlog_error "FAILOVER RETRY FAILED — tower locks may still be active; daemon exiting without confirming failover"
                    append_event "tower_failover" "Tower failover retry failed — locks may still be active (signal ${quality}% below ${threshold}% threshold)" "error"
                fi
            fi

            # Re-apply custom MTU after interface bounce
            mtu_reapply_after_bounce

            exit 0
        fi
    else
        if [ "$bad" -gt 0 ]; then
            qlog_info "Signal recovered: ${quality}% (was bad=${bad})"
        else
            qlog_debug "OK: ${quality}% (RSRP=${rsrp:-?})"
        fi
        bad=0
    fi

    sleep "$INTERVAL"
done
