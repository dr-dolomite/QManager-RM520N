#!/bin/sh
# =============================================================================
# qmanager_sms_forward — QManager SMS Forwarding Daemon (RM520N-GL / systemd)
# =============================================================================
# Forwards each NEW inbound SMS (ME + SM) to a configured phone number as
# "From <sender>: <content>". Reads and sends through qsms (QMI WMS), which
# needs no AT lock. Design and invariants: docs/reference/sms-forwarding.md.
#
# Config: /etc/qmanager/sms_forwarding.json  { "enabled": bool, "target_phone": string }
# Output: /tmp/qmanager_sms_forward_failures.json (array, read by the CGI)
# State:  /tmp/qmanager_sms_forward_seen (one fingerprint per line, tmpfs)
#         /tmp/qmanager_sms_forward_pending (incomplete multi-part groups, tmpfs)
# Reload: /tmp/qmanager_sms_forward_reload (flag file, touched by the CGI)
#
# Wake-up: `qsms watch` prints "<ME|SM> <index>" per arrival; the supervisor
# feeds it through a FIFO. Without a live watch the loop polls every
# SF_INTERVAL; with one it lists only the named storage, plus ME (and an unseeded
# or failed SM) every SAFETY_INTERVAL.
#
# Install location: /usr/bin/qmanager_sms_forward
# Dependencies: qsms, jq, awk, md5sum, mkfifo, qcmd
# =============================================================================

# --- Logging -----------------------------------------------------------------
# Guarded with -f: BusyBox ash exits when `.` cannot find its file.
if [ -f /usr/lib/qmanager/qlog.sh ]; then
    . /usr/lib/qmanager/qlog.sh
else
    qlog_init() { :; }
    qlog_debug() { :; }
    qlog_info() { :; }
    qlog_warn() { :; }
    qlog_error() { :; }
    qlog_state_change() { :; }
fi
qlog_init "sms_forward"

# --- Configuration (defaults; load_config re-reads the JSON each reload) -----
SF_ENABLED=0
SF_TARGET=""
SF_INTERVAL=15
SAFETY_INTERVAL=300
GROUP_TIMEOUT=600

# --- File Paths ---------------------------------------------------------------
CONFIG="/etc/qmanager/sms_forwarding.json"
PID_FILE="/tmp/qmanager_sms_forward.pid"
RELOAD_FLAG="/tmp/qmanager_sms_forward_reload"
SEEN_FILE="/tmp/qmanager_sms_forward_seen"
PENDING_FILE="/tmp/qmanager_sms_forward_pending"
PENDING_NEW="/tmp/qmanager_sms_forward_pending.new"
PENDING_TMP="/tmp/qmanager_sms_forward_pending.tmp"
EVENT_FIFO="/tmp/qmanager_sms_forward_events"
FAILURES_FILE="/tmp/qmanager_sms_forward_failures.json"
FAILURES_TMP="/tmp/qmanager_sms_forward_failures.json.tmp"

QSMS="/usr/bin/qsms"

MAX_FAILURES=20

# --- Runtime state -----------------------------------------------------------
NOW=0
LAST_FULL=0
WATCH_UP=0
WATCHER_PID=""
WATCH_GONE=0   # 1 once qsms watch reported it is permanently unavailable (rc 2)
_sf_sleep_pid=""
FIFO_OK=0
EV_ME=0
EV_SM=0
EV_FULL=0
SEEDED_ME=0
SEEDED_SM=0
CK_ME=""
CK_SM=""
SCAN_SEED=0
SCAN_FAILING=0
SM_RETRY=0

# Merge one storage's `qsms list` output: singles pass through; concatenated parts group by
# sender|reference|total, split where part timestamps are >24 h apart (reference reuse).
SF_MERGE_JQ='
def s: if . == null then "" else tostring end;
def ep: try (strptime("%m/%d/%y %H:%M:%S") | mktime) catch 0;
def clusters: reduce .[] as $m ([]; if length > 0 and ($m.ep - .[-1][-1].ep) <= 86400
    then .[-1] += [$m] else . + [[$m]] end);
[.msg[]? | . + {storage: $st}] as $all
| [ $all[] | select(.reference == null)
    | {sender: (.sender|s), content: (.content|s), timestamp: (.timestamp|s),
       storage: .storage, gkey: "", gts: 0, complete: true, parts: 1, total: 0} ] as $singles
| ( [ $all[] | select(.reference != null) | . + {ep: (.timestamp|s|ep)} ]
    | group_by((.sender|s) + "|" + (.reference|tostring) + "|" + (.total|s))
    | map(sort_by(.ep) | clusters[])
    | map( (map(.ep) | min) as $gts | unique_by(.part) | . as $p
        | (if $p[0].total == null then 0 else $p[0].total end) as $t
        | { sender: ($p[0].sender|s),
            content: ([$p[].content|s] | join("")),
            timestamp: ($p[0].timestamp|s),
            storage: $p[0].storage,
            gkey: ($p[0].storage + "|" + ($p[0].sender|s) + "|" + ($p[0].reference|tostring)
                   + "|" + ($t|tostring)),
            gts: $gts,
            complete: ($t <= 0 or ($p|length) >= $t),
            parts: ($p|length),
            total: $t } ) ) as $grouped
| $singles + $grouped
'

# =============================================================================
# HELPERS
# =============================================================================

# --- Monotonic seconds (the wall clock steps from 1970 shortly after boot) ---
sf_now() {
    read -r _up _ < /proc/uptime 2>/dev/null
    NOW="${_up%%.*}"
    case "$NOW" in
        ''|*[!0-9]*) NOW=0 ;;
    esac
}

# --- Load config from /etc/qmanager/sms_forwarding.json ----------------------
# A missing file reads as enabled=false, target_phone="" — lazy-create is
# owned by the CGI (tmp+mv on first save_settings); this daemon never writes
# CONFIG.
load_config() {
    if [ -f "$CONFIG" ]; then
        _en=$(jq -r '(.enabled) | if . == null then "false" else tostring end' "$CONFIG" 2>/dev/null)
        _tp=$(jq -r '.target_phone // ""' "$CONFIG" 2>/dev/null)
    else
        _en="false"
        _tp=""
    fi

    case "$_en" in
        true) SF_ENABLED=1 ;;
        *) SF_ENABLED=0 ;;
    esac
    SF_TARGET="${_tp:-}"
}

# --- Validate the target phone (E.164-ish, mirrors _validate_phone) ----------
# Returns 0 if usable, 1 otherwise. Does NOT mutate SF_TARGET.
sf_target_valid() {
    _vp=$(printf '%s' "$SF_TARGET" | sed 's/^+//')
    case "$_vp" in
        ''|*[!0-9]*) return 1 ;;
    esac
    _vp_len=${#_vp}
    if [ "$_vp_len" -lt 7 ] || [ "$_vp_len" -gt 15 ]; then
        return 1
    fi
    _vp_first=$(printf '%s' "$_vp" | cut -c1)
    [ "$_vp_first" = "0" ] && return 1
    return 0
}

# --- djb2 fingerprint --------------------------------------------------------
# djb2 mod 2^32 in BusyBox awk (% 4294967296 each step keeps it inside the
# double mantissa). Internal to this daemon; never compared with the frontend.
sf_fingerprint() {
    awk -v s="$1" '
        BEGIN {
            h = 5381
            n = length(s)
            for (i = 1; i <= n; i++) {
                c = substr(s, i, 1)
                h = (h * 33 + sf_ord(c)) % 4294967296
            }
            printf "%.0f", h
        }
        function sf_ord(ch,    k) {
            if (_ord_built != 1) {
                for (k = 0; k < 256; k++) _ord[sprintf("%c", k)] = k
                _ord_built = 1
            }
            return _ord[ch]
        }
    '
}

# --- Read + merge one storage's inbox into a JSON array ----------------------
# Prints [{sender,content,timestamp,storage,gkey,gts,complete,parts,total}].
# Returns 1 when qsms fails, so a failed read is never mistaken for an empty inbox.
sf_read_inbox() {
    _ri=$("$QSMS" list "$1" 2>/dev/null </dev/null)
    printf '%s' "$_ri" | jq -e '.success == true and ((.storage_errors // {}) | length == 0)' >/dev/null 2>&1 || return 1
    printf '%s' "$_ri" | jq -c --arg st "$1" "$SF_MERGE_JQ" 2>/dev/null
}

# --- Loop-guard test: does content look like one of OUR relays? --------------
# Our relay format is "From <number>: <body>". Skip those so we never forward
# our own forwarded messages back out. Returns 0 if it looks like a relay.
sf_is_relay() {
    case "$1" in
        "From "*": "*)
            # Extract the token between "From " and the first ": " and confirm
            # it is a phone-ish number (optional +, then digits only).
            _frm="${1#From }"
            _num="${_frm%%: *}"
            _numchk=$(printf '%s' "$_num" | sed 's/^+//')
            case "$_numchk" in
                ''|*[!0-9]*) return 1 ;;
                *) return 0 ;;
            esac
            ;;
        *) return 1 ;;
    esac
}

# --- Append a failure record to FAILURES_FILE (capped at MAX_FAILURES) ------
sf_record_failure() {
    _f_sender="$1"
    _f_ts="$2"
    _f_err="$3"

    _existing="[]"
    if [ -f "$FAILURES_FILE" ] && [ -s "$FAILURES_FILE" ]; then
        _existing=$(jq -c '.' "$FAILURES_FILE" 2>/dev/null)
        printf '%s' "$_existing" | jq -e 'type == "array"' >/dev/null 2>&1 || _existing="[]"
    fi

    printf '%s' "$_existing" | jq -c \
        --arg sender "$_f_sender" \
        --arg timestamp "$_f_ts" \
        --arg last_error "$_f_err" \
        '. + [{sender:$sender, timestamp:$timestamp, last_error:$last_error}] | .[-'"$MAX_FAILURES"':]' \
        > "$FAILURES_TMP" 2>/dev/null

    if [ -s "$FAILURES_TMP" ]; then
        mv "$FAILURES_TMP" "$FAILURES_FILE"
    else
        rm -f "$FAILURES_TMP"
    fi
}

# --- Registration check (via qcmd) -------------------------------------------
# Registered when AT+CREG? or AT+CGREG? reports stat 1 (home) or 5 (roaming).
# qcmd takes the AT lock itself.
sf_is_registered() {
    _reg=$(qcmd 'AT+CREG?' 2>/dev/null)
    _stat=$(printf '%s' "$_reg" | grep '+CREG:' | head -n 1 | sed 's/.*+CREG:[[:space:]]*[0-9]*,\([0-9]*\).*/\1/')
    case "$_stat" in
        1|5) return 0 ;;
    esac

    _reg=$(qcmd 'AT+CGREG?' 2>/dev/null)
    _stat=$(printf '%s' "$_reg" | grep '+CGREG:' | head -n 1 | sed 's/.*+CGREG:[[:space:]]*[0-9]*,\([0-9]*\).*/\1/')
    case "$_stat" in
        1|5) return 0 ;;
    esac

    return 1
}

# --- Send one forwarded message with 3-attempt / 5s-retry --------------------
# Returns 0 on success; on failure prints a plain-language reason (qsms's
# .detail, never raw JSON) to stdout and returns 1.
sf_send_with_retry() {
    _send_target="$1"
    _send_body="$2"
    _attempt=0
    _max_attempts=3
    _retry_delay=5
    _last_err=""

    if [ ! -x "$QSMS" ]; then
        printf '%s' "The SMS service is not installed."
        return 1
    fi

    while [ "$_attempt" -lt "$_max_attempts" ]; do
        _attempt=$((_attempt + 1))

        if [ "$_attempt" -gt 1 ]; then
            sleep "$_retry_delay"
        fi

        if ! sf_is_registered; then
            qlog_warn "SMS forward: attempt $_attempt/$_max_attempts skipped (not registered)"
            _last_err="modem not registered"
            continue
        fi

        _out=$("$QSMS" send "$_send_target" "$_send_body" 2>/dev/null </dev/null)
        _rc=$?

        if [ "$_rc" -eq 0 ]; then
            qlog_info "SMS forward: send succeeded on attempt $_attempt"
            return 0
        fi

        _detail=$(printf '%s' "$_out" | jq -r 'if (.detail | type) == "string" then .detail else "" end' 2>/dev/null)
        [ -z "$_detail" ] && _detail="The message could not be sent."
        _last_err="$_detail"
        qlog_warn "SMS forward: send failed attempt $_attempt/$_max_attempts (rc=$_rc) — $_detail"
        # A retry resends every part. Once any part went out, stop; except one
        # resume of the missing parts when the broker says the failure was a definite reject.
        set -- $(printf '%s' "$_out" | jq -r '[(.sent_parts // 0 | tostring), (.ambiguous | tostring),
            (if (.concat_ref | type) == "number" then (.concat_ref | tostring) else "" end)] | join(" ")' 2>/dev/null)
        _sp="${1:-0}"; _amb="${2:-null}"; _cref="${3:-}"
        case "$_sp" in ''|*[!0-9]*) _sp=0 ;; esac
        if [ "$_sp" -eq 0 ]; then
            # Nothing confirmed sent: a full retry is safe unless part 1 may have gone out.
            [ "$_amb" = "true" ] || continue
            qlog_warn "SMS forward: the message may have been delivered, not retrying"
            break
        fi
        case "$_cref" in ''|*[!0-9]*) _cref="" ;; esac
        if [ "$_amb" = "false" ] && [ -n "$_cref" ]; then
            qlog_warn "SMS forward: resuming at part $((_sp + 1)) (ref $_cref)"
            _out=$("$QSMS" send --ref "$_cref" --from "$((_sp + 1))" "$_send_target" "$_send_body" 2>/dev/null </dev/null)
            if [ $? -eq 0 ]; then
                qlog_info "SMS forward: resume succeeded"
                return 0
            fi
            _detail=$(printf '%s' "$_out" | jq -r 'if (.detail | type) == "string" then .detail else "" end' 2>/dev/null)
            [ -n "$_detail" ] && _last_err="$_detail"
            qlog_warn "SMS forward: resume failed — ${_last_err}"
        else
            qlog_warn "SMS forward: some parts already sent, not retrying"
        fi
        break
    done

    printf '%s' "$_last_err"
    return 1
}

# --- Seen-set ----------------------------------------------------------------
# A group id "g <fp> <epoch>" matches a seen group within 24 h, so a late part 1 never re-forwards.
sf_is_seen() {
    [ -f "$SEEN_FILE" ] || return 1
    case "$1" in
        "g "*)
            set -- $1
            awk -v f="$2" -v t="$3" '$1 == "g" && $2 == f && $3 - t <= 86400 && t - $3 <= 86400 { m = 1; exit }
                END { exit m ? 0 : 1 }' "$SEEN_FILE"
            ;;
        *) grep -q -x -F "$1" "$SEEN_FILE" 2>/dev/null ;;
    esac
}

sf_mark_seen() {
    printf '%s\n' "$1" >> "$SEEN_FILE"
}

# --- Pending multi-part groups: lines of "<storage> <fingerprint> <uptime>" ---
sf_pending_first() {
    [ -s "$PENDING_FILE" ] || return 0
    awk -v s="$1" -v f="$2" '$1 == s && $2 == f { print $3; exit }' "$PENDING_FILE"
}

sf_has_pending() {
    [ -s "$PENDING_FILE" ] || return 1
    awk -v s="$1" '$1 == s { f = 1 } END { exit f ? 0 : 1 }' "$PENDING_FILE"
}

# Storages that hold a group past GROUP_TIMEOUT.
sf_pending_due() {
    [ -s "$PENDING_FILE" ] || return 0
    awk -v now="$NOW" -v to="$GROUP_TIMEOUT" '$3 + to <= now && !d[$1]++ { print $1 }' "$PENDING_FILE"
}

# =============================================================================
# SCAN
# =============================================================================

# Handle one merged message (called from the eval in sf_scan).
# Args: storage sender timestamp content gkey complete parts total gts
sf_handle() {
    _h_st="$1"
    _h_sender="$2"
    _h_ts="$3"
    _h_content="$4"
    _h_gkey="$5"
    _h_complete="$6"
    _h_parts="$7"
    _h_total="$8"
    _h_gts="$9"

    if [ -n "$_h_gkey" ]; then
        _fp=$(sf_fingerprint "$_h_gkey")
    else
        _fp=$(sf_fingerprint "${_h_st}|${_h_sender}|${_h_ts}|${_h_content}")
    fi
    case "$_fp" in
        ''|*[!0-9]*) return 0 ;;
    esac
    _id="$_fp"
    if [ -n "$_h_gkey" ]; then
        case "$_h_gts" in ''|*[!0-9]*) _h_gts=0 ;; esac
        _id="g $_fp $_h_gts"
    fi

    sf_is_seen "$_id" && return 0

    # Seeding pass: record everything currently present, forward nothing.
    if [ "$SCAN_SEED" = "1" ]; then
        sf_mark_seen "$_id"
        return 0
    fi

    # Incomplete multi-part group: hold until all parts arrive or GROUP_TIMEOUT.
    if [ "$_h_complete" != "1" ]; then
        _first=$(sf_pending_first "$_h_st" "$_fp")
        [ -z "$_first" ] && _first="$NOW"
        if [ $((NOW - _first)) -lt "$GROUP_TIMEOUT" ]; then
            printf '%s %s %s\n' "$_h_st" "$_fp" "$_first" >> "$PENDING_NEW"
            return 0
        fi
        qlog_warn "SMS forward: group from ${_h_sender} timed out with ${_h_parts}/${_h_total} parts, forwarding partial"
    fi

    # Loop guard: don't forward our own relays, but mark them seen.
    if sf_is_relay "$_h_content"; then
        qlog_debug "SMS forward: skipping relay-shaped message (loop guard)"
        sf_mark_seen "$_id"
        return 0
    fi

    _body="From ${_h_sender}: ${_h_content}"
    qlog_info "SMS forward: forwarding message from ${_h_sender} to ${SF_SEND_TARGET}"

    # Mark seen BEFORE sending: at-most-once, so a SIGKILL mid-send never resends in full.
    sf_mark_seen "$_id"
    if ! _err=$(sf_send_with_retry "$SF_SEND_TARGET" "$_body"); then
        # Attempts exhausted: record the failure for the CGI/UI. Feature stays enabled.
        _now_ts=$(date +%s)
        [ -z "$_h_ts" ] && _h_ts="$_now_ts"
        [ -z "$_err" ] && _err="send failed"
        sf_record_failure "$_h_sender" "$_h_ts" "$_err"
        qlog_error "SMS forward: all attempts failed forwarding from ${_h_sender} — ${_err}"
    fi
}

# List one storage and forward what is new. An unseeded storage is seeded
# instead (record only). Returns 1 when the list failed.
sf_scan() {
    _sc_st="$1"
    case "$_sc_st" in
        ME) _sc_seeded="$SEEDED_ME"; _sc_prev="$CK_ME" ;;
        *)  _sc_seeded="$SEEDED_SM"; _sc_prev="$CK_SM" ;;
    esac
    SCAN_SEED=0
    [ "$_sc_seeded" = "1" ] || SCAN_SEED=1

    if ! _sc_json=$(sf_read_inbox "$_sc_st"); then
        if [ "$SCAN_FAILING" != "1" ]; then
            SCAN_FAILING=1
            qlog_warn "SMS forward: could not read the ${_sc_st} inbox"
        fi
        SCAN_SEED=0
        return 1
    fi
    if [ "$SCAN_FAILING" = "1" ]; then
        SCAN_FAILING=0
        qlog_info "SMS forward: inbox readable again"
    fi

    sf_now
    _sc_ck=$(printf '%s' "$_sc_json" | md5sum | cut -d' ' -f1)
    if [ "$SCAN_SEED" != "1" ] && [ "$_sc_ck" = "$_sc_prev" ] && ! sf_has_pending "$_sc_st"; then
        return 0
    fi

    : > "$PENDING_NEW"
    # @sh quotes every field, so the generated calls are safe to eval.
    eval "$(printf '%s' "$_sc_json" | jq -r '.[] | "sf_handle " + ([.storage, .sender, .timestamp, .content, .gkey, (if .complete then "1" else "0" end), (.parts | tostring), (.total | tostring), (.gts | tostring)] | @sh)' 2>/dev/null)"

    if [ "$SCAN_SEED" = "1" ]; then
        printf '#seeded2 %s\n' "$_sc_st" >> "$SEEN_FILE"
        qlog_info "SMS forward: seeded ${_sc_st} (no forwarding)"
        case "$_sc_st" in
            ME) SEEDED_ME=1 ;;
            *)  SEEDED_SM=1 ;;
        esac
        SCAN_SEED=0
    else
        # Replace this storage's pending entries with the ones still waiting.
        if [ -f "$PENDING_FILE" ]; then
            awk -v s="$_sc_st" '$1 != s' "$PENDING_FILE" > "$PENDING_TMP" 2>/dev/null
        else
            : > "$PENDING_TMP"
        fi
        cat "$PENDING_NEW" >> "$PENDING_TMP" 2>/dev/null
        mv "$PENDING_TMP" "$PENDING_FILE"
    fi

    case "$_sc_st" in
        ME) CK_ME="$_sc_ck" ;;
        *)  CK_SM="$_sc_ck" ;;
    esac
    return 0
}

# Create the seen-set when absent (first start / first enable) and rebuild the
# seeded flags from its markers, so a daemon restart does not re-seed.
sf_ensure_seen() {
    if [ ! -f "$SEEN_FILE" ]; then
        : > "$SEEN_FILE"
        SEEDED_ME=0
        SEEDED_SM=0
        CK_ME=""
        CK_SM=""
        qlog_info "SMS forward: seeding seen-set from existing inbox (no forwarding)"
    fi
    # "#seeded2" marks the 24 h group ids; an older seen-set is re-seeded, never forwarded.
    grep -q -x -F '#seeded2 ME' "$SEEN_FILE" 2>/dev/null && SEEDED_ME=1
    grep -q -x -F '#seeded2 SM' "$SEEN_FILE" 2>/dev/null && SEEDED_SM=1
    return 0
}

# =============================================================================
# WATCH (wake-up source)
# =============================================================================

# Background supervisor: runs `qsms watch` into the event FIFO (fd 3), prints
# "down" when it ends, and respawns with a growing delay. rc 2 (permanently
# unavailable on this modem) prints "unavailable" and stops respawning.
sf_watch_supervisor() {
    _w_qp=""
    _w_fail=0
    trap 'kill $_w_qp 2>/dev/null; exit 0' INT TERM
    while :; do
        sf_now
        _w_t0="$NOW"
        "$QSMS" watch >&3 2>/dev/null </dev/null &
        _w_qp=$!
        wait "$_w_qp"
        _w_rc=$?
        if [ "$_w_rc" -eq 2 ]; then
            printf 'unavailable\n' >&3
            exit 0
        fi
        printf 'down\n' >&3
        sf_now
        if [ $((NOW - _w_t0)) -ge 60 ]; then
            _w_fail=0
        else
            _w_fail=$((_w_fail + 1))
        fi
        _w_delay=$((_w_fail + 1))
        [ "$_w_delay" -gt 60 ] && _w_delay=60
        sleep "$_w_delay" &
        _w_qp=$!
        wait "$_w_qp"
    done
}

sf_start_watcher() {
    [ "$FIFO_OK" = "1" ] || return 1
    [ "$WATCH_GONE" = "1" ] && return 1
    if [ -n "$WATCHER_PID" ] && kill -0 "$WATCHER_PID" 2>/dev/null; then
        return 0
    fi
    sf_watch_supervisor &
    WATCHER_PID=$!
    qlog_info "SMS forward: started qsms watch supervisor (PID $WATCHER_PID)"
}

sf_stop_watcher() {
    WATCH_UP=0
    [ -n "$WATCHER_PID" ] || return 0
    kill "$WATCHER_PID" 2>/dev/null
    wait "$WATCHER_PID" 2>/dev/null
    WATCHER_PID=""
}

sf_note_event() {
    case "$1" in
        "ME "*) EV_ME=1 ;;
        "SM "*) EV_SM=1 ;;
        ready)
            WATCH_UP=1
            EV_FULL=1
            qlog_info "SMS forward: qsms watch ready"
            ;;
        down)
            WATCH_UP=0
            qlog_warn "SMS forward: qsms watch ended, polling every ${SF_INTERVAL}s until it is back"
            ;;
        unavailable)
            WATCH_UP=0
            [ "$WATCH_GONE" = "1" ] || qlog_warn "SMS forward: qsms watch unavailable on this modem; polling only"
            WATCH_GONE=1
            ;;
    esac
}

# Sleep that TERM can interrupt: BusyBox ash defers traps until a foreground
# child ends, so background the sleep and wait on it (killed in sf_cleanup).
sf_sleep() {
    sleep "$1" &
    _sf_sleep_pid=$!
    wait "$_sf_sleep_pid"
    _sf_sleep_pid=""
}

# Wait for a wake-up event (or SF_INTERVAL), then coalesce a burst.
sf_wait() {
    if [ "$FIFO_OK" = "1" ]; then
        if read -r -t "$SF_INTERVAL" _ev <&3; then
            sf_note_event "$_ev"
            while read -r -t 1 _ev <&3; do
                sf_note_event "$_ev"
            done
        fi
    else
        sf_sleep "$SF_INTERVAL"
    fi
}

# Run whatever the last wake-up asks for.
sf_dispatch() {
    sf_now
    if [ "$EV_FULL" = "1" ] || { [ "$WATCH_UP" != "1" ] && [ $((NOW - LAST_FULL)) -ge "$SF_INTERVAL" ]; }; then
        sf_scan ME
        sf_scan SM && SM_RETRY=0 || SM_RETRY=1
        sf_now
        LAST_FULL="$NOW"
    else
        # Safety list while watch is up: ME, plus SM only if it is unseeded or its last list failed.
        if [ "$WATCH_UP" = "1" ] && [ $((NOW - LAST_FULL)) -ge "$SAFETY_INTERVAL" ]; then
            EV_ME=1
            { [ "$SEEDED_SM" != "1" ] || [ "$SM_RETRY" = "1" ]; } && EV_SM=1
            LAST_FULL="$NOW"
        fi
        [ "$EV_ME" = "1" ] && sf_scan ME
        if [ "$EV_SM" = "1" ]; then
            sf_scan SM && SM_RETRY=0 || SM_RETRY=1
        fi
        for _st in $(sf_pending_due); do
            sf_scan "$_st"
        done
    fi
    EV_ME=0
    EV_SM=0
    EV_FULL=0
}

# =============================================================================
# MAIN LOOP
# =============================================================================

sf_cleanup() {
    [ -n "$_sf_sleep_pid" ] && kill "$_sf_sleep_pid" 2>/dev/null
    sf_stop_watcher
    rm -f "$PID_FILE" "$FAILURES_TMP" "$EVENT_FIFO" "$PENDING_NEW" "$PENDING_TMP"
}

main() {
    # Prevent duplicate instances. This is a same-user (root) self-check at
    # startup — cross-user checks elsewhere use pid_alive, but systemd always
    # starts this unit as root, so kill -0 against our own prior PID is valid.
    if [ -f "$PID_FILE" ]; then
        old_pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
            qlog_error "Another sms_forward daemon already running (PID $old_pid), exiting"
            exit 1
        fi
        rm -f "$PID_FILE"
    fi
    echo $$ > "$PID_FILE"

    trap sf_cleanup EXIT
    trap 'exit 0' INT TERM

    # Event FIFO on fd 3, opened read-write so writers never block. Without it
    # the loop polls.
    rm -f "$EVENT_FIFO"
    if mkfifo "$EVENT_FIFO" 2>/dev/null && ( exec 3<>"$EVENT_FIFO" ) 2>/dev/null; then
        exec 3<>"$EVENT_FIFO"
        FIFO_OK=1
    else
        qlog_warn "SMS forward: no event FIFO, polling only"
    fi

    load_config

    qlog_info "========================================"
    qlog_info "QManager SMS Forward Daemon starting (PID $$)"
    qlog_info "Enabled: ${SF_ENABLED}, Interval: ${SF_INTERVAL}s"
    qlog_info "========================================"

    while true; do
        if [ -f "$RELOAD_FLAG" ]; then
            load_config
            rm -f "$RELOAD_FLAG"
            qlog_info "Reloaded config: enabled=${SF_ENABLED} target set=$( [ -n "$SF_TARGET" ] && echo yes || echo no )"
        fi

        if [ "$SF_ENABLED" != "1" ]; then
            sf_stop_watcher
            sf_sleep "$SF_INTERVAL"
            continue
        fi

        if ! sf_target_valid; then
            qlog_warn "SMS forward: enabled but target_phone is invalid/empty — idling"
            sf_stop_watcher
            sf_sleep "$SF_INTERVAL"
            continue
        fi

        # Normalize the send target once per cycle (strip one leading +, like
        # sms.sh). The full international number is the user's responsibility.
        SF_SEND_TARGET=$(printf '%s' "$SF_TARGET" | sed 's/^+//')

        sf_ensure_seen
        sf_start_watcher
        sf_dispatch
        sf_wait
    done
}

main "$@"
