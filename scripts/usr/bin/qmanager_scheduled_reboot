#!/bin/sh
# =============================================================================
# qmanager_scheduled_reboot — Scheduled System Reboot
# =============================================================================
# Fired by qmanager-scheduled-reboot.timer (runtime-armed by
# qmanager_scheduled_reboot_arm — RM520N has no crond, see
# schedule_timer.sh). Logs the event and reboots.
#
# OTA GUARD: an in-flight qmanager_update (download/verify/install) must
# never be cut off by an unrelated scheduled reboot landing mid-update —
# that would corrupt the staged install and could brick the boot partition
# if the timer fires between "installed new files" and "reboot into them".
# qmanager_update writes its own PID to /tmp/qmanager_update.pid for the
# entire duration of an install/download/rollback run and removes it on
# every exit path (success, error, or handoff to its own reboot) — see
# PID_FILE in qmanager_update. pid_alive (not `kill -0`) because a stale PID
# could be recycled by an unrelated process; checking /proc/<pid> existence
# is what platform.sh's pid_alive does and is safe across the root/root
# boundary here regardless.
#
# CLOCK-STEP GUARD (issue #9): a schedule read that comes back empty during
# the boot window (jq resolves through the /opt symlink, which isn't mounted
# yet) must be treated as "unreadable", not "no schedule by design" — so this
# worker validates its own schedule before ever calling the shared guard. See
# schedule_timer.sh and docs/reference/scheduled-timers.md ("The 1970 boot
# window").
# Install location: /usr/bin/qmanager_scheduled_reboot
# =============================================================================

. /usr/lib/qmanager/qlog.sh 2>/dev/null || {
    qlog_init() { :; }
    qlog_info() { logger -t scheduled_reboot "$1"; }
    qlog_warn() { logger -t scheduled_reboot "$1"; }
}
[ -f /usr/lib/qmanager/platform.sh ] && . /usr/lib/qmanager/platform.sh 2>/dev/null
command -v pid_alive >/dev/null 2>&1 || pid_alive() { [ -n "$1" ] && [ -d "/proc/$1" ]; }

qlog_init "scheduled_reboot"

CRASH_LOG="/etc/qmanager/crash.log"

# Trims crash.log before an append so it never grows unbounded on flash.
# Never lets a trim failure block the append — the reboot path must not stall.
_qm_crash_log_append() {
    local count
    # Symlink guard: /etc/qmanager is www-data-owned and non-sticky, so refuse
    # (and remove) a symlinked crash.log rather than following it as root.
    if [ -L "$CRASH_LOG" ]; then
        rm -f "$CRASH_LOG"
    fi
    if [ -f "$CRASH_LOG" ]; then
        count=$(wc -l < "$CRASH_LOG" 2>/dev/null || echo 0)
        if [ "$count" -gt 200 ]; then
            tail -n 100 "$CRASH_LOG" > "${CRASH_LOG}.sched.tmp" 2>/dev/null && mv "${CRASH_LOG}.sched.tmp" "$CRASH_LOG" 2>/dev/null
        fi
    fi
    echo "$(date +%s)|$1" >> "$CRASH_LOG" 2>/dev/null
}

. /usr/lib/qmanager/config.sh 2>/dev/null || :
. /usr/lib/qmanager/schedule_timer.sh 2>/dev/null || :

if command -v _qm_timer_fire_allowed >/dev/null 2>&1; then
    sched_time=$(qm_config_get settings sched_reboot_time "" 2>/dev/null)
    sched_days=$(qm_config_get settings sched_reboot_days "" 2>/dev/null)
    # An empty/invalid schedule here means "unreadable" (e.g. /opt not yet
    # mounted), not "no schedule by design" — deny ourselves before the guard
    # ever sees it, since an empty sched otherwise passes the guard on purpose.
    if ! _qm_validate_hhmm "$sched_time"; then
        qlog_warn "Scheduled reboot skipped: schedule time unreadable/invalid (issue #9)"
        _qm_crash_log_append "skip|no_schedule"
        exit 0
    fi
    if ! _qm_timer_fire_allowed "$sched_time" "$sched_days"; then
        qlog_warn "Scheduled reboot skipped: fire outside schedule window (clock-step guard, issue #9)"
        _qm_crash_log_append "skip|clock_step_guard"
        exit 0
    fi
else
    # No guard library, no schedule match capability — a reboot payload must
    # never fire unguarded. A missed scheduled reboot is recoverable, a boot
    # loop is not.
    qlog_warn "Scheduled reboot skipped: guard library unavailable, failing closed (issue #9)"
    _qm_crash_log_append "skip|lib_missing"
    exit 0
fi

UPDATE_PID_FILE="/tmp/qmanager_update.pid"
if [ -f "$UPDATE_PID_FILE" ]; then
    update_pid=$(cat "$UPDATE_PID_FILE" 2>/dev/null)
    if pid_alive "$update_pid"; then
        qlog_warn "Scheduled reboot skipped: qmanager_update in progress (pid $update_pid)"
        _qm_crash_log_append "skip|update_in_progress"
        exit 0
    fi
fi

qlog_info "Scheduled system reboot triggered"
_qm_crash_log_append "reboot|scheduled"
reboot
